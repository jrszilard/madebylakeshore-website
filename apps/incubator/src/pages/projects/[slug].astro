---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityClient, urlFor, queries } from '../../lib/sanity';

export async function getStaticPaths() {
  const projects = await sanityClient.fetch(
    `*[_type == "digitalProject"]{ "slug": slug.current }`
  );
  return projects.map((p: any) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = await sanityClient.fetch(queries.projectBySlug, { slug });

if (!project) {
  return Astro.redirect('/projects');
}

const statusColors: Record<string, string> = {
  'launched': 'bg-inc-lime/20 text-inc-lime',
  'beta': 'bg-inc-cyan/20 text-inc-cyan',
  'in-development': 'bg-inc-violet/20 text-inc-violet',
  'concept': 'bg-inc-zinc text-inc-silver',
};

const statusLabels: Record<string, string> = {
  'launched': 'Launched',
  'beta': 'Beta',
  'in-development': 'Building',
  'concept': 'Concept',
};

const categoryLabels: Record<string, string> = {
  'ai-ml': 'AI/ML',
  'automation': 'Automation',
  'dev-tools': 'Dev Tools',
  'web-app': 'Web App',
  'data-analytics': 'Data & Analytics',
  'other': 'Other',
};
---

<BaseLayout title={project.title} description={project.tagline}>
  <section class="section-spacing">
    <div class="container-inc">
      <a href="/projects" class="inline-flex items-center gap-2 text-sm text-inc-silver hover:text-inc-lime transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        All Projects
      </a>

      <div class="max-w-3xl">
        <div class="flex flex-wrap items-center gap-3 mb-6">
          {project.category && (
            <span class="px-2 py-1 text-xs font-mono text-inc-cyan border border-inc-cyan/30 rounded">
              {categoryLabels[project.category] || project.category}
            </span>
          )}
          <span class={`px-2 py-1 text-xs font-mono uppercase tracking-wider rounded ${statusColors[project.status] || statusColors['concept']}`}>
            {statusLabels[project.status] || project.status}
          </span>
        </div>

        <h1 class="text-display-xl mb-4">{project.title}</h1>

        <p class="text-xl text-inc-silver leading-relaxed mb-8">
          {project.tagline}
        </p>

        <div class="flex flex-wrap gap-4 mb-12">
          {project.liveUrl && (
            <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="btn-glow">
              Visit Live Site
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          )}
          {project.demoUrl && (
            <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class="btn-glow">
              Try Demo
            </a>
          )}
          {project.githubUrl && (
            <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              View on GitHub
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  {project.highlights && project.highlights.length > 0 && (
  <section class="pb-16">
    <div class="container-inc">
      <div class="max-w-3xl">
        <h2 class="font-display text-xl text-inc-white mb-6">Highlights</h2>
        <ul class="space-y-3">
          {project.highlights.map((h: string) => (
            <li class="text-inc-silver flex items-start gap-3">
              <span class="text-inc-lime mt-1">▸</span>
              <span>{h}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
  )}

  {project.techStack && project.techStack.length > 0 && (
  <section class="pb-16">
    <div class="container-inc">
      <div class="max-w-3xl">
        <h2 class="font-display text-xl text-inc-white mb-6">Tech Stack</h2>
        <div class="flex flex-wrap gap-3">
          {project.techStack.map((tech: string) => (
            <span class="px-3 py-1.5 bg-inc-steel text-inc-silver text-sm font-mono rounded">
              {tech}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>
  )}

  {project.description && (
  <section class="pb-20">
    <div class="container-inc">
      <div class="max-w-3xl prose prose-invert prose-lime">
        <h2 class="font-display text-xl text-inc-white mb-6">About this project</h2>
        {project.description.map((block: any) => {
          if (block._type === 'block') {
            const text = block.children?.map((child: any) => child.text).join('') || '';
            return <p class="text-inc-silver leading-relaxed">{text}</p>;
          }
          return null;
        })}
      </div>
    </div>
  </section>
  )}

  <section class="section-spacing bg-inc-night">
    <div class="container-inc text-center">
      <h2 class="text-display mb-6">Interested in this project?</h2>
      <p class="text-inc-silver max-w-xl mx-auto mb-8">
        Whether you want to collaborate, have feedback, or just want to chat about the tech — we'd love to hear from you.
      </p>
      <a href="https://madebylakeshore.com/contact" class="btn-glow">
        Get in Touch
      </a>
    </div>
  </section>
</BaseLayout>
