---

<a 
  href={href}
  class="card group p-8 flex flex-col h-full animate-slide-up opacity-0"
  style={`animation-delay: ${0.1 + index * 0.1}s;`}
>
  <div class="w-12 h-12 flex items-center justify-start mb-2">
    <svg class="w-10 h-10 text-mbl-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={icons[icon]} />
  </div>
  
  <h3 class="font-display text-xl mb-3 group-hover:text-mbl-accent transition-colors duration-300">
    {title}
  </h3>
  
  <p class="text-mbl-stone flex-1 mb-6">
    {description}
  </p>
  
  <div class="flex items-center justify-between pt-4">
<span class="inline-flex items-center gap-2 px-4 py-2 rounded-md border border-mbl-accent/30 text-mbl-accent font-heading text-sm font-medium group-hover:bg-mbl-accent/10 group-hover:border-mbl-accent/60 group-hover:gap-3 transition-all duration-300">
      Learn more
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </span>
  </div>
</a>
