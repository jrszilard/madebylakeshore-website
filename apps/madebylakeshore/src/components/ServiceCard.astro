    <line x1="5.5" y1="21" x2="5.5" y2="15" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    <line x1="12" y1="21" x2="12" y2="10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
