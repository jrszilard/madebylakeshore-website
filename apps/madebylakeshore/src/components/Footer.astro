---
const currentYear = new Date().getFullYear();

const footerLinks = {
  services: [
    { href: '/services/brand-identity', label: 'Brand Identity' },
    { href: '/services/product-design', label: 'Product Design' },
    { href: '/services/data-and-analytics', label: 'Data & Analytics' },
    { href: '/services/artificial-intelligence', label: 'AI Solutions' },
  ],
  company: [
    { href: '/about', label: 'About Us' },
    { href: '/case-studies', label: 'Our Work' },
    { href: '/contact', label: 'Contact' },
  ],
  brands: [
    { href: 'https://designandotherstories.com', label: 'Design & Other Stories', external: true },
    { href: 'https://incubator.madebylakeshore.com', label: 'Incubator at Lakeshore', external: true },
  ],
};
---

<footer class="bg-mbl-dusk text-mbl-ink">
  <div class="container-wide py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Brand Column -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-flex mb-6">
          <img src="/LSS_logo.png" alt="Lakeshore Studios" class="h-10 w-auto brightness-0" decoding="async" />
        </a>
        <p class="text-mbl-ink/70 text-sm leading-relaxed mb-6">
          Strategic consulting in design, data, and AI. We help businesses transform through thoughtful solutions.
        </p>
      </div>

      <!-- Services -->
      <div>
        <h4 class="font-heading font-semibold text-sm uppercase tracking-wider mb-6 text-mbl-ink">Services</h4>
        <ul class="space-y-3">
          {footerLinks.services.map((link) => (
            <li>
              <a href={link.href} class="text-mbl-ink/70 hover:text-mbl-ink text-sm transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="font-heading font-semibold text-sm uppercase tracking-wider mb-6 text-mbl-ink">Company</h4>
        <ul class="space-y-3">
          {footerLinks.company.map((link) => (
            <li>
              <a href={link.href} class="text-mbl-ink/70 hover:text-mbl-ink text-sm transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Our Brands -->
      <div>
        <h4 class="font-heading font-semibold text-sm uppercase tracking-wider mb-6 text-mbl-ink">Our Brands</h4>
        <ul class="space-y-3">
          {footerLinks.brands.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
                class="text-mbl-ink/70 hover:text-mbl-ink text-sm transition-colors inline-flex items-center gap-1"
              >
                {link.label}
                {link.external && (
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    
    <!-- Bottom Bar -->
    <div class="mt-16 pt-8 border-t border-mbl-ink/10 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-mbl-ink/50 text-sm">
        © {currentYear} Lakeshore Studios. All rights reserved.
      </p>
      <div class="flex gap-6 text-sm">
        <a href="/privacy" class="text-mbl-ink/50 hover:text-mbl-ink transition-colors">Privacy</a>
        <a href="/terms" class="text-mbl-ink/50 hover:text-mbl-ink transition-colors">Terms</a>
      </div>
    </div>
  </div>
</footer>
