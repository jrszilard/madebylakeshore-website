---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroTwinkle from '../../components/HeroTwinkle.astro';
import { sanityClient, urlFor, queries } from '../../lib/sanity';

export const prerender = false;

// Fetch all case studies including protection metadata
const allSanityCaseStudies = await sanityClient.fetch(queries.allCaseStudiesWithVisibility);

// Filter: exclude hidden protected studies
const sanityCaseStudies = allSanityCaseStudies.filter((study: any) => {
  if (study.isProtected && study.listingVisibility === 'hidden') return false;
  return true;
});

const caseStudies = sanityCaseStudies.map((study: any) => ({
  slug: study.slug?.current,
  title: study.title,
  client: study.client || '',
  category: study.category || 'design',
  author: study.author?.name || '',
  duration: '',
  heroImage: study.featuredImage?.asset ? urlFor(study.featuredImage).width(800).url() : null,
  excerpt: study.excerpt || '',
  isProtected: study.isProtected === true,
  // Strip metrics from protected teaser cards
  results: study.isProtected ? [] : (study.metrics?.slice(0, 3) || []),
}));

const categoryColors: Record<string, string> = {
  design: 'bg-mbl-warm/10 text-mbl-warm',
  data: 'bg-mbl-accent/10 text-mbl-accent',
  ai: 'bg-purple-100 text-purple-600',
};
---

<BaseLayout 
  title="Case Studies" 
  description="In-depth looks at how we've helped businesses solve complex challenges with design, data, and AI."
>
  <!-- Hero -->
  <section class="relative section-spacing bg-[#1e3030] overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0 bg-pattern"></div>
    </div>
    <HeroTwinkle />
    <!-- Constellation — connecting insights -->
    <div class="absolute bottom-0 right-0 pointer-events-none select-none overflow-hidden w-[520px] h-[400px]">
      <svg viewBox="0 0 520 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full opacity-40" aria-hidden="true">
        <!-- Connector lines -->
        <line x1="420" y1="60" x2="320" y2="140" stroke="white" stroke-width="1" opacity="0.4"/>
        <line x1="420" y1="60" x2="480" y2="180" stroke="white" stroke-width="1" opacity="0.4"/>
        <line x1="320" y1="140" x2="200" y2="100" stroke="white" stroke-width="1" opacity="0.4"/>
        <line x1="320" y1="140" x2="260" y2="240" stroke="white" stroke-width="1" opacity="0.4"/>
        <line x1="320" y1="140" x2="480" y2="180" stroke="white" stroke-width="1" opacity="0.3"/>
        <line x1="200" y1="100" x2="100" y2="180" stroke="white" stroke-width="1" opacity="0.4"/>
        <line x1="200" y1="100" x2="260" y2="240" stroke="white" stroke-width="1" opacity="0.3"/>
        <line x1="480" y1="180" x2="380" y2="280" stroke="white" stroke-width="1" opacity="0.4"/>
        <line x1="480" y1="180" x2="440" y2="310" stroke="white" stroke-width="1" opacity="0.3"/>
        <line x1="260" y1="240" x2="100" y2="180" stroke="white" stroke-width="1" opacity="0.3"/>
        <line x1="260" y1="240" x2="380" y2="280" stroke="white" stroke-width="1" opacity="0.4"/>
        <line x1="260" y1="240" x2="160" y2="340" stroke="white" stroke-width="1" opacity="0.4"/>
        <line x1="100" y1="180" x2="60" y2="300" stroke="white" stroke-width="1" opacity="0.3"/>
        <line x1="380" y1="280" x2="440" y2="310" stroke="white" stroke-width="1" opacity="0.4"/>
        <line x1="380" y1="280" x2="300" y2="370" stroke="white" stroke-width="1" opacity="0.3"/>
        <line x1="160" y1="340" x2="60" y2="300" stroke="white" stroke-width="1" opacity="0.4"/>
        <line x1="160" y1="340" x2="300" y2="370" stroke="white" stroke-width="1" opacity="0.3"/>
        <line x1="440" y1="310" x2="520" y2="350" stroke="white" stroke-width="1" opacity="0.3"/>
        <!-- Nodes — varying sizes by importance -->
        <circle cx="420" cy="60" r="5" fill="white" opacity="1"/>
        <circle cx="320" cy="140" r="7" fill="white" opacity="0.95"/>
        <circle cx="200" cy="100" r="4" fill="white" opacity="0.8"/>
        <circle cx="480" cy="180" r="5" fill="white" opacity="0.85"/>
        <circle cx="260" cy="240" r="8" fill="white" opacity="1"/>
        <circle cx="100" cy="180" r="4" fill="white" opacity="0.75"/>
        <circle cx="380" cy="280" r="6" fill="white" opacity="0.9"/>
        <circle cx="440" cy="310" r="4" fill="white" opacity="0.75"/>
        <circle cx="160" cy="340" r="5" fill="white" opacity="0.8"/>
        <circle cx="60" cy="300" r="3.5" fill="white" opacity="0.65"/>
        <circle cx="300" cy="370" r="4.5" fill="white" opacity="0.7"/>
        <circle cx="520" cy="350" r="3" fill="white" opacity="0.55"/>
        <!-- Glow rings on key nodes -->
        <circle cx="260" cy="240" r="14" stroke="white" stroke-width="1" fill="none" opacity="0.2"/>
        <circle cx="320" cy="140" r="12" stroke="white" stroke-width="1" fill="none" opacity="0.18"/>
      </svg>
    </div>
    <div class="container-wide relative z-10">
      <div class="max-w-3xl">
        <p class="font-heading text-white/50 font-medium tracking-wide mb-4 animate-slide-up opacity-0" style="animation-delay: 0.1s;">
          Case Studies
        </p>
        <h1 class="text-display-lg text-white mb-6 animate-slide-up opacity-0" style="animation-delay: 0.2s;">
          Stories of <span class="text-mbl-dusk">transformation</span>
        </h1>
        <p class="text-xl text-white/70 leading-relaxed animate-slide-up opacity-0" style="animation-delay: 0.3s;">
          Deep dives into our most impactful projects. Learn about the challenges,
          our approach, and the results we achieved together with our clients.
        </p>
      </div>
    </div>
  </section>

  <!-- Case Studies List -->
  <section class="pt-20 md:pt-28 pb-20">
    <div class="container-wide">
      <div class="space-y-40">
        {caseStudies.map((study: any, index: number) => {
          const isFirst = index === 0;
          return (
          <a 
            href={`/case-studies/${study.slug}`}
            class="group block"
          >
            <article class="grid lg:grid-cols-2 gap-8 lg:gap-16 items-center">
              <!-- Image -->
              <div class={`relative rounded-lg overflow-hidden ${index % 2 === 1 ? 'lg:order-2' : ''}`}>
                {study.heroImage ? (
                  <img
                    src={study.heroImage}
                    alt={study.title}
                    class="w-full h-auto block"
                    loading={isFirst ? undefined : 'lazy'}
                    fetchpriority={isFirst ? 'high' : undefined}
                    decoding="async"
                  />
                ) : (
                  <div class="aspect-[4/3] bg-gradient-to-br from-mbl-slate to-mbl-dusk opacity-80"></div>
                )}

              </div>

              <!-- Content -->
              <div class={index % 2 === 1 ? 'lg:order-1' : ''}>
                <div class="flex items-center gap-4 mb-4 flex-wrap">
                  <span class={`px-3 py-1 rounded-full text-xs font-heading font-medium ${categoryColors[study.category]}`}>
                    {study.category.charAt(0).toUpperCase() + study.category.slice(1)}
                  </span>
                  {study.client && <span class="text-sm text-mbl-stone">{study.client}</span>}
                  {study.client && study.author && <span class="text-mbl-mist">•</span>}
                  {study.author && <span class="text-sm text-mbl-stone">with {study.author}</span>}
                </div>
                
                <h2 class="font-display text-2xl lg:text-3xl mb-4 group-hover:text-mbl-accent transition-colors duration-300 flex items-center gap-3">
                  {study.title}
                  {study.isProtected && (
                    <svg class="w-5 h-5 text-mbl-stone/50 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-label="Password protected" role="img">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                    </svg>
                  )}
                </h2>
                
                <p class="text-lg text-mbl-stone mb-8">
                  {study.excerpt}
                </p>
                
                <!-- Results -->
                {study.results && study.results.length > 0 && (
                  <div class="grid grid-cols-3 gap-6 mb-8">
                    {study.results.map((result: any) => (
                      <div>
                        <div class="text-2xl lg:text-3xl font-display text-mbl-accent mb-1">
                          {result.value}
                        </div>
                        <div class="text-sm text-mbl-stone">
                          {result.label}
                        </div>
                      </div>
                    ))}
                  </div>
                )}
                
                <span class="inline-flex items-center gap-2 font-heading font-medium text-mbl-ink group-hover:text-mbl-accent transition-colors">
                  {study.isProtected ? 'Request access' : 'Read full case study'}
                  <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </span>
              </div>
            </article>
          </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-spacing bg-white">
    <div class="container-wide">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-display mb-6">Want results like these?</h2>
          <p class="text-lg text-mbl-stone mb-8">
            Every business is different, but the approach is the same: understand the 
            challenge deeply, develop a strategic solution, and execute with precision. 
            Let's talk about what we can achieve together.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/contact" class="btn-primary">
              Start a Project
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a href="/services" class="btn-secondary">
              Explore Services
            </a>
          </div>
        </div>
        
        <div class="grid grid-cols-2 gap-4">
          <div class="p-6 bg-mbl-cloud rounded-lg text-center">
            <div class="text-4xl font-display text-mbl-accent mb-2">50+</div>
            <div class="text-sm text-mbl-stone">Projects Delivered</div>
          </div>
          <div class="p-6 bg-mbl-cloud rounded-lg text-center">
            <div class="text-4xl font-display text-mbl-accent mb-2">98%</div>
            <div class="text-sm text-mbl-stone">Client Satisfaction</div>
          </div>
          <div class="p-6 bg-mbl-cloud rounded-lg text-center">
            <div class="text-4xl font-display text-mbl-accent mb-2">5+</div>
            <div class="text-sm text-mbl-stone">Years Experience</div>
          </div>
          <div class="p-6 bg-mbl-cloud rounded-lg text-center">
            <div class="text-4xl font-display text-mbl-accent mb-2">3</div>
            <div class="text-sm text-mbl-stone">Service Areas</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>