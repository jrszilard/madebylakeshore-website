---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroTwinkle from '../../components/HeroTwinkle.astro';
import { sanityClient, queries } from '../../lib/sanity';

export const prerender = true;

// Fetch services from Sanity
const sanityServices = await sanityClient.fetch(queries.allServices);
const warmIcons = new Set(['brand-identity', 'product-design', 'design']);

const services = sanityServices.map((service: any) => ({
  title: service.title,
  slug: service.slug?.current || service.icon,
  icon: service.icon as 'brand-identity' | 'product-design' | 'design' | 'data' | 'ai',
  consultant: service.consultant?.name || '',
  description: service.tagline || '',
  offerings: service.offerings?.map((o: any) => o.title) || [],
  color: warmIcons.has(service.icon) ? 'warm' : 'accent',
}));

const serviceIcons: Record<string, string> = {
  // Letterform — capital A with typographic construction guides
  'brand-identity': `
    <line x1="2" y1="3" x2="22" y2="3" stroke="currentColor" stroke-width="0.5" stroke-linecap="round" opacity="0.3"/>
    <line x1="2" y1="21" x2="22" y2="21" stroke="currentColor" stroke-width="0.6" stroke-linecap="round" opacity="0.4"/>
    <line x1="2" y1="13" x2="22" y2="13" stroke="currentColor" stroke-width="0.4" stroke-linecap="round" opacity="0.15"/>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M5 21 L12 3 L19 21" />
    <path stroke-linecap="round" stroke-width="0.9" d="M8 13 L16 13" />
    <circle cx="5" cy="21" r="1" fill="currentColor" opacity="0.7"/>
    <circle cx="19" cy="21" r="1" fill="currentColor" opacity="0.7"/>
    <circle cx="12" cy="3" r="1.2" fill="currentColor"/>
    <circle cx="12" cy="3" r="3.5" stroke="currentColor" stroke-width="0.5" fill="none" opacity="0.22"/>
  `,
  // Isometric cube — physical/digital product form
  'product-design': `
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 3 L20 7.5 L20 16.5 L12 21 L4 16.5 L4 7.5 Z" />
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.7" d="M12 12 L20 7.5 M12 12 L4 7.5 M12 12 L12 21" opacity="0.5"/>
    <circle cx="12" cy="3" r="1.2" fill="currentColor"/>
    <circle cx="12" cy="3" r="3.5" stroke="currentColor" stroke-width="0.5" fill="none" opacity="0.22"/>
  `,
  design: `
    <line x1="2" y1="3" x2="22" y2="3" stroke="currentColor" stroke-width="0.5" stroke-linecap="round" opacity="0.3"/>
    <line x1="2" y1="21" x2="22" y2="21" stroke="currentColor" stroke-width="0.6" stroke-linecap="round" opacity="0.4"/>
    <line x1="2" y1="13" x2="22" y2="13" stroke="currentColor" stroke-width="0.4" stroke-linecap="round" opacity="0.15"/>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M5 21 L12 3 L19 21" />
    <path stroke-linecap="round" stroke-width="0.9" d="M8 13 L16 13" />
    <circle cx="5" cy="21" r="1" fill="currentColor" opacity="0.7"/>
    <circle cx="19" cy="21" r="1" fill="currentColor" opacity="0.7"/>
    <circle cx="12" cy="3" r="1.2" fill="currentColor"/>
    <circle cx="12" cy="3" r="3.5" stroke="currentColor" stroke-width="0.5" fill="none" opacity="0.22"/>
  `,
  // Bar chart — lines + trend curve + node dots + glow on tallest
  data: `
    <line x1="5.5" y1="21" x2="5.5" y2="15" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    <line x1="12" y1="21" x2="12" y2="10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    <line x1="18.5" y1="21" x2="18.5" y2="6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    <line x1="3" y1="21" x2="21" y2="21" stroke="currentColor" stroke-width="0.6" stroke-linecap="round" opacity="0.45"/>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.7" d="M5.5 15 C8 12.5 10 10.5 12 10 C14.5 8.5 16.5 7 18.5 6" opacity="0.5"/>
    <circle cx="5.5" cy="15" r="1.5" fill="currentColor" opacity="0.8"/>
    <circle cx="12" cy="10" r="1.5" fill="currentColor" opacity="0.9"/>
    <circle cx="18.5" cy="6" r="2" fill="currentColor"/>
    <circle cx="18.5" cy="6" r="4.5" stroke="currentColor" stroke-width="0.6" fill="none" opacity="0.25"/>
  `,
  // Sparkles — three at decreasing size/opacity + subtle ring around main
  ai: `
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
    <circle cx="9" cy="12" r="7" stroke="currentColor" stroke-width="0.5" fill="none" opacity="0.2"/>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.8" d="M18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z" opacity="0.7"/>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.6" d="M16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" opacity="0.45"/>
  `,
};
---

<BaseLayout 
  title="Services" 
  description="Strategic consulting in design, data analytics, and AI solutions. Explore our expertise and how we can help transform your business."
>
  <!-- Hero -->
  <section class="relative section-spacing bg-mbl-accent overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0 bg-pattern"></div>
    </div>
    <HeroTwinkle />
    <!-- Topographic map — closed contour loops -->
    <div class="absolute bottom-0 right-0 pointer-events-none select-none overflow-hidden w-[580px] h-[440px]">
      <svg viewBox="0 0 580 440" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full opacity-40" aria-hidden="true">
        <!-- Peak 1 — dominant, upper right -->
        <path d="M420 80 C445 55, 495 48, 528 65 C558 80, 572 112, 562 142 C552 170, 528 188, 498 192 C468 196, 440 180, 424 158 C406 134, 398 104, 420 80Z" stroke="white" stroke-width="1" fill="none" opacity="0.3"/>
        <path d="M428 90 C450 68, 494 62, 522 78 C548 92, 560 120, 550 146 C540 170, 518 185, 492 188 C464 191, 440 176, 426 156 C410 134, 406 110, 428 90Z" stroke="white" stroke-width="1.2" fill="none" opacity="0.45"/>
        <path d="M438 102 C458 82, 495 78, 518 94 C540 108, 550 132, 540 155 C530 176, 510 188, 486 190 C462 192, 442 177, 430 158 C416 138, 416 120, 438 102Z" stroke="white" stroke-width="1.5" fill="none" opacity="0.6"/>
        <path d="M450 116 C468 98, 498 95, 516 110 C534 124, 540 148, 530 166 C520 182, 502 190, 480 190 C458 190, 442 178, 434 160 C424 142, 428 132, 450 116Z" stroke="white" stroke-width="1.8" fill="none" opacity="0.75"/>
        <path d="M462 130 C476 116, 500 114, 514 128 C526 140, 528 160, 518 174 C508 186, 492 192, 474 190 C456 188, 446 178, 440 162 C434 148, 446 142, 462 130Z" stroke="white" stroke-width="2" fill="none" opacity="0.88"/>
        <path d="M474 145 C484 134, 502 133, 510 144 C518 155, 516 172, 506 180 C496 188, 480 188, 470 178 C460 168, 462 156, 474 145Z" stroke="white" stroke-width="2.2" fill="none"/>
        <circle cx="492" cy="162" r="3" fill="white"/>

        <!-- Peak 2 — lower left, partial, cut by edge -->
        <path d="M60 380 C30 355, 8 318, 18 282 C28 248, 65 228, 105 235 C142 242, 168 272, 165 308 C162 342, 138 368, 108 378 C88 384, 72 388, 60 380Z" stroke="white" stroke-width="1" fill="none" opacity="0.3"/>
        <path d="M55 370 C30 348, 18 315, 28 282 C38 252, 70 236, 106 244 C138 250, 160 278, 156 310 C152 340, 130 364, 102 372 C80 378, 62 378, 55 370Z" stroke="white" stroke-width="1.2" fill="none" opacity="0.45"/>
        <path d="M52 358 C32 340, 24 310, 36 282 C48 256, 76 244, 108 252 C136 260, 154 286, 148 314 C142 340, 122 360, 96 366 C74 370, 56 364, 52 358Z" stroke="white" stroke-width="1.5" fill="none" opacity="0.6"/>
        <path d="M54 344 C38 328, 34 302, 46 278 C58 256, 84 248, 110 258 C134 266, 148 292, 140 316 C132 338, 114 354, 90 358 C70 362, 58 352, 54 344Z" stroke="white" stroke-width="1.8" fill="none" opacity="0.75"/>
        <path d="M58 330 C46 316, 44 294, 56 274 C68 256, 90 252, 112 262 C132 272, 142 296, 134 318 C126 338, 108 350, 86 352 C68 354, 60 338, 58 330Z" stroke="white" stroke-width="2" fill="none" opacity="0.88"/>
        <circle cx="98" cy="302" r="3" fill="white"/>

        <!-- Peak 3 — small, mid-right area -->
        <path d="M340 255 C355 235, 385 230, 405 245 C422 258, 425 282, 412 298 C400 312, 378 316, 360 305 C342 294, 330 272, 340 255Z" stroke="white" stroke-width="1" fill="none" opacity="0.35"/>
        <path d="M348 262 C360 245, 384 242, 400 256 C414 268, 416 288, 404 302 C392 314, 372 316, 356 306 C340 296, 334 276, 348 262Z" stroke="white" stroke-width="1.3" fill="none" opacity="0.55"/>
        <path d="M356 270 C366 256, 384 254, 396 266 C406 276, 408 293, 398 305 C388 314, 370 316, 356 306 C344 296, 344 282, 356 270Z" stroke="white" stroke-width="1.6" fill="none" opacity="0.75"/>
        <circle cx="382" cy="286" r="2.5" fill="white"/>
      </svg>
    </div>
    <div class="container-wide relative z-10">
      <div class="max-w-3xl">
        <p class="font-heading text-white/50 font-medium tracking-wide mb-4 animate-slide-up opacity-0" style="animation-delay: 0.1s;">
          Our Services
        </p>
        <h1 class="text-display-lg text-white mb-6 animate-slide-up opacity-0" style="animation-delay: 0.2s;">
          Expertise that <span class="text-mbl-ink">drives results</span>
        </h1>
        <p class="text-xl text-white/70 leading-relaxed animate-slide-up opacity-0" style="animation-delay: 0.3s;">
          We bring together creative and technical disciplines to solve complex
          business challenges. Each engagement is tailored to your specific needs
          and goals.
        </p>
      </div>
    </div>
  </section>

  <!-- Services List -->
  <section class="pt-20 md:pt-28 pb-20">
    <div class="container-wide">
      <div class="space-y-16">
        {services.map((service: any) => (
          <a 
            href={`/services/${service.slug}`}
            class="group block"
          >
            <div class="grid lg:grid-cols-2 gap-8 lg:gap-16 items-center p-8 lg:p-12 rounded-2xl bg-white border border-mbl-mist/50 hover:border-mbl-accent/30 hover:shadow-lg transition-all duration-300">
              <div>
                <!-- Large service icon -->
                <div class="w-32 h-32 flex items-center justify-start mb-0 -ml-2">
                  <svg class={`w-24 h-24 ${service.color === 'warm' ? 'text-mbl-warm' : 'text-mbl-accent'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={serviceIcons[service.icon] || serviceIcons.ai} />
                </div>

                <h2 class="font-display text-3xl mb-4 group-hover:text-mbl-accent transition-colors duration-300">
                  {service.title}
                </h2>
                
                <p class="text-lg text-mbl-stone mb-6">
                  {service.description}
                </p>
                
                <span class="inline-flex items-center gap-2 font-heading font-medium text-mbl-accent">
                  Learn more
                  <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </span>
              </div>
              
              <div>
                <p class="text-sm font-heading font-medium text-mbl-stone/70 uppercase tracking-wider mb-4">
                  What we offer
                </p>
                <ul class="grid grid-cols-2 gap-3">
                  {service.offerings.map((offering: string) => (
                    <li class="flex items-start gap-2 text-mbl-stone">
                      <svg class={`w-5 h-5 mt-0.5 flex-shrink-0 ${service.color === 'warm' ? 'text-mbl-warm' : 'text-mbl-accent'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                      {offering}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  
  <!-- CTA -->
  <section class="section-spacing bg-mbl-accent">
    <div class="container-narrow text-center">
      <h2 class="text-display text-white mb-6">Not sure which service you need?</h2>
      <p class="text-lg text-mbl-mist/80 mb-10 max-w-xl mx-auto">
        Tell us what you're working on and we'll help you figure out the best approach.
        No pressure, just an honest conversation.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-mbl-ink font-heading font-medium rounded-md hover:bg-mbl-mist transition-colors duration-200">
          Send us a message
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </a>
        <a href="/chat" class="inline-flex items-center gap-2 px-6 py-3 border border-white/30 text-white font-heading font-medium rounded-md hover:bg-white/10 transition-colors duration-200">
          Chat with AI first
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
