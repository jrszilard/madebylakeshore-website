---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroTwinkle from '../../components/HeroTwinkle.astro';
import { sanityClient, urlFor, queries } from '../../lib/sanity';

export const prerender = false;

const { slug } = Astro.params;
const [person, caseStudies] = await Promise.all([
  sanityClient.fetch(queries.personBySlug, { slug }),
  sanityClient.fetch(queries.caseStudiesByPerson, { slug }),
]);

if (!person) return Astro.redirect('/about');

const heroImage = person.image?.asset ? urlFor(person.image).width(1200).url() : null;

const categoryColors: Record<string, string> = {
  design: 'bg-mbl-warm/10 text-mbl-warm',
  data: 'bg-mbl-accent/10 text-mbl-accent',
  ai: 'bg-purple-100 text-purple-600',
};
---

<BaseLayout
  title={person.name}
  description={person.shortBio || `Meet ${person.name} — ${person.role} at Lakeshore Studios.`}
>
  <!-- Hero -->
  <section class="relative section-spacing bg-[#1e3030] overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0 bg-pattern"></div>
    </div>
    <HeroTwinkle />
    <!-- Person-specific motif -->
    <div class="absolute bottom-0 right-0 pointer-events-none select-none overflow-hidden w-[520px] h-[400px]">
      {slug === 'wilma-huertas' ? (
        /* Wilma — golden ratio / Fibonacci spiral */
        <svg viewBox="0 0 520 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full opacity-40" aria-hidden="true">
          <!-- Fibonacci rectangle grid lines -->
          <rect x="30" y="30" width="460" height="340" stroke="white" stroke-width="1" opacity="0.2"/>
          <line x1="314" y1="30" x2="314" y2="370" stroke="white" stroke-width="1" opacity="0.2"/>
          <line x1="30" y1="240" x2="314" y2="240" stroke="white" stroke-width="1" opacity="0.2"/>
          <line x1="314" y1="136" x2="490" y2="136" stroke="white" stroke-width="1" opacity="0.2"/>
          <line x1="420" y1="136" x2="420" y2="370" stroke="white" stroke-width="1" opacity="0.2"/>
          <line x1="314" y1="302" x2="420" y2="302" stroke="white" stroke-width="1" opacity="0.2"/>
          <line x1="368" y1="302" x2="368" y2="370" stroke="white" stroke-width="1" opacity="0.2"/>
          <!-- The spiral — quarter-circle arcs following Fibonacci boxes -->
          <!-- Large arc: bottom-right of big left square -->
          <path d="M 314 240 A 284 284 0 0 0 30 370" stroke="white" stroke-width="2.5" fill="none" opacity="0.9" stroke-linecap="round"/>
          <!-- Second arc -->
          <path d="M 314 30 A 176 176 0 0 1 314 240" stroke="white" stroke-width="2" fill="none" opacity="0.75" stroke-linecap="round"/>
          <!-- Third arc -->
          <path d="M 490 136 A 108 108 0 0 0 314 30" stroke="white" stroke-width="2" fill="none" opacity="0.65" stroke-linecap="round"/>
          <!-- Fourth arc -->
          <path d="M 420 370 A 66 66 0 0 1 490 136" stroke="white" stroke-width="1.5" fill="none" opacity="0.55" stroke-linecap="round"/>
          <!-- Fifth arc -->
          <path d="M 314 302 A 41 41 0 0 0 420 370" stroke="white" stroke-width="1.5" fill="none" opacity="0.45" stroke-linecap="round"/>
          <!-- Sixth arc -->
          <path d="M 368 136 A 25 25 0 0 1 314 302" stroke="white" stroke-width="1" fill="none" opacity="0.35" stroke-linecap="round"/>
          <!-- Tiny arcs -->
          <path d="M 368 302 A 15 15 0 0 0 368 136" stroke="white" stroke-width="1" fill="none" opacity="0.25" stroke-linecap="round"/>
        </svg>
      ) : (
        /* Justin — scatter plot / data viz */
        <svg viewBox="0 0 520 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full opacity-40" aria-hidden="true">
          <!-- Axis lines -->
          <line x1="60" y1="340" x2="480" y2="340" stroke="white" stroke-width="1.5" opacity="0.4"/>
          <line x1="60" y1="60" x2="60" y2="340" stroke="white" stroke-width="1.5" opacity="0.4"/>
          <!-- Trend line -->
          <line x1="80" y1="300" x2="460" y2="100" stroke="white" stroke-width="1" opacity="0.25" stroke-dasharray="6 4"/>
          <!-- Data points — scattered around the trend -->
          <circle cx="100" cy="290" r="5" fill="white" opacity="0.9"/>
          <circle cx="140" cy="270" r="4" fill="white" opacity="0.7"/>
          <circle cx="175" cy="255" r="6" fill="white" opacity="0.85"/>
          <circle cx="210" cy="230" r="3.5" fill="white" opacity="0.6"/>
          <circle cx="240" cy="245" r="5" fill="white" opacity="0.75"/>
          <circle cx="275" cy="210" r="4.5" fill="white" opacity="0.8"/>
          <circle cx="300" cy="195" r="3" fill="white" opacity="0.55"/>
          <circle cx="330" cy="180" r="6" fill="white" opacity="0.9"/>
          <circle cx="360" cy="165" r="4" fill="white" opacity="0.65"/>
          <circle cx="390" cy="150" r="5" fill="white" opacity="0.8"/>
          <circle cx="420" cy="135" r="3.5" fill="white" opacity="0.6"/>
          <circle cx="450" cy="115" r="5.5" fill="white" opacity="0.85"/>
          <!-- Outliers -->
          <circle cx="160" cy="310" r="3" fill="white" opacity="0.45"/>
          <circle cx="260" cy="175" r="3.5" fill="white" opacity="0.5"/>
          <circle cx="350" cy="220" r="4" fill="white" opacity="0.5"/>
          <circle cx="410" cy="175" r="3" fill="white" opacity="0.4"/>
          <!-- Glow rings on key points -->
          <circle cx="175" cy="255" r="12" stroke="white" stroke-width="1" fill="none" opacity="0.2"/>
          <circle cx="330" cy="180" r="13" stroke="white" stroke-width="1" fill="none" opacity="0.18"/>
        </svg>
      )}
    </div>
    <div class="container-wide relative z-10">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <!-- Text -->
        <div>
          <a href="/about" class="inline-flex items-center gap-2 text-sm text-white/50 hover:text-white transition-colors mb-8">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Back to About
          </a>
          <p class="font-heading text-white/50 font-medium tracking-wide mb-3">
            {person.role}
          </p>
          <h1 class="text-display-lg text-white mb-4 animate-slide-up opacity-0" style="animation-delay: 0.1s;">
            {person.name}
          </h1>
          {person.headline && (
            <p class="text-xl text-white/70 mb-8 animate-slide-up opacity-0" style="animation-delay: 0.2s;">
              {person.headline}
            </p>
          )}
          {person.shortBio && (
            <p class="text-lg text-white/70 leading-relaxed mb-10 animate-slide-up opacity-0" style="animation-delay: 0.3s;">
              {person.shortBio}
            </p>
          )}

          <!-- Social Links -->
          <div class="flex flex-wrap gap-4">
            {person.social?.linkedin && (
              <a href={person.social.linkedin} target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm font-heading font-medium text-white/60 hover:text-white transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
                LinkedIn
              </a>
            )}
            {person.social?.dribbble && (
              <a href={person.social.dribbble} target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm font-heading font-medium text-white/60 hover:text-white transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 24C5.385 24 0 18.615 0 12S5.385 0 12 0s12 5.385 12 12-5.385 12-12 12zm10.12-10.358c-.35-.11-3.17-.953-6.384-.438 1.34 3.684 1.887 6.684 1.992 7.308 2.3-1.555 3.936-4.02 4.395-6.87zm-6.115 7.808c-.153-.9-.75-4.032-2.19-7.77l-.066.02c-5.79 2.015-7.86 6.025-8.04 6.4 1.73 1.358 3.92 2.166 6.29 2.166 1.42 0 2.77-.29 4-.816zm-11.62-2.073c.23-.386 3.09-5.057 8.364-6.734.208-.07.42-.134.634-.193a16.4 16.4 0 00-.483-1.061C7.3 12.694 2.655 12.875 2.5 12.875c-.014 0-.03 0-.045-.001v.34c0 1.877.552 3.625 1.505 5.074l.426-.513zM2.59 11.1c.18.002 4.065-.04 8.945-1.72-1.6-2.852-3.33-5.25-3.6-5.63-2.68 1.282-4.696 3.65-5.345 6.35zm7.28-7.987c.28.39 2.04 2.79 3.62 5.7 3.45-1.293 4.91-3.258 5.08-3.5C16.61 3.618 14.44 2.5 12 2.5c-.75 0-1.477.1-2.17.277l.04.336z"/>
                </svg>
                Dribbble
              </a>
            )}
            {person.social?.github && (
              <a href={person.social.github} target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm font-heading font-medium text-white/60 hover:text-white transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                </svg>
                GitHub
              </a>
            )}
            {person.social?.twitter && (
              <a href={person.social.twitter} target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm font-heading font-medium text-white/60 hover:text-white transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
                X / Twitter
              </a>
            )}
            {person.email && (
              <a href={`mailto:${person.email}`}
                class="inline-flex items-center gap-2 text-sm font-heading font-medium text-white/60 hover:text-white transition-colors">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                Email
              </a>
            )}
          </div>

          {person.location?.length > 0 && (
            <div class="mt-8 inline-flex items-center gap-3 bg-white/10 rounded-2xl px-5 py-3">
              <svg class="w-4 h-4 text-white/60 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span class="text-sm text-white/70 font-medium">{person.location.join(' · ')}</span>
            </div>
          )}
        </div>

        <!-- Photo -->
        {heroImage && (
          <div class="relative flex justify-center">
            <img
              src={heroImage}
              alt={person.name}
              class="w-80 lg:w-96 rounded-lg object-cover"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Case Studies -->
  {caseStudies?.length > 0 && (
    <section class="section-spacing">
      <div class="container-wide">
        <div class="max-w-2xl mb-12">
          <p class="font-heading text-mbl-accent font-medium tracking-wide mb-3">Work</p>
          <h2 class="font-display text-display">Case Studies</h2>
        </div>
        <div class="space-y-16">
          {caseStudies.map((study: any) => {
            const studyImage = study.featuredImage?.asset
              ? urlFor(study.featuredImage).width(800).url()
              : null;
            return (
              <a href={`/case-studies/${study.slug?.current}?back=/team/${slug}`} class="group grid md:grid-cols-2 gap-8 lg:gap-16 items-center block">
                <!-- Image -->
                <div class="relative rounded-lg overflow-hidden">
                  {studyImage ? (
                    <img src={studyImage} alt={study.title} class="w-full h-auto block" loading="lazy" decoding="async" />
                  ) : (
                    <div class="aspect-[4/3] bg-gradient-to-br from-mbl-slate to-mbl-dusk opacity-80"></div>
                  )}
                </div>
                <!-- Content -->
                <div>
                  <div class="flex items-center gap-3 mb-4 flex-wrap">
                    <span class={`px-3 py-1 rounded-full text-xs font-heading font-medium ${categoryColors[study.category] ?? 'bg-mbl-mist text-mbl-stone'}`}>
                      {study.category?.charAt(0).toUpperCase() + study.category?.slice(1)}
                    </span>
                    {study.client && <span class="text-sm text-mbl-stone">{study.client}</span>}
                    {study.isProtected && (
                      <svg class="w-4 h-4 text-mbl-stone/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-label="Password protected">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                      </svg>
                    )}
                  </div>
                  <h3 class="font-display text-2xl lg:text-3xl mb-4 group-hover:text-mbl-accent transition-colors duration-300">
                    {study.title}
                  </h3>
                  {study.excerpt && (
                    <p class="text-mbl-stone mb-6">{study.excerpt}</p>
                  )}
                  {study.metrics?.length > 0 && !study.isProtected && (
                    <div class="grid grid-cols-3 gap-6 mb-6">
                      {study.metrics.slice(0, 3).map((metric: any) => (
                        <div>
                          <div class="text-2xl font-display text-mbl-accent mb-1">{metric.value}</div>
                          <div class="text-sm text-mbl-stone">{metric.label}</div>
                        </div>
                      ))}
                    </div>
                  )}
                  <span class="inline-flex items-center gap-2 font-heading font-medium text-mbl-ink group-hover:text-mbl-accent transition-colors">
                    {study.isProtected ? 'Request access' : 'Read case study'}
                    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Beyond Work -->
  {(person.location?.length || person.interests?.length || person.favoriteShows?.length || person.favoriteBooks?.length || person.currentlyListening?.length || person.photoGallery?.length) && (
    <section class="pt-20 md:pt-28 pb-8 bg-white">
      <div class="container-wide">
        <h2 class="font-display text-2xl mb-12">Beyond Work</h2>

        <div class="space-y-16">

          <!-- Bento grid: interests -->
          {person.interests?.length > 0 && (
            <div class="grid md:grid-cols-3 gap-4">
              {person.interests?.length > 0 && (
                <div class="md:col-span-3 bg-mbl-ink rounded-2xl p-6">
                  <div class="flex items-center gap-2 text-mbl-accent mb-4">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                    </svg>
                    <span class="font-heading font-semibold text-xs uppercase tracking-wider">Interests</span>
                  </div>
                  <div class="flex flex-wrap gap-2">
                    {person.interests.map((interest: { label: string; imageUrl?: string }, i: number) => {
                      const palettes = [
                        'bg-mbl-dusk/20 text-mbl-dusk border-mbl-dusk/30',
                        'bg-mbl-accent/20 text-mbl-accent border-mbl-accent/30',
                        'bg-purple-500/20 text-purple-300 border-purple-500/30',
                        'bg-emerald-500/20 text-emerald-300 border-emerald-500/30',
                        'bg-sky-500/20 text-sky-300 border-sky-500/30',
                      ];
                      const palette = palettes[i % palettes.length];
                      const imgUrl = interest.imageUrl
                        ? `${interest.imageUrl}?w=640&auto=format`
                        : null;
                      return (
                        <span
                          class={`interest-tag px-3 py-1.5 rounded-full text-sm font-medium border ${palette} hover:scale-105 transition-transform duration-150 cursor-default`}
                          data-hover-img={imgUrl ?? undefined}
                        >
                          {interest.label}
                        </span>
                      );
                    })}
                  </div>
                </div>
              )}
            </div>
          )}

          <!-- Shows & Books as styled cards -->
          {(person.favoriteShows?.length || person.favoriteBooks?.length || person.currentlyListening?.length) && (
            <div class="grid md:grid-cols-3 gap-6">
              {person.favoriteShows?.length > 0 && (
                <div class="rounded-2xl border border-mbl-mist/50 p-6">
                  <div class="flex items-center gap-2 text-mbl-accent mb-6">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.069A1 1 0 0121 8.82v6.36a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                    <span class="font-heading font-semibold text-xs uppercase tracking-wider">Currently Watching</span>
                  </div>
                  <ul class="space-y-2">
                    {person.favoriteShows.map((show: string, i: number) => (
                      <li class="flex items-center gap-3 py-2 border-b border-mbl-mist/30 last:border-0">
                        <span class="text-xs font-heading font-bold text-mbl-accent/50 w-5 text-right flex-shrink-0">{i + 1}</span>
                        <span class="text-mbl-stone">{show}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {person.favoriteBooks?.length > 0 && (
                <div class="rounded-2xl border border-mbl-mist/50 p-6">
                  <div class="flex items-center gap-2 text-mbl-accent mb-6">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                    </svg>
                    <span class="font-heading font-semibold text-xs uppercase tracking-wider">Currently Reading</span>
                  </div>
                  <ul class="space-y-2">
                    {person.favoriteBooks.map((book: string, i: number) => (
                      <li class="flex items-center gap-3 py-2 border-b border-mbl-mist/30 last:border-0">
                        <span class="text-xs font-heading font-bold text-mbl-accent/50 w-5 text-right flex-shrink-0">{i + 1}</span>
                        <span class="text-mbl-stone">{book}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {person.currentlyListening?.length > 0 && (
                <div class="rounded-2xl border border-mbl-mist/50 p-6">
                  <div class="flex items-center gap-2 text-mbl-accent mb-6">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
                    </svg>
                    <span class="font-heading font-semibold text-xs uppercase tracking-wider">Currently Listening To</span>
                  </div>
                  <ul class="space-y-2">
                    {person.currentlyListening.map((item: string, i: number) => (
                      <li class="flex items-center gap-3 py-2 border-b border-mbl-mist/30 last:border-0">
                        <span class="text-xs font-heading font-bold text-mbl-accent/50 w-5 text-right flex-shrink-0">{i + 1}</span>
                        <span class="text-mbl-stone">{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          )}

          <!-- Photo Gallery with hover zoom -->
          {person.photoGallery?.length > 0 && (
            <div class="columns-2 md:columns-3 lg:columns-4 gap-3 space-y-3">
              {person.photoGallery.map((photo: any) => {
                const photoUrl = photo.asset ? urlFor(photo).width(600).url() : null;
                return photoUrl ? (
                  <div class="break-inside-avoid overflow-hidden rounded-xl group">
                    <img
                      src={photoUrl}
                      alt={photo.alt || person.name}
                      class="w-full block transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                ) : null;
              })}
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Companies / Experience -->
  {person.companies?.filter((c: any) => c.logo?.asset).length > 0 && (
    <section class="pt-0 pb-16 bg-white overflow-hidden">
      <div class="container-wide mb-10">
        <h2 class="font-display text-2xl">Companies I've Worked With</h2>
      </div>

      <div class="relative">
        <div class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-white to-transparent z-10 pointer-events-none"></div>
        <div class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-white to-transparent z-10 pointer-events-none"></div>

        <div class="flex logo-scroll-track-profile">
          {[...person.companies, ...person.companies].filter((c: any) => c.logo?.asset).map((company: any, i: number) => (
            <div class="flex-shrink-0 flex items-center justify-center px-10 h-20">
              <img
                src={`${urlFor(company.logo).height(60).url()}`}
                alt={company.name || ''}
                class="h-10 w-auto object-contain grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300"
                loading="lazy"
                decoding="async"
              />
            </div>
          ))}
        </div>
      </div>

      <style>
        .logo-scroll-track-profile {
          animation: logo-scroll 30s linear infinite;
          width: max-content;
        }
        .logo-scroll-track-profile:hover {
          animation-play-state: paused;
        }
        @keyframes logo-scroll {
          from { transform: translateX(0); }
          to { transform: translateX(-50%); }
        }
      </style>
    </section>
  )}

  <!-- Interest hover preview -->
  <div
    id="interest-preview"
    style="position:fixed;pointer-events:none;z-index:9999;opacity:0;transition:opacity 0.2s ease;width:320px;border-radius:12px;overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,0.18);display:none;"
    aria-hidden="true"
  >
    <img id="interest-preview-img" src="" alt="" style="width:100%;height:auto;display:block;" />
  </div>

  <script>
    const preview = document.getElementById('interest-preview') as HTMLElement | null;
    const previewImg = document.getElementById('interest-preview-img') as HTMLImageElement | null;
    if (preview && previewImg) {
      let mouseX = 0;
      let mouseY = 0;

      document.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
        if (preview.style.display !== 'none') {
          preview.style.left = `${mouseX + 20}px`;
          preview.style.top = `${mouseY - 180}px`;
        }
      });

      document.querySelectorAll<HTMLElement>('.interest-tag[data-hover-img]').forEach((tag) => {
        const imgUrl = tag.dataset.hoverImg;
        if (!imgUrl) return;

        tag.addEventListener('mouseenter', () => {
          previewImg.src = imgUrl;
          preview.style.display = 'block';
          preview.style.left = `${mouseX + 20}px`;
          preview.style.top = `${mouseY - 180}px`;
          requestAnimationFrame(() => { preview.style.opacity = '1'; });
        });

        tag.addEventListener('mouseleave', () => {
          preview.style.opacity = '0';
          setTimeout(() => { preview.style.display = 'none'; }, 200);
        });
      });
    }
  </script>

  <!-- CTA -->
  <section class="section-spacing bg-mbl-dusk">
    <div class="container-narrow text-center">
      <h2 class="text-display text-white mb-6">Let's work together</h2>
      <p class="text-lg text-white/70 mb-10 max-w-xl mx-auto">
        Have a project in mind? I'd love to hear about it.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-mbl-ink font-heading font-medium rounded-md hover:bg-mbl-mist transition-colors duration-200">
          Get in Touch
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        {person.calendlyUrl && (
          <a href={person.calendlyUrl} target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 border border-white/40 text-white font-heading font-medium rounded-md hover:bg-white/10 transition-colors duration-200">
            Schedule a Call
          </a>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
