---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroTwinkle from '../components/HeroTwinkle.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BrandCard from '../components/BrandCard.astro';
import { sanityClient, urlFor, queries } from '../lib/sanity';

// Fetch services from Sanity
const sanityServices = await sanityClient.fetch(queries.allServices);
const services = sanityServices.map((service: any) => ({
  title: service.title,
  description: service.tagline || '',
  href: `/services/${service.slug?.current || service.icon}`,
  icon: service.icon as 'design' | 'data' | 'ai',
  consultant: service.consultant?.name || '',
}));

// Fetch featured case studies from Sanity
const sanityCaseStudies = await sanityClient.fetch(queries.featuredCaseStudies);
const featuredProjects = sanityCaseStudies.map((study: any) => ({
  title: study.title,
  client: study.client || '',
  category: study.category ? study.category.charAt(0).toUpperCase() + study.category.slice(1) : '',
  image: study.featuredImage?.asset ? urlFor(study.featuredImage).width(800).url() : '/images/project-placeholder.jpg',
  href: `/case-studies/${study.slug?.current}`,
}));

// Fetch featured Incubator projects from Sanity
const sanityIncubatorProjects = await sanityClient.fetch(queries.featuredProjects);
const incubatorProjects = sanityIncubatorProjects.map((project: any) => ({
  title: project.title,
  tagline: project.tagline || '',
  category: project.category || '',
  slug: project.slug?.current || '',
  techStack: project.techStack || [],
  highlights: project.highlights || [],
  liveUrl: project.liveUrl || null,
  demoUrl: project.demoUrl || null,
  githubUrl: project.githubUrl || null,
}));

const categoryLabels: Record<string, string> = {
  'ai-ml': 'AI/ML',
  'automation': 'Automation',
  'dev-tools': 'Dev Tools',
  'web-app': 'Web App',
  'data-analytics': 'Data & Analytics',
  'other': 'Other',
};

const brands = [
  {
    title: 'Design & Other Stories',
    description: 'Handmade in New Hampshire with a lot of care.',
    href: 'https://designandotherstories.com',
    external: true,
    color: 'warm' as const,
  },
  {
    title: 'Incubator at Lakeshore',
    description: 'Our technology playground.',
    href: 'https://incubator.madebylakeshore.com',
    external: true,
    color: 'accent' as const,
  },
];
---

<BaseLayout title="Home">
  <!-- Hero Section -->
  <section class="relative min-h-[90vh] flex items-center overflow-hidden bg-[#1e3030]">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0 bg-pattern"></div>
    </div>
    <HeroTwinkle />

    <div class="container-wide relative z-10">
      <div class="max-w-4xl">
        <!-- Logomark -->
        <div class="mb-1 animate-slide-up opacity-0" style="animation-delay: 0s;">
          <img src="/logomark.png" alt="" aria-hidden="true" class="h-24 w-auto" />
        </div>

        <div class="overflow-hidden mb-8">
          <h1 class="text-display-lg md:text-display-xl text-white animate-slide-up opacity-0" style="animation-delay: 0.1s;">
            Your data has a story. We make sure people
            <span class="text-mbl-dusk">actually read it.</span>
          </h1>
        </div>

        <div class="flex flex-wrap gap-4 animate-slide-up opacity-0" style="animation-delay: 0.3s;">
          <a href="/contact" class="btn-primary">
            Start a Project
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="/case-studies" class="inline-flex items-center gap-2 px-6 py-3 border border-white/30 text-white font-heading font-medium rounded-md hover:bg-white/10 transition-colors duration-200">
            View Our Work
          </a>
        </div>
      </div>
    </div>

    <!-- Water splash -->
    <div class="absolute bottom-0 right-0 pointer-events-none select-none overflow-hidden w-[480px] h-[380px]">
      <svg viewBox="0 0 480 380" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full opacity-40">
        <!-- Base water surface -->
        <path d="M80 300 C150 285, 220 310, 300 295 C360 283, 420 300, 480 290" stroke="white" stroke-width="2" stroke-linecap="round" fill="none"/>
        <!-- Main splash arc left -->
        <path d="M200 300 C185 260, 160 200, 190 150 C205 125, 225 130, 220 160 C215 185, 200 200, 210 240" stroke="white" stroke-width="2.5" stroke-linecap="round" fill="none"/>
        <!-- Main splash arc right -->
        <path d="M260 300 C275 255, 310 190, 290 140 C278 112, 255 118, 262 148 C268 172, 285 185, 272 230" stroke="white" stroke-width="2.5" stroke-linecap="round" fill="none"/>
        <!-- Tall center plume -->
        <path d="M235 300 C230 250, 225 180, 238 100 C242 75, 252 75, 254 100 C262 180, 255 250, 252 300" stroke="white" stroke-width="2" stroke-linecap="round" fill="none"/>
        <!-- Smaller side arcs -->
        <path d="M160 295 C148 265, 138 230, 155 200 C163 187, 172 192, 168 210" stroke="white" stroke-width="1.5" stroke-linecap="round" fill="none"/>
        <path d="M320 295 C338 260, 350 220, 335 192 C326 178, 316 184, 320 205" stroke="white" stroke-width="1.5" stroke-linecap="round" fill="none"/>
        <!-- Droplets -->
        <circle cx="195" cy="118" r="3" fill="white"/>
        <circle cx="178" cy="90" r="2" fill="white"/>
        <circle cx="215" cy="78" r="2.5" fill="white"/>
        <circle cx="238" cy="58" r="3" fill="white"/>
        <circle cx="258" cy="68" r="2" fill="white"/>
        <circle cx="278" cy="82" r="2.5" fill="white"/>
        <circle cx="295" cy="108" r="2" fill="white"/>
        <circle cx="162" cy="148" r="1.5" fill="white"/>
        <circle cx="335" cy="155" r="1.5" fill="white"/>
        <circle cx="148" cy="170" r="1.5" fill="white" opacity="0.6"/>
        <circle cx="350" cy="178" r="1.5" fill="white" opacity="0.6"/>
      </svg>
    </div>
  </section>
  
  <!-- Services Section -->
  <section class="section-spacing bg-white">
    <div class="container-wide">
      <div class="max-w-2xl mx-auto text-center mb-16">
        <p class="font-heading text-mbl-accent font-medium tracking-wide mb-4">What We Do</p>
        <h2 class="text-display mb-6">A family-owned data and creative center</h2>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        {services.map((service: any, index: number) => (
          <ServiceCard {...service} index={index} />
        ))}
      </div>
    </div>
  </section>
  
  <!-- Featured Work Section -->
  {featuredProjects.length > 0 && (
  <section class="section-spacing">
    <div class="container-wide">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-16">
        <div class="max-w-2xl">
          <p class="font-heading text-mbl-accent font-medium tracking-wide mb-4">Selected Work</p>
          <h2 class="text-display">Work We're Proud Of</h2>
        </div>
        <a href="/case-studies" class="link-underline font-heading font-medium text-mbl-ink">
          View all projects
        </a>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {featuredProjects.map((project: any, index: number) => (
          <ProjectCard {...project} index={index} />
        ))}
      </div>
    </div>
  </section>
  )}
  
  <!-- AI Projects Section -->
  {incubatorProjects.length > 0 && (
  <section class="section-spacing bg-white">
    <div class="container-wide">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-16">
        <div class="max-w-2xl">
          <p class="font-heading text-mbl-accent font-medium tracking-wide mb-4">From Our Incubator</p>
          <h2 class="text-display">Tools We're Building</h2>
          <p class="text-lg text-mbl-stone mt-4">
            Check out our experiments.
          </p>
        </div>
        <a href="https://incubator.madebylakeshore.com" target="_blank" rel="noopener noreferrer" class="link-underline font-heading font-medium text-mbl-ink">
          Explore Incubator
        </a>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {incubatorProjects.map((project: any) => (
          <div class="group p-6 border border-mbl-stone/15 rounded-xl hover:border-mbl-accent/30 hover:shadow-lg transition-all duration-300">
            <div class="flex items-center justify-between mb-4">
              {project.category && (
                <span class="px-2 py-1 text-xs font-heading font-medium text-mbl-accent bg-mbl-accent/10 rounded">
                  {categoryLabels[project.category] || project.category}
                </span>
              )}
            </div>

            <h3 class="font-display text-xl text-mbl-ink mb-2 group-hover:text-mbl-accent transition-colors">
              {project.title}
            </h3>

            <p class="text-mbl-stone text-sm mb-4">
              {project.tagline}
            </p>

            {project.highlights && project.highlights.length > 0 && (
              <ul class="mb-4 space-y-1.5">
                {project.highlights.slice(0, 3).map((h: string) => (
                  <li class="text-mbl-stone text-xs flex items-start gap-2">
                    <span class="text-mbl-accent mt-0.5">▸</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            )}

            <div class="flex flex-wrap gap-2 mb-5">
              {project.techStack.slice(0, 3).map((tech: string) => (
                <span class="px-2 py-0.5 bg-mbl-mist/50 text-mbl-stone text-xs rounded">
                  {tech}
                </span>
              ))}
            </div>

            <div class="flex items-center gap-4 pt-4 border-t border-mbl-stone/10">
              {project.demoUrl && (
                <a
                  href={project.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm font-heading font-medium text-mbl-accent hover:underline"
                >
                  Try Demo →
                </a>
              )}
              {project.liveUrl && !project.demoUrl && (
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm font-heading font-medium text-mbl-accent hover:underline"
                >
                  Visit →
                </a>
              )}
              {project.githubUrl && (
                <a
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-mbl-stone hover:text-mbl-ink flex items-center gap-1 ml-auto"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                  GitHub
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- Our Brands Section -->
  <section class="section-spacing bg-mbl-dusk">
    <div class="container-wide">
      <div class="max-w-2xl mb-16">
        <p class="font-heading text-mbl-mist font-medium tracking-wide mb-4">Beyond Consulting</p>
        <h2 class="text-display text-white mb-6">The Lakeshore family</h2>
        <p class="text-lg text-white/70">
          Work is just one side of us. Here's what else we're making.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-8">
        {brands.map((brand) => (
          <BrandCard {...brand} />
        ))}
      </div>
    </div>
  </section>
  
  <!-- CTA Section -->
  <section class="section-spacing">
    <div class="container-narrow text-center">
      <h2 class="text-display mb-6">Ready to start something great?</h2>
      <p class="text-lg text-mbl-stone mb-10 max-w-xl mx-auto">
        Got a project in mind? We'd love to hear about it, even if it's just an idea right now.
      </p>
      <a href="/contact" class="btn-primary">
        Let's Talk
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
