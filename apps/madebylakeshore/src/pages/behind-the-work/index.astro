---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroTwinkle from '../../components/HeroTwinkle.astro';
import { sanityClient, urlFor, queries } from '../../lib/sanity';

export const prerender = false;

const posts = await sanityClient.fetch(queries.allBlogPosts);

const categoryColors: Record<string, string> = {
  design: 'bg-mbl-warm/10 text-mbl-warm',
  data: 'bg-mbl-accent/10 text-mbl-accent',
  ai: 'bg-purple-100 text-purple-600',
};

function formatDate(iso: string | null | undefined): string {
  if (!iso) return '';
  return new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const allCategories: string[] = Array.from(
  new Set(posts.flatMap((p: any) => p.categories ?? []))
).sort() as string[];
---

<BaseLayout
  title="Behind the Work"
  description="Deeper dives into the process, decisions, and craft behind our projects — the parts that don't fit in a case study."
>
  <!-- Hero -->
  <section class="relative section-spacing bg-[#1e3030] overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0 bg-pattern"></div>
    </div>
    <HeroTwinkle />
    <div class="container-wide relative z-10">
      <div class="max-w-3xl">
        <p class="font-heading text-white/50 font-medium tracking-wide mb-4 animate-slide-up opacity-0" style="animation-delay: 0.1s;">
          Behind the Work
        </p>
        <h1 class="text-display-lg text-white mb-6 animate-slide-up opacity-0" style="animation-delay: 0.2s;">
          The process <span class="text-mbl-dusk">behind</span> the work
        </h1>
        <p class="text-xl text-white/70 leading-relaxed animate-slide-up opacity-0" style="animation-delay: 0.3s;">
          Case studies show what we built. These posts explain how and why —
          the decisions, dead ends, and discoveries along the way.
        </p>
      </div>
    </div>
  </section>

  <!-- Posts -->
  <section class="pt-20 md:pt-28 pb-20">
    <div class="container-wide">
      {posts.length === 0 ? (
        <p class="text-mbl-stone text-lg text-center py-16">Posts coming soon.</p>
      ) : (
        <>
          {/* Filter pills */}
          {allCategories.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-10" id="filter-bar" role="group" aria-label="Filter posts by category">
              <button
                data-filter="all"
                class="filter-pill px-4 py-1.5 rounded-full text-sm font-heading font-medium transition-colors duration-200 bg-mbl-ink text-white"
              >
                All
              </button>
              {allCategories.map((cat) => (
                <button
                  data-filter={cat}
                  class="filter-pill px-4 py-1.5 rounded-full text-sm font-heading font-medium transition-colors duration-200 bg-mbl-cloud text-mbl-stone hover:bg-mbl-mist"
                >
                  {cat}
                </button>
              ))}
            </div>
          )}

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8" id="posts-grid">
          {posts.map((post: any, index: number) => {
            const imgUrl = post.featuredImage?.asset
              ? urlFor(post.featuredImage).width(800).height(500).fit('crop').url()
              : null;
            const caseStudy = post.relatedCaseStudy;
            const cats = (post.categories ?? []).join(',');

            return (
              <a href={`/behind-the-work/${post.slug?.current}`} class="group block post-card" data-categories={cats}>
                <article class="h-full flex flex-col rounded-lg overflow-hidden border border-mbl-mist/50 hover:border-mbl-accent/30 transition-colors duration-300">
                  <!-- Image -->
                  <div class="aspect-[16/10] overflow-hidden bg-mbl-cloud">
                    {imgUrl ? (
                      <img
                        src={imgUrl}
                        alt={post.title}
                        class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
                        loading={index < 3 ? undefined : 'lazy'}
                        fetchpriority={index === 0 ? 'high' : undefined}
                        decoding="async"
                      />
                    ) : (
                      <div class="w-full h-full bg-gradient-to-br from-mbl-slate to-mbl-dusk opacity-60" />
                    )}
                  </div>

                  <!-- Content -->
                  <div class="flex flex-col flex-1 p-6">
                    {caseStudy && (
                      <div class="mb-3">
                        <span class={`inline-block px-2.5 py-1 rounded-full text-xs font-heading font-medium ${categoryColors[caseStudy.category] ?? 'bg-mbl-mist text-mbl-stone'}`}>
                          {caseStudy.client || caseStudy.title}
                        </span>
                      </div>
                    )}

                    <h2 class="font-display text-xl text-mbl-ink mb-3 leading-snug group-hover:text-mbl-accent transition-colors duration-300">
                      {post.title}
                    </h2>

                    {post.excerpt && (
                      <p class="text-mbl-stone text-sm leading-relaxed mb-4 flex-1">
                        {post.excerpt}
                      </p>
                    )}

                    <div class="flex items-center gap-3 mt-auto pt-4 border-t border-mbl-mist/50">
                      {post.author?.image?.asset && (
                        <img
                          src={urlFor(post.author.image).width(40).height(40).fit('crop').url()}
                          alt={post.author.name}
                          class="w-8 h-8 rounded-full object-cover"
                          loading="lazy"
                        />
                      )}
                      <div class="min-w-0">
                        {post.author?.name && (
                          <p class="text-sm font-heading font-medium text-mbl-ink truncate">{post.author.name}</p>
                        )}
                        {post.publishedAt && (
                          <p class="text-xs text-mbl-stone">{formatDate(post.publishedAt)}</p>
                        )}
                      </div>
                      <span class="ml-auto text-sm font-heading font-medium text-mbl-stone group-hover:text-mbl-accent transition-colors inline-flex items-center gap-1">
                        Read
                        <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                        </svg>
                      </span>
                    </div>
                  </div>
                </article>
              </a>
            );
          })}
          </div>

          {/* Empty state when filter has no results */}
          <p id="no-results" class="hidden text-mbl-stone text-lg text-center py-16">
            No posts in this category yet.
          </p>
        </>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-pill'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.post-card'));
  const noResults = document.getElementById('no-results');

  function setActive(filter: string) {
    pills.forEach((p) => {
      const isActive = p.dataset.filter === filter;
      p.classList.toggle('bg-mbl-ink', isActive);
      p.classList.toggle('text-white', isActive);
      p.classList.toggle('bg-mbl-cloud', !isActive);
      p.classList.toggle('text-mbl-stone', !isActive);
      p.classList.toggle('hover:bg-mbl-mist', !isActive);
    });

    let visible = 0;
    cards.forEach((card) => {
      const cats = card.dataset.categories?.split(',') ?? [];
      const show = filter === 'all' || cats.includes(filter);
      card.classList.toggle('hidden', !show);
      if (show) visible++;
    });

    noResults?.classList.toggle('hidden', visible > 0);
  }

  pills.forEach((pill) => {
    pill.addEventListener('click', () => setActive(pill.dataset.filter ?? 'all'));
  });
</script>
