---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroTwinkle from '../components/HeroTwinkle.astro';
import { sanityClient, urlFor, queries } from '../lib/sanity';

// Fetch data from Sanity
const [sanityPeople, settings] = await Promise.all([
  sanityClient.fetch(queries.allPeople),
  sanityClient.fetch(queries.studioSettings),
]);
const timeline: any[] = settings?.timeline || [];
// Collect all company logos across the team, deduplicated by URL
const allCompanies: { name: string; logoUrl: string }[] = [];
const seen = new Set<string>();
for (const person of sanityPeople) {
  for (const co of person.companies || []) {
    if (co.logoUrl && !seen.has(co.logoUrl)) {
      seen.add(co.logoUrl);
      allCompanies.push({ name: co.name || '', logoUrl: co.logoUrl });
    }
  }
}

const team = sanityPeople.map((person: any) => ({
  name: person.name,
  slug: person.slug,
  role: person.role || '',
  bio: person.shortBio || '',
  specialties: [],
  image: person.image?.asset ? urlFor(person.image).width(600).height(800).url() : null,
  calendlyUrl: person.calendlyUrl || null,
}));

const values = [
  {
    title: 'Clarity Over Complexity',
    description: 'We distill complex problems into clear solutions. Whether it\'s a brand system or a data pipeline, simplicity is the ultimate sophistication.',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>`,
  },
  {
    title: 'Strategy First',
    description: 'Beautiful dashboards and stunning designs mean nothing without purpose. We start with your goals and work backward.',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" /></svg>`,
  },
  {
    title: 'Partnership, Not Projects',
    description: 'We invest in relationships. Our best work comes from truly understanding your business, not just your brief project',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>`,
  },
  {
    title: 'Honest Counsel',
    description: 'We\'ll tell you what you need to hear, not just what you want to hear. That\'s how trust is built.',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" /></svg>`,
  },
];
---

<BaseLayout 
  title="About" 
  description="Meet the team behind Lakeshore Studios. We're a husband-and-wife consulting studio specializing in design, data, and AI."
>
  <!-- Hero -->
  <section class="relative section-spacing bg-[#1e3030] overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0 bg-pattern"></div>
    </div>
    <HeroTwinkle />
    <!-- Two ripple drops — partnership/duo -->
    <div class="absolute bottom-0 right-0 pointer-events-none select-none overflow-hidden w-[480px] h-[380px]">
      <svg viewBox="0 0 480 380" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full opacity-40" aria-hidden="true">
        <circle cx="160" cy="280" r="55" stroke="white" stroke-width="3" fill="none"/>
        <circle cx="160" cy="280" r="110" stroke="white" stroke-width="2" fill="none" opacity="0.6"/>
        <circle cx="160" cy="280" r="165" stroke="white" stroke-width="1.5" fill="none" opacity="0.3"/>
        <circle cx="160" cy="280" r="4" fill="white"/>
        <circle cx="330" cy="320" r="45" stroke="white" stroke-width="3" fill="none"/>
        <circle cx="330" cy="320" r="95" stroke="white" stroke-width="2" fill="none" opacity="0.6"/>
        <circle cx="330" cy="320" r="145" stroke="white" stroke-width="1.5" fill="none" opacity="0.3"/>
        <circle cx="330" cy="320" r="4" fill="white"/>
      </svg>
    </div>
    <div class="container-wide relative z-10">
      <div class="max-w-3xl">
        <p class="font-heading text-white/50 font-medium tracking-wide mb-4 animate-slide-up opacity-0" style="animation-delay: 0.1s;">
          About Us
        </p>
        <h1 class="text-display-lg text-white mb-6 animate-slide-up opacity-0" style="animation-delay: 0.2s;">
          A studio built on <span class="text-mbl-dusk">partnership</span>
        </h1>
        <p class="text-xl text-white/70 leading-relaxed animate-slide-up opacity-0" style="animation-delay: 0.3s;">
          Lakeshore Studios is a husband-and-wife consulting studio. We bring together
          creative vision and technical expertise to help businesses transform how
          they look, think, and operate.
        </p>
      </div>
    </div>
  </section>

  <!-- Our Story — Timeline -->
  {timeline.length > 0 && (
    <section class="pt-20 md:pt-28 pb-20">
      <div class="container-wide">
        <div class="max-w-2xl mb-16">
          <p class="font-heading text-mbl-accent font-medium tracking-wide mb-4">Our Story</p>
          <h2 class="text-display">How we got here</h2>
        </div>

        <div class="overflow-x-auto pb-6" style="scrollbar-width: thin; scrollbar-color: #AFB9B8 transparent;">
          <div class="flex gap-0 min-w-max">
            {timeline.map((entry: any, i: number) => (
              <div class="flex flex-col items-start w-64 relative">
                <!-- Line + dot -->
                <div class="flex items-center w-full mb-6">
                  <div class="w-3.5 h-3.5 rounded-full bg-mbl-dusk ring-4 ring-white flex-shrink-0 z-10"></div>
                  <div class="flex-1 h-px bg-mbl-mist/60"></div>
                </div>
                <!-- Content -->
                <div class="pr-8">
                  <span class="inline-block font-mono text-sm text-mbl-accent font-medium mb-2">
                    {entry.year}
                  </span>
                  <h3 class="font-display text-lg mb-2">{entry.title}</h3>
                  <p class="text-mbl-stone text-sm leading-relaxed">{entry.description}</p>
                </div>
              </div>
            ))}
            <!-- End cap -->
            <div class="flex items-start pt-[5px]">
              <div class="w-3.5 h-3.5 rounded-full bg-mbl-mist/60 ring-4 ring-white flex-shrink-0"></div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Where We've Worked -->
  {allCompanies.length > 0 && (
    <section class="py-16 bg-mbl-cloud overflow-hidden">
      <div class="container-wide mb-10">
        <p class="font-heading text-mbl-accent font-medium tracking-wide mb-2">Where We've Worked</p>
        <h2 class="text-display">Companies we've called home</h2>
      </div>

      <div class="relative">
        <!-- Fade edges -->
        <div class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-mbl-cloud to-transparent z-10 pointer-events-none"></div>
        <div class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-mbl-cloud to-transparent z-10 pointer-events-none"></div>

        <div class="flex logo-scroll-track">
          <!-- Render twice for seamless loop -->
          {[...allCompanies, ...allCompanies].map((co, i) => (
            <div class="flex-shrink-0 flex items-center justify-center px-10 h-20">
              <img
                src={`${co.logoUrl}?w=240&auto=format`}
                alt={co.name}
                class="h-10 w-auto object-contain grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300"
                loading="lazy"
                decoding="async"
              />
            </div>
          ))}
        </div>
      </div>

      <style>
        .logo-scroll-track {
          animation: logo-scroll 30s linear infinite;
          width: max-content;
        }
        .logo-scroll-track:hover {
          animation-play-state: paused;
        }
        @keyframes logo-scroll {
          from { transform: translateX(0); }
          to { transform: translateX(-50%); }
        }
      </style>
    </section>
  )}

  <!-- Values -->
  <section class="pb-20">
    <div class="container-wide">
      <div class="max-w-2xl mb-16">
        <p class="font-heading text-mbl-accent font-medium tracking-wide mb-4">Our Values</p>
        <h2 class="text-display">What guides our work</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {values.map((value) => (
          <div class="p-8 rounded-lg border border-mbl-mist/50 hover:border-mbl-accent/30 transition-colors duration-300">
            <div class="w-10 h-10 bg-mbl-accent/10 rounded-lg flex items-center justify-center text-mbl-accent mb-5" set:html={value.icon} />
            <h3 class="font-display text-xl mb-3">{value.title}</h3>
            <p class="text-mbl-stone">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="section-spacing bg-white">
    <div class="container-wide">
      <div class="max-w-2xl mb-16">
        <p class="font-heading text-mbl-accent font-medium tracking-wide mb-4">The Team</p>
        <h2 class="text-display">Two perspectives, one vision</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {team.map((member: any) => (
          <a href={`/team/${member.slug?.current}`} class="group block">
            <article class="flex flex-col md:flex-row overflow-hidden rounded-xl border border-mbl-mist/40 bg-mbl-cloud hover:border-mbl-accent/30 hover:shadow-md transition-all duration-300">
              <!-- Photo -->
              <div class="md:w-56 flex-shrink-0">
                {member.image ? (
                  <img
                    src={member.image}
                    alt={member.name}
                    class="w-full h-48 md:h-full object-cover object-top"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="w-full h-48 md:h-full bg-gradient-to-br from-mbl-slate to-mbl-dusk flex items-center justify-center text-white/20">
                    <svg class="w-20 h-20" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                    </svg>
                  </div>
                )}
              </div>

              <!-- Content -->
              <div class="flex flex-col justify-between p-6 lg:p-8 flex-1">
                <div>
                  <span class="inline-block text-xs font-heading font-semibold tracking-widest text-mbl-accent uppercase mb-3">
                    {member.role}
                  </span>
                  <h3 class="font-display text-2xl mb-3 group-hover:text-mbl-accent transition-colors duration-300">
                    {member.name}
                  </h3>
                  <p class="text-mbl-stone text-sm leading-relaxed max-w-xl">
                    {member.bio}
                  </p>
                </div>
                <div class="mt-6">
                  <span class="inline-flex items-center gap-2 font-heading font-medium text-mbl-ink group-hover:text-mbl-accent transition-colors duration-200">
                    View profile
                    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </span>
                </div>
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-spacing bg-[#1e3030]">
    <div class="container-narrow text-center">
      <h2 class="text-display text-white mb-6">Let's work together</h2>
      <p class="text-lg text-white/70 mb-10 max-w-xl mx-auto">
        Whether you need design, data, or both—we'd love to hear about your project
        and explore how we can help.
      </p>
      <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 bg-mbl-dusk text-white font-heading font-medium rounded-md hover:bg-mbl-slate transition-colors duration-200">
        Get in Touch
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>