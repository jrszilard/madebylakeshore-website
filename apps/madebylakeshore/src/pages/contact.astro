---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroTwinkle from '../components/HeroTwinkle.astro';

const contactInfo = {
  email: 'hello@madebylakeshore.com',
  location: 'Based by the lake, working everywhere',
  response: 'We typically respond within 24 hours',
};
---

<BaseLayout 
  title="Contact" 
  description="Get in touch with Lakeshore Studios. Book a consultation or send us a message about your project."
>
  <!-- Hero -->
  <section class="relative section-spacing bg-[#1e3030] overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0 bg-pattern"></div>
    </div>
    <HeroTwinkle />
    <!-- Morse code — "LETS TALK" cascading diagonal -->
    <div class="absolute bottom-0 right-0 pointer-events-none select-none overflow-hidden w-[520px] h-[400px]">
      <svg viewBox="0 0 520 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full opacity-50" aria-hidden="true">
        <!-- Row 1: LETS — · − · ·  ·  −  · · · -->
        <circle cx="34"  cy="70" r="2" fill="white"/>
        <rect   x="46"  y="68" width="16" height="4" rx="2" fill="white"/>
        <circle cx="72"  cy="70" r="2" fill="white"/>
        <circle cx="84"  cy="70" r="2" fill="white"/>
        <circle cx="104" cy="70" r="2" fill="white"/>
        <rect   x="116" y="68" width="16" height="4" rx="2" fill="white"/>
        <circle cx="148" cy="70" r="2" fill="white"/>
        <circle cx="160" cy="70" r="2" fill="white"/>
        <circle cx="172" cy="70" r="2" fill="white"/>

        <!-- Row 2: TALK — −  · −  · − · ·  − · − -->
        <rect   x="120" y="138" width="16" height="4" rx="2" fill="white" opacity="0.8"/>
        <circle cx="146" cy="140" r="2" fill="white" opacity="0.8"/>
        <rect   x="154" y="138" width="16" height="4" rx="2" fill="white" opacity="0.8"/>
        <circle cx="180" cy="140" r="2" fill="white" opacity="0.8"/>
        <rect   x="188" y="138" width="16" height="4" rx="2" fill="white" opacity="0.8"/>
        <circle cx="216" cy="140" r="2" fill="white" opacity="0.8"/>
        <circle cx="228" cy="140" r="2" fill="white" opacity="0.8"/>
        <rect   x="238" y="138" width="16" height="4" rx="2" fill="white" opacity="0.8"/>
        <circle cx="264" cy="140" r="2" fill="white" opacity="0.8"/>
        <rect   x="272" y="138" width="16" height="4" rx="2" fill="white" opacity="0.8"/>

        <!-- Row 3: LETS again (repeat, fading) -->
        <circle cx="204" cy="210" r="2" fill="white" opacity="0.5"/>
        <rect   x="212" y="208" width="16" height="4" rx="2" fill="white" opacity="0.5"/>
        <circle cx="238" cy="210" r="2" fill="white" opacity="0.5"/>
        <circle cx="250" cy="210" r="2" fill="white" opacity="0.5"/>
        <circle cx="268" cy="210" r="2" fill="white" opacity="0.5"/>
        <rect   x="276" y="208" width="16" height="4" rx="2" fill="white" opacity="0.5"/>
        <circle cx="304" cy="210" r="2" fill="white" opacity="0.5"/>
        <circle cx="316" cy="210" r="2" fill="white" opacity="0.5"/>
        <circle cx="328" cy="210" r="2" fill="white" opacity="0.5"/>

        <!-- Row 4: TALK again (fading more) -->
        <rect   x="290" y="278" width="16" height="4" rx="2" fill="white" opacity="0.28"/>
        <circle cx="316" cy="280" r="2" fill="white" opacity="0.28"/>
        <rect   x="324" y="278" width="16" height="4" rx="2" fill="white" opacity="0.28"/>
        <circle cx="350" cy="280" r="2" fill="white" opacity="0.28"/>
        <rect   x="358" y="278" width="16" height="4" rx="2" fill="white" opacity="0.28"/>
        <circle cx="384" cy="280" r="2" fill="white" opacity="0.28"/>
        <circle cx="396" cy="280" r="2" fill="white" opacity="0.28"/>
        <rect   x="406" y="278" width="16" height="4" rx="2" fill="white" opacity="0.28"/>

        <!-- Row 5: partial LETS (barely visible) -->
        <circle cx="374" cy="346" r="2" fill="white" opacity="0.12"/>
        <rect   x="382" y="344" width="16" height="4" rx="2" fill="white" opacity="0.12"/>
        <circle cx="408" cy="346" r="2" fill="white" opacity="0.12"/>
        <circle cx="420" cy="346" r="2" fill="white" opacity="0.12"/>
        <circle cx="438" cy="346" r="2" fill="white" opacity="0.12"/>
        <rect   x="446" y="344" width="16" height="4" rx="2" fill="white" opacity="0.12"/>
      </svg>
    </div>
    <div class="container-wide relative z-10">
      <div class="max-w-3xl">
        <p class="font-heading text-white/50 font-medium tracking-wide mb-4 animate-slide-up opacity-0" style="animation-delay: 0.1s;">
          Contact Us
        </p>
        <h1 class="text-display-lg text-white mb-6 animate-slide-up opacity-0" style="animation-delay: 0.2s;">
          Let's start a <span class="text-mbl-dusk">conversation</span>
        </h1>
        <p class="text-xl text-white/70 leading-relaxed animate-slide-up opacity-0" style="animation-delay: 0.3s;">
          Have a project in mind? Send us a message and we'll get back to you.
          We're here to help you figure out the best path forward.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Options -->
  <section class="pt-20 md:pt-28 pb-20">
    <div class="container-wide">
      <div class="grid lg:grid-cols-2 gap-16">
        <!-- Contact Form -->
        <div>
          <h2 class="text-display mb-8">Send a Message</h2>

          <form class="space-y-6" action="https://formspree.io/f/mkooadkb" method="POST" id="contact-form">
            <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-sm font-heading font-medium text-mbl-ink mb-2">
                  Name
                </label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required
                  class="w-full px-4 py-3 border border-mbl-mist rounded-md bg-white focus:outline-none focus:border-mbl-accent transition-colors"
                  placeholder="Your name"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-heading font-medium text-mbl-ink mb-2">
                  Email
                </label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required
                  class="w-full px-4 py-3 border border-mbl-mist rounded-md bg-white focus:outline-none focus:border-mbl-accent transition-colors"
                  placeholder="you@company.com"
                />
              </div>
            </div>
            
            <div>
              <label for="service" class="block text-sm font-heading font-medium text-mbl-ink mb-2">
                What can we help with?
              </label>
              <select
                id="service"
                name="service"
                class="w-full px-4 py-3 border border-mbl-mist rounded-md bg-white focus:outline-none focus:border-mbl-accent transition-colors"
              >
                <option value="" disabled selected>Select a service...</option>
                <option value="design">Creative Services</option>
                <option value="data">Data & Analytics</option>
                <option value="ai">AI Solutions</option>
                <option value="multiple">Multiple Services</option>
                <option value="other">Something Else</option>
              </select>
            </div>
            
            <div>
              <label for="message" class="block text-sm font-heading font-medium text-mbl-ink mb-2">
                Tell us about your project
              </label>
              <textarea 
                id="message" 
                name="message" 
                rows="5"
                required
                class="w-full px-4 py-3 border border-mbl-mist rounded-md bg-white focus:outline-none focus:border-mbl-accent transition-colors resize-none"
                placeholder="What are you working on? What challenges are you facing?"
              ></textarea>
            </div>
            
            <div>
              <label for="budget" class="block text-sm font-heading font-medium text-mbl-ink mb-2">
                Budget Range (Optional)
              </label>
              <select
                id="budget"
                name="budget"
                class="w-full px-4 py-3 border border-mbl-mist rounded-md bg-white focus:outline-none focus:border-mbl-accent transition-colors"
              >
                <option value="" disabled selected>Select a range...</option>
                <option value="under-5k">Under $5,000</option>
                <option value="5k-10k">$5,000 - $10,000</option>
                <option value="10k-25k">$10,000 - $25,000</option>
                <option value="25k-50k">$25,000 - $50,000</option>
                <option value="50k+">$50,000+</option>
              </select>
            </div>
            
            <button type="submit" class="btn-primary w-full justify-center">
              Send Message
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </form>
          
          <p class="text-sm text-mbl-stone mt-4">{contactInfo.response}</p>
        </div>
        
        <!-- Contact Info -->
        <div>
          <div class="bg-mbl-cloud rounded-lg p-8">
            <h3 class="font-display text-xl mb-6">Quick Info</h3>

            <div class="space-y-4">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-mbl-accent/10 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-mbl-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <p class="text-sm text-mbl-stone">Email</p>
                  <a href={`mailto:${contactInfo.email}`} class="font-heading font-medium text-mbl-ink hover:text-mbl-accent transition-colors">
                    {contactInfo.email}
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-mbl-accent/10 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-mbl-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <p class="text-sm text-mbl-stone">Location</p>
                  <p class="font-heading font-medium text-mbl-ink">{contactInfo.location}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-spacing bg-white">
    <div class="container-wide">
      <div class="max-w-2xl mb-16">
        <p class="font-heading text-mbl-accent font-medium tracking-wide mb-4">FAQ</p>
        <h2 class="text-display">Common questions</h2>
      </div>
      
      <div class="grid md:grid-cols-2 gap-8 max-w-4xl">
        <div>
          <h3 class="font-heading font-semibold text-mbl-ink mb-2">How much do your services cost?</h3>
          <p class="text-mbl-stone">
            Every project is different. We'll discuss scope and budget with you
            and provide a clear proposal before any work begins.
          </p>
        </div>
        <div>
          <h3 class="font-heading font-semibold text-mbl-ink mb-2">How long does a typical project take?</h3>
          <p class="text-mbl-stone">
            It depends on scope. A dashboard might take 2-4 weeks, while a full brand 
            identity could be 6-8 weeks. We'll give you a timeline upfront.
          </p>
        </div>
        <div>
          <h3 class="font-heading font-semibold text-mbl-ink mb-2">Do you work with clients remotely?</h3>
          <p class="text-mbl-stone">
            Absolutely. Most of our clients are remote. We use video calls, shared 
            documents, and async communication to stay aligned.
          </p>
        </div>
        <div>
          <h3 class="font-heading font-semibold text-mbl-ink mb-2">What if I need both design and data help?</h3>
          <p class="text-mbl-stone">
            That's our sweet spot. Many clients work with both of us on integrated 
            projects. We'll coordinate everything seamlessly.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>