---
interface Props {
  title: string;
  description?: string;
  icon?: 'painting' | 'printmaking' | 'drawing' | 'writing' | 'photography' | 'other';
}

const { title, description, icon = 'other' } = Astro.props;

const icons: Record<string, string> = {
  painting: `
    <line x1="12" y1="3" x2="12" y2="13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    <path d="M9 13 L15 13 L13.5 19 L10.5 19 Z" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/>
    <circle cx="12" cy="21" r="1" fill="currentColor"/>
  `,
  printmaking: `
    <rect x="4" y="9" width="16" height="6" rx="1" stroke="currentColor" stroke-width="1.2"/>
    <line x1="4" y1="6" x2="20" y2="6" stroke="currentColor" stroke-width="1" opacity="0.5"/>
    <line x1="6" y1="18" x2="18" y2="18" stroke="currentColor" stroke-width="1" opacity="0.5"/>
    <line x1="8" y1="11" x2="8" y2="13" stroke="currentColor" stroke-width="0.8"/>
    <line x1="12" y1="11" x2="12" y2="13" stroke="currentColor" stroke-width="0.8"/>
    <line x1="16" y1="11" x2="16" y2="13" stroke="currentColor" stroke-width="0.8"/>
  `,
  drawing: `
    <path d="M4 20 L4 16 L15 5 L19 9 L8 20 Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
    <line x1="13" y1="7" x2="17" y2="11" stroke="currentColor" stroke-width="0.9"/>
    <circle cx="4.8" cy="19.2" r="0.6" fill="currentColor"/>
  `,
  writing: `
    <path d="M19 5 C13 5 6 11 4 20 C9 18 16 14 19 5 Z" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/>
    <line x1="6" y1="18" x2="9" y2="15" stroke="currentColor" stroke-width="0.9"/>
  `,
  photography: `
    <rect x="3" y="7" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.1"/>
    <path d="M8 7 L10 4 L14 4 L16 7" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/>
    <circle cx="12" cy="13.5" r="3.5" stroke="currentColor" stroke-width="1"/>
  `,
  other: `
    <path d="M12 2 C7 2 3 6 3 11 C3 14 5 16.5 8 17 C8 18.5 9.5 19 10.5 18 C11.5 17 13 17.5 13.5 19 C16.5 18 21 14.5 21 11 C21 6 17 2 12 2 Z" stroke="currentColor" stroke-width="1"/>
    <circle cx="8" cy="8" r="1" fill="currentColor"/>
    <circle cx="12" cy="6.5" r="1" fill="currentColor"/>
    <circle cx="16" cy="9" r="1" fill="currentColor"/>
  `,
};
---

<div class="bg-daos-paper rounded-sm border border-daos-warm p-8 flex flex-col h-full">
  <div class="w-10 h-10 flex items-center justify-start mb-4">
    <svg class="w-9 h-9 text-daos-terracotta-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={icons[icon] ?? icons.other} />
  </div>

  <h2 class="font-display italic text-xl text-daos-ink leading-tight mb-3">
    {title}
  </h2>

  {description && (
    <p class="font-body text-daos-charcoal leading-relaxed">
      {description}
    </p>
  )}
</div>
