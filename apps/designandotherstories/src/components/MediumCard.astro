---
interface Props {
  title: string;
  description?: string;
  icon?: 'painting' | 'printmaking' | 'drawing' | 'writing' | 'photography' | 'other';
}

const { title, description, icon = 'other' } = Astro.props;

const iconFiles: Record<string, string> = {
  painting:     '/icons/08-painting.svg',
  printmaking:  '/icons/09-linocut.svg',
  drawing:      '/icons/07-drawing.svg',
  writing:      '/icons/06-writing.svg',
  photography:  '/icons/10-search.svg',
  other:        '/icons/12-studio.svg',
};

const iconSrc = iconFiles[icon] ?? iconFiles.other;
---

<div class="bg-daos-paper rounded-sm border border-daos-warm p-8 flex flex-col h-full">
  <div class="flex items-center justify-start mb-6">
    <img src={iconSrc} alt="" aria-hidden="true" class="w-24 h-24" />
  </div>

  <h2 class="font-display italic text-xl text-daos-ink leading-tight mb-3">
    {title}
  </h2>

  {description && (
    <p class="font-body text-daos-charcoal leading-relaxed">
      {description}
    </p>
  )}
</div>
