---
import GalleryCard from './GalleryCard.astro';

interface Props {
  artwork: any[];
  showFilters?: boolean;
}

const { artwork, showFilters = true } = Astro.props;
---

{showFilters && (
  <div class="flex justify-end mb-8">
    <a
      href="/gallery"
      class="font-sans text-sm text-daos-terracotta hover:underline transition-colors"
    >
      Browse by Collection &rarr;
    </a>
  </div>
)}

<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4" id="gallery-grid">
  {artwork.map((piece: any) => (
    <GalleryCard
      title={piece.title}
      slug={piece.slug}
      images={piece.images ?? []}
      medium={piece.medium}
      collectionTitle={piece.collection?.title}
      collectionSlug={piece.collection?.slug}
    />
  ))}
</div>

{artwork.length === 0 && (
  <p class="font-body text-daos-charcoal text-center py-16">No artwork found.</p>
)}
