---
import { SUBSTACK_URL } from '../lib/config';
import CartButton from './cart/CartButton.tsx';

interface Props {
  theme?: 'dark' | 'light';
}
const { theme = 'dark' } = Astro.props;
const isLight = theme === 'light';

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/gallery', label: 'Gallery' },
  { href: '/shop', label: 'Shop' },
  { href: '/events', label: 'Events' },
  { href: SUBSTACK_URL, label: 'The Blog', external: true },
  { href: '/about', label: 'About' },
];
---

<header class:list={["sticky top-0 z-50 backdrop-blur-sm border-b", isLight ? "bg-[#3B45E0]/95 border-white/15" : "bg-daos-thread/95 border-daos-ink/15"]}>
  <nav class="container-art">
    <div class="flex items-center h-20">
      <!-- Logo -->
      <a href="/" class="group">
        <span class:list={["font-display text-xl md:text-2xl", isLight ? "text-daos-cream" : "text-daos-ink"]} style="font-weight: 500; letter-spacing: -0.02em; font-variation-settings: 'opsz' 96;">
          Design <em class="not-italic" style="font-style: italic; color: #EE4322; font-variation-settings: 'opsz' 96, 'SOFT' 100;">&</em> Other Stories
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-8 ml-12">
        {navLinks.map((link) => (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class:list={[
              "font-sans text-[11px] tracking-[0.18em] uppercase transition-colors duration-200",
              isLight
                ? (!link.external && (currentPath === link.href || currentPath.startsWith(link.href + '/'))
                    ? "text-daos-marigold"
                    : "text-daos-cream/70 hover:text-daos-cream")
                : (!link.external && (currentPath === link.href || currentPath.startsWith(link.href + '/'))
                    ? "text-daos-terracotta-dark"
                    : "text-daos-charcoal hover:text-daos-ink")
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Cart Button and Mobile Menu Toggle -->
      <div class="flex items-center gap-4 ml-auto">
        <CartButton client:idle theme={theme} />

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          class:list={["lg:hidden p-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-daos-terracotta rounded-sm", isLight ? "text-daos-cream" : "text-daos-ink"]}
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class:list={["lg:hidden hidden border-t", isLight ? "bg-[#3B45E0] border-white/15" : "bg-daos-thread border-daos-ink/15"]}>
    <div class="container-art py-6 space-y-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
          class:list={[
            "block py-2 font-sans text-[11px] tracking-[0.18em] uppercase transition-colors",
            isLight
              ? (!link.external && (currentPath === link.href || currentPath.startsWith(link.href + '/'))
                  ? "text-daos-marigold"
                  : "text-daos-cream/70 hover:text-daos-cream")
              : (!link.external && (currentPath === link.href || currentPath.startsWith(link.href + '/'))
                  ? "text-daos-terracotta-dark"
                  : "text-daos-charcoal hover:text-daos-ink")
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu');

  function toggleMenu(open?: boolean) {
    if (!btn || !menu) return;
    const isOpen = open ?? menu.classList.contains('hidden');
    menu.classList.toggle('hidden', !isOpen);
    btn.setAttribute('aria-expanded', String(isOpen));
  }

  btn?.addEventListener('click', () => toggleMenu());

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.classList.contains('hidden')) {
      toggleMenu(false);
      btn?.focus();
    }
  });
</script>
