---
import { urlFor } from '../lib/sanity';
import { SUBSTACK_URL } from '../lib/config';

interface ShopItem {
  _id: string;
  title: string;
  slug: { current: string };
  images: any[];
  medium?: string;
  price?: number;
  originalAvailable?: boolean;
  printsAvailable?: boolean;
}

interface Props {
  label?: string;
  headline?: string;
  subtitle?: string;
  heroImage?: any;
  shopItems?: ShopItem[];
}

const {
  headline = 'I like making things.',
  subtitle = 'Original paintings, essays, and stories written by hand.',
  heroImage,
  shopItems = [],
} = Astro.props;

const heroImageUrl = heroImage
  ? urlFor(heroImage).width(1600).height(900).fit('crop').crop('focalpoint').url()
  : null;

const featuredItems = shopItems.slice(0, 2).map(item => ({
  ...item,
  imageUrl: item.images?.length
    ? urlFor(item.images[0]).width(480).height(640).fit('crop').crop('focalpoint').url()
    : null,
}));

const hasFeaturedItems = featuredItems.length > 0;
---

{hasFeaturedItems ? (
  <section class="bg-daos-paper flex items-center">
    <div class="container-art w-full py-20 md:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

        <!-- Left: brand content -->
        <div class="space-y-8 opacity-0 animate-slide-up" style="animation-delay: 0.2s;">
          <div class="space-y-5">
            <h1 class="font-display italic text-display-lg md:text-display-xl text-daos-ink leading-tight">
              {headline}
            </h1>
            <p class="font-body text-lg text-daos-charcoal leading-relaxed max-w-md">
              {subtitle}
            </p>
          </div>
          <div class="flex flex-wrap gap-4">
            <a href="/gallery" class="btn-warm">See the work</a>
            <a href={SUBSTACK_URL} target="_blank" rel="noopener noreferrer" class="btn-outline">Stay in the loop</a>
          </div>
        </div>

        <!-- Right: featured items for sale (JS picks 2 randomly) -->
        <div class="hidden lg:flex items-start justify-center gap-5" id="hero-items">
          {featuredItems.map((item, i) => (
            <a
              href={`/gallery/${item.slug.current}`}
              class="group block flex-1 opacity-0 animate-slide-up"
              style={`animation-delay: ${0.4 + i * 0.15}s; margin-top: ${i === 1 ? '3.5rem' : '0'};`}
            >
              <div class="relative aspect-[3/4] overflow-hidden bg-daos-warm rounded-sm shadow-md group-hover:shadow-xl transition-shadow duration-300">
                {item.imageUrl ? (
                  <img
                    src={item.imageUrl}
                    alt={item.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                ) : (
                  <div class="absolute inset-0 bg-gradient-to-br from-daos-warm to-daos-clay" />
                )}
                {item.originalAvailable !== false && item.price != null && (
                  <div class="absolute bottom-3 left-3">
                    <span class="px-3 py-1 bg-daos-cream/90 text-daos-ink font-sans text-sm font-medium">
                      ${item.price.toLocaleString()}
                    </span>
                  </div>
                )}
                {item.originalAvailable === false && (
                  <div class="absolute top-3 left-3">
                    <span class="px-3 py-1 bg-daos-ink text-daos-cream font-sans text-xs uppercase tracking-wider">
                      Sold
                    </span>
                  </div>
                )}
              </div>
              <div class="mt-3 space-y-0.5">
                <p class="font-display text-base text-daos-ink group-hover:text-daos-terracotta transition-colors leading-snug">
                  {item.title}
                </p>
                {item.medium && (
                  <p class="font-sans text-sm text-daos-charcoal">{item.medium}</p>
                )}
              </div>
            </a>
          ))}
        </div>


      </div>
    </div>
  </section>

) : heroImageUrl ? (
  <section id="hero" class="relative h-screen flex items-center justify-center overflow-hidden">
    <img
      id="hero-bg"
      src={heroImageUrl}
      alt={heroImage?.alt ?? headline}
      class="absolute inset-0 w-full h-[120%] object-cover object-center will-change-transform"
      style="top: -10%;"
    />
    <div class="absolute inset-0 bg-daos-ink/40"></div>
    <div class="relative z-10 max-w-3xl mx-auto text-center px-6 space-y-6">
      <h1
        class="font-display italic text-display-lg md:text-display-xl text-white leading-tight opacity-0 animate-slide-up"
        style="animation-delay: 0.3s;"
      >
        {headline}
      </h1>
      <p
        class="font-body text-lg text-white/80 leading-relaxed max-w-xl mx-auto opacity-0 animate-slide-up"
        style="animation-delay: 0.5s;"
      >
        {subtitle}
      </p>
      <div
        class="flex flex-wrap gap-4 justify-center opacity-0 animate-slide-up"
        style="animation-delay: 0.7s;"
      >
        <a href="/gallery" class="btn-warm">See the work</a>
        <a href={SUBSTACK_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 border border-white/70 text-white font-sans font-medium rounded-sm hover:bg-white/10 transition-colors duration-200">Stay in the loop</a>
      </div>
    </div>
  </section>

  <script>
    const heroBg = document.getElementById('hero-bg');
    if (heroBg && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      window.addEventListener('scroll', () => {
        heroBg.style.transform = `translateY(${window.scrollY * 0.3}px)`;
      }, { passive: true });
    }
  </script>

) : (
  <section class="py-20 md:py-28">
    <div class="container-art">
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <h1 class="font-display italic text-display-lg md:text-display-xl text-daos-ink leading-tight">
          {headline}
        </h1>
        <p class="font-body text-lg text-daos-charcoal leading-relaxed max-w-xl mx-auto">
          {subtitle}
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="/gallery" class="btn-warm">See the work</a>
          <a href={SUBSTACK_URL} target="_blank" rel="noopener noreferrer" class="btn-outline">Stay in the loop</a>
        </div>
      </div>
    </div>
  </section>
)}
