---
import { sanityClient } from '../lib/sanity';

const banner = await sanityClient.fetch<{
  active: boolean;
  title?: string;
  body?: string;
  cta1?: { label?: string; url?: string };
  cta2?: { label?: string; url?: string };
} | null>(`*[_type == "banner" && _id == "banner" && active == true][0]`);
---

{banner && (
  <div class="bg-daos-sage text-daos-cream">
    <div class="container-art py-3 flex flex-col sm:flex-row items-center justify-center gap-3 text-center sm:text-left">
      <div class="space-y-0.5">
        {banner.title && (
          <p class="font-sans font-semibold text-sm">{banner.title}</p>
        )}
        {banner.body && (
          <p class="font-body text-sm text-daos-cream/90">{banner.body}</p>
        )}
      </div>
      {(banner.cta1?.label && banner.cta1?.url) || (banner.cta2?.label && banner.cta2?.url) ? (
        <div class="flex items-center gap-3 shrink-0">
          {banner.cta1?.label && banner.cta1?.url && (
            <a
              href={banner.cta1.url}
              class="px-4 py-1.5 bg-daos-cream text-daos-sage font-sans font-medium text-sm rounded-sm hover:bg-white transition-colors"
            >
              {banner.cta1.label}
            </a>
          )}
          {banner.cta2?.label && banner.cta2?.url && (
            <a
              href={banner.cta2.url}
              class="font-sans text-sm text-daos-cream/90 underline underline-offset-2 hover:text-white transition-colors"
            >
              {banner.cta2.label}
            </a>
          )}
        </div>
      ) : null}
    </div>
  </div>
)}
