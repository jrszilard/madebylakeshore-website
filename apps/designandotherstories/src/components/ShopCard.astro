---
import { urlFor } from '../lib/sanity';

interface Props {
  title: string;
  slug: { current: string };
  images: any[];
  medium?: string;
  categoryLabel?: string;
  price?: number;
  originalAvailable?: boolean;
  printsAvailable?: boolean;
  basePath?: string;
}

const { title, slug, images, medium, categoryLabel, price, originalAvailable, printsAvailable, basePath = '/gallery' } = Astro.props;

const imageUrl =
  images && images.length > 0
    ? urlFor(images[0]).width(600).height(338).fit('crop').crop('focalpoint').url()
    : null;

// originalAvailable comes back as null (not undefined) from Sanity when unset,
// which skips the destructuring default — use ?? to treat null/undefined as available.
const resolvedOriginalAvailable = originalAvailable ?? true;
const resolvedPrintsAvailable = printsAvailable ?? false;
const isSold = !resolvedOriginalAvailable;
const hasPrints = isSold && resolvedPrintsAvailable;
const isDimmed = isSold && !resolvedPrintsAvailable;
---

<article class:list={['group border border-[#3B45E0] bg-daos-thread rounded-sm overflow-hidden hover:shadow-lg transition-shadow duration-300', isDimmed && 'opacity-60']}>
  <a href={`${basePath}/${slug.current}`} class="block">
    <!-- Uniform 16:9 image container -->
    <div class="relative overflow-hidden bg-daos-warm aspect-[16/9]">
      {imageUrl ? (
        <img
          src={imageUrl}
          alt={title}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
      ) : (
        <div class="absolute inset-0 bg-gradient-to-br from-daos-warm to-daos-clay flex items-center justify-center">
          <span class="font-display text-daos-ink/30 text-lg text-center px-4">{title}</span>
        </div>
      )}

      {/* Sold badge */}
      {isSold && (
        <div class="absolute top-3 left-3">
          <span class="px-3 py-1 bg-daos-ink text-daos-cream text-xs font-sans uppercase tracking-wider">
            Sold
          </span>
        </div>
      )}
    </div>
  </a>

  <!-- Card body -->
  <div class="p-4 space-y-3">
    <div class="space-y-1">
      {categoryLabel && (
        <p class="font-sans text-xs uppercase tracking-widest text-daos-charcoal">{categoryLabel}</p>
      )}
      <h3 class="font-serif text-xl text-daos-ink leading-snug">
        <a href={`${basePath}/${slug.current}`} class="hover:text-daos-terracotta transition-colors">
          {title}
        </a>
      </h3>
      {medium && (
        <p class="font-sans text-sm text-daos-charcoal">{medium}</p>
      )}
    </div>

    {/* Price + CTA area */}
    {!isSold && price != null && (
      <div class="space-y-2">
        <p class="font-sans font-medium text-daos-ink">${price.toLocaleString()}</p>
      </div>
    )}

    {hasPrints && (
      <a
        href={`${basePath}/${slug.current}#prints`}
        class="inline-block font-sans text-sm text-daos-terracotta hover:underline transition-colors"
      >
        Prints available &rarr;
      </a>
    )}

    {isSold && !hasPrints && (
      <p class="font-sans text-sm text-daos-charcoal">Sold</p>
    )}
  </div>
</article>
