---
import { urlFor } from '../lib/sanity';

interface Props {
  title: string;
  slug: { current: string };
  images: any[];
  medium?: string;
  forSale?: boolean;
  originalAvailable?: boolean;
  price?: number;
  collectionTitle?: string;
  collectionSlug?: { current: string };
}

const { title, slug, images, medium, forSale, originalAvailable, price } = Astro.props;

const imageUrl = images?.[0]
  ? urlFor(images[0]).width(700).url()
  : null;

const isAvailable = forSale && (originalAvailable ?? true);
---

<a
  href={`/gallery/${slug.current}`}
  class="group relative block overflow-hidden break-inside-avoid mb-1.5 bg-daos-warm"
>
  {imageUrl ? (
    <img
      src={imageUrl}
      alt={title}
      class="w-full block"
      loading="lazy"
    />
  ) : (
    <div class="aspect-[3/4] bg-gradient-to-br from-daos-warm to-daos-clay flex items-center justify-center">
      <span class="font-display text-daos-ink/30 text-lg text-center px-4">{title}</span>
    </div>
  )}

  <div class="absolute inset-0 bg-daos-ink/0 group-hover:bg-daos-ink/55 transition-colors duration-300" />

  <div class="absolute inset-0 flex flex-col justify-end p-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
    <h3 class="font-display italic text-daos-cream text-lg leading-snug">{title}</h3>
    {medium && (
      <p class="font-sans text-xs text-daos-cream/70 uppercase tracking-widest mt-1">{medium}</p>
    )}
    {isAvailable && price != null && (
      <p class="font-sans text-sm text-daos-cream/90 mt-2">${price.toLocaleString()}</p>
    )}
    {forSale && !isAvailable && (
      <p class="font-sans text-xs text-daos-cream/50 uppercase tracking-widest mt-1">Sold</p>
    )}
  </div>
</a>
