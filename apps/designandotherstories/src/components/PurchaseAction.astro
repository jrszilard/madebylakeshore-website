---
import CheckoutButton from './CheckoutButton.astro';

interface Props {
  title: string;
  slug: string;
  price?: number;
  originalAvailable?: boolean;
  printsAvailable?: boolean;
  image?: string;
  basePath?: string;
}

const { title, slug, price, originalAvailable = true, printsAvailable = false, image, basePath = '/gallery' } = Astro.props;

const isSold = !originalAvailable;
const hasAlternative = isSold && printsAvailable;
---

<div class="space-y-4">
  {/* Price */}
  {price != null && (
    <p class="font-sans text-xl font-medium text-daos-ink">
      {isSold ? (
        <span class="line-through text-daos-charcoal">${price.toLocaleString()}</span>
      ) : (
        <span>${price.toLocaleString()}</span>
      )}
    </p>
  )}

  {/* Availability label */}
  {isSold ? (
    <p class="font-sans text-sm text-daos-charcoal uppercase tracking-wide">Sold</p>
  ) : (
    <p class="font-sans text-sm text-daos-sage uppercase tracking-wide">Available</p>
  )}

  {/* Purchase button — only show if original is available */}
  {!isSold && price != null && (
    <CheckoutButton title={title} price={price} slug={slug} image={image} basePath={basePath} />
  )}

  {/* Prints available notice */}
  {hasAlternative && (
    <p class="font-body text-sm text-daos-charcoal italic">
      Original sold — prints still available.{' '}
      <a href={`${basePath}/${slug}#prints`} class="text-daos-terracotta underline underline-offset-2 hover:text-daos-ink transition-colors">
        View print options
      </a>
    </p>
  )}
</div>
