---
interface Location {
  venueName?: string;
  city: string;
  state?: string;
}

interface Props {
  title: string;
  slug: { current: string };
  startDate: string;
  endDate?: string;
  location: Location;
  eventType?: string;
  isPast?: boolean;
}

const { title, slug, startDate, endDate, location, eventType, isPast = false } = Astro.props;

const start = new Date(startDate);
const dayNumber = start.getUTCDate();
const monthAbbr = start.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' });
const year = start.getUTCFullYear();

function formatDateRange(start: Date, endStr?: string): string {
  const startFormatted = start.toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
  if (!endStr) return startFormatted;
  const end = new Date(endStr);
  const endFormatted = end.toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
  return `${startFormatted} – ${endFormatted}`;
}

const dateDisplay = formatDateRange(start, endDate);

const locationDisplay = [location.venueName, location.city, location.state]
  .filter(Boolean)
  .join(', ');

const eventTypeLabel = eventType
  ? eventType.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())
  : null;
---

<a
  href={`/events/${slug.current}`}
  class:list={[
    'group flex items-stretch gap-0 border transition-all duration-300',
    isPast
      ? 'border-[#3B45E0]/40 bg-daos-thread opacity-60 hover:opacity-80'
      : 'border-[#3B45E0] bg-daos-thread hover:shadow-lg',
  ]}
>
  <!-- Date block -->
  <div
    class:list={[
      'flex-shrink-0 flex flex-col items-center justify-center w-28 py-8 px-4 text-center',
      isPast ? 'text-daos-clay' : 'text-daos-terracotta',
    ]}
  >
    <span class="font-display text-5xl leading-none font-bold">{dayNumber}</span>
    <span class="font-sans text-xs uppercase tracking-widest mt-2">{monthAbbr}</span>
    <span class="font-sans text-xs text-daos-charcoal mt-0.5">{year}</span>
  </div>

  <!-- Vertical separator -->
  <div class="w-px bg-daos-warm self-stretch my-6"></div>

  <!-- Content -->
  <div class="flex-1 py-8 px-8 flex flex-col justify-center gap-2 min-w-0">
    {eventTypeLabel && (
      <p class="font-sans text-xs uppercase tracking-widest text-daos-charcoal">{eventTypeLabel}</p>
    )}
    <h3
      class:list={[
        'font-serif text-2xl md:text-3xl leading-tight',
        isPast
          ? 'text-daos-charcoal'
          : 'text-daos-ink group-hover:text-daos-terracotta transition-colors',
      ]}
    >
      {title}
    </h3>
    {locationDisplay && (
      <p class="font-sans text-sm text-daos-charcoal">{locationDisplay}</p>
    )}
    {dateDisplay && (
      <p class="font-sans text-sm text-daos-charcoal">{dateDisplay}</p>
    )}
  </div>

  <!-- Arrow -->
  <div class="flex-shrink-0 flex items-center pr-8 text-daos-charcoal group-hover:text-daos-terracotta transition-colors">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
      <path d="M4 10h12M10 4l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
</a>
