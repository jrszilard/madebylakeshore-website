---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCard from '../../components/BookCard.astro';
import SubstackFeed from '../../components/SubstackFeed.astro';
import ShortStoriesCarousel from '../../components/ShortStoriesCarousel';
import { sanityClient, queries } from '../../lib/sanity';
import { fetchSubstackSection } from '../../lib/substack';
import { SUBSTACK_SHORT_STORIES_SECTION_ID } from '../../lib/config';

const [allBooks, shortStories] = await Promise.all([
  sanityClient.fetch(queries.allBooks),
  fetchSubstackSection(SUBSTACK_SHORT_STORIES_SECTION_ID),
]);
---

<BaseLayout
  title="Writing"
  description="Novels, short stories, and essays from Design & Other Stories. Literary fiction and nonfiction made with care."
>
  <!-- Page Header -->
  <section class="py-20 md:py-28">
    <div class="container-art">
      <div class="max-w-2xl">
        <p class="font-sans text-xs uppercase tracking-widest text-daos-terracotta mb-4">Writing</p>
        <h1 class="font-display italic text-display-lg md:text-display-xl text-daos-cream mb-6 leading-tight">
          Words on paper
        </h1>
        <p class="font-body text-daos-cream/70 text-lg leading-relaxed">
          Fiction, essays, and dispatches from the studio — on the things that stay with you.
        </p>
      </div>
    </div>
  </section>

  <!-- Books Grid -->
  {allBooks && allBooks.length > 0 && (
    <section class="py-20 md:py-28 bg-daos-paper">
      <div class="container-art">
        <p class="font-sans text-xs uppercase tracking-widest text-daos-clay mb-8">Books</p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {allBooks.map((book: any) => (
            <BookCard
              title={book.title}
              slug={book.slug}
              coverImage={book.coverImage}
              blurb={book.blurb}
              type={book.type}
              status={book.status}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Short Stories Carousel -->
  <section class="py-20 md:py-28">
    <div class="container-art">
      <p class="font-sans text-xs uppercase tracking-widest text-daos-cream/50 mb-8">Short Stories</p>
      <ShortStoriesCarousel posts={shortStories} client:load />
    </div>
  </section>

  <!-- Substack Feed -->
  <section class="py-20 md:py-28">
    <div class="container-art">
      <div class="max-w-2xl mx-auto">
        <SubstackFeed limit={5} excludeSectionId={SUBSTACK_SHORT_STORIES_SECTION_ID} />
      </div>
    </div>
  </section>
</BaseLayout>
