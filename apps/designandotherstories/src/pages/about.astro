---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sanityClient, urlFor, queries } from '../lib/sanity';

const profile = await sanityClient.fetch(queries.artistProfile);

const portraitUrl = profile?.portrait?.asset
  ? urlFor(profile.portrait).width(600).height(750).fit('crop').crop('focalpoint').url()
  : null;

// BlockContent serializer
function blockContentToHtml(blocks: any[]): string {
  if (!Array.isArray(blocks)) return '';
  return blocks
    .map((block) => {
      if (block._type !== 'block') return '';
      const tag =
        block.style === 'h2' ? 'h2' :
        block.style === 'h3' ? 'h3' :
        block.style === 'h4' ? 'h4' :
        block.style === 'blockquote' ? 'blockquote' :
        'p';

      const text = (block.children ?? [])
        .map((span: any) => {
          let t = (span.text ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
          if (span.marks?.includes('strong')) t = `<strong>${t}</strong>`;
          if (span.marks?.includes('em')) t = `<em>${t}</em>`;
          return t;
        })
        .join('');

      return `<${tag}>${text}</${tag}>`;
    })
    .join('\n');
}

let bioHtml = '';
if (profile?.bio && Array.isArray(profile.bio)) {
  bioHtml = blockContentToHtml(profile.bio);
}
---

<BaseLayout
  title="About"
  description={profile?.shortBio || 'Meet the artist behind Design & Other Stories — paintings, drawings, and written works crafted with intention.'}
>
  <section class="section-spacing">
    <div class="container-art">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16 items-start">

        <!-- Left: Portrait -->
        <div class="aspect-[4/5] overflow-hidden rounded-sm shadow-md bg-daos-warm">
          {portraitUrl ? (
            <img
              src={portraitUrl}
              alt={profile?.name || 'Portrait of the artist'}
              class="w-full h-full object-cover"
            />
          ) : (
            <div class="w-full h-full bg-gradient-to-br from-daos-warm to-daos-clay flex items-center justify-center">
              <span class="font-display text-daos-ink/30 text-2xl text-center px-8">
                {profile?.name || 'Design & Other Stories'}
              </span>
            </div>
          )}
        </div>

        <!-- Right: Bio -->
        <div class="space-y-6">
          <div>
            <p class="font-sans text-xs uppercase tracking-widest text-daos-terracotta mb-4">About</p>
            <h1 class="font-display text-display md:text-display-lg text-daos-ink leading-tight">
              {profile?.name ? `About ${profile.name}` : 'About the Artist'}
            </h1>
          </div>

          {profile?.shortBio && (
            <p class="font-body text-daos-charcoal text-lg leading-relaxed italic border-l-2 border-daos-clay pl-4">
              {profile.shortBio}
            </p>
          )}

          {bioHtml ? (
            <div
              class="prose prose-stone font-body text-daos-charcoal leading-relaxed max-w-none"
              set:html={bioHtml}
            />
          ) : !profile && (
            <div class="prose prose-stone font-body text-daos-charcoal leading-relaxed">
              <p>
                Design & Other Stories is a creative practice exploring the intersections of art,
                design, and everyday life. Through paintings, drawings, and written works, each
                piece is crafted with intention and care.
              </p>
              <p>
                The work spans mediums and disciplines, united by a curiosity about the beauty
                found in ordinary moments and the stories objects carry with them.
              </p>
            </div>
          )}

          <!-- Social links -->
          {profile?.socialLinks && profile.socialLinks.length > 0 && (
            <div class="flex flex-wrap gap-3 pt-2">
              {profile.socialLinks.map((link: any) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-outline text-sm"
                >
                  {link.platform || link.label || 'Link'}
                </a>
              ))}
            </div>
          )}

          {profile?.substackUrl && (
            <div class="pt-2">
              <a
                href={profile.substackUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-outline text-sm"
              >
                Read on Substack
              </a>
            </div>
          )}
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
