---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediumCard from '../components/MediumCard.astro';
import { sanityClient, urlFor, queries } from '../lib/sanity';
import { SUBSTACK_URL } from '../lib/config';

const [profile, nextEvent] = await Promise.all([
  sanityClient.fetch(queries.artistProfile),
  sanityClient.fetch(queries.nextEvent),
]);

const aboutImages = (profile?.aboutImages ?? [])
  .slice(0, 4)
  .map((img: any, i: number) => {
    const w = img.asset?.metadata?.dimensions?.width ?? 1;
    const h = img.asset?.metadata?.dimensions?.height ?? 1;
    const isLandscape = w > h;
    return {
      url: isLandscape
        ? urlFor(img).width(900).height(600).fit('crop').crop('focalpoint').url()
        : urlFor(img).width(600).height(800).fit('crop').crop('focalpoint').url(),
      aspect: isLandscape ? 'aspect-[3/2]' : 'aspect-[3/4]',
      span: isLandscape ? 'col-span-2' : 'col-span-1',
      offset: ['0', '2rem', '1rem', '3rem'][i] ?? '0',
    };
  });
---

<BaseLayout
  title="About"
  description="Design & Other Stories is the work of W. H. Bonilla, painter, printmaker, and writer based in New Hampshire. Art you can put on your wall and fiction about the people who show up for each other."
>

  <!-- 1. Header: bio + mosaic -->
  <section class="py-20 md:py-28">
    <div class="container-art">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

        <!-- Left: headline + pull quote -->
        <div class="space-y-6">
          <p class="font-sans text-xs uppercase tracking-widest text-daos-terracotta">About</p>
          <h1 class="font-display italic text-display md:text-display-lg text-daos-cream leading-tight">
            {profile?.aboutHeadline ?? 'From New Hampshire and Puerto Rico to the world.'}
          </h1>
          {(profile?.aboutPullQuote ?? 'Making things you can hold in a world that keeps asking you to let go of everything physical.') && (
            <p class="font-body text-daos-cream/70 text-lg leading-relaxed italic border-l-2 border-white/30 pl-4">
              {profile?.aboutPullQuote ?? 'Making things you can hold in a world that keeps asking you to let go of everything physical.'}
            </p>
          )}
          {profile?.socialLinks && profile.socialLinks.length > 0 && (
            <div class="flex flex-wrap gap-3 pt-2">
              {profile.socialLinks.map((link: any) => (
                <a href={link.url} target="_blank" rel="noopener noreferrer" class="btn-outline-light text-sm">
                  {link.platform || link.label || 'Link'}
                </a>
              ))}
            </div>
          )}
        </div>

        <!-- Right: mosaic -->
        {aboutImages.length > 0 && (
          <div class="hidden lg:grid grid-cols-2 grid-rows-2 gap-3 h-[480px]">
            {aboutImages.map(({ url }: { url: string }, i: number) => (
              <div class="overflow-hidden rounded-sm">
                <img
                  src={url}
                  alt=""
                  class="w-full h-full object-contain"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              </div>
            ))}
          </div>
        )}

      </div>
    </div>
  </section>

  <!-- 2. Bio paragraphs -->
  {(() => {
    const fallback = `I'm Wilma — a designer, painter, and writer living in New Hampshire with my husband and our dog.\n\nI make two kinds of things: art you can put on your wall, and fiction about people who show up for each other. Ink, watercolor, graphite. Novels and short stories about connection, found family, and the weight of ordinary moments.\n\nBoth come from the same place — a belief that the things we bring into our lives should be made with care, by a person, on purpose.`;
    const paragraphs = (profile?.bio ?? fallback).split(/\n\n+/).filter(Boolean);
    return (
      <section class="pb-20">
        <div class="container-art">
          <div class="max-w-2xl space-y-4 font-body text-daos-cream/70 leading-relaxed">
            {paragraphs.map((p: string) => <p>{p}</p>)}
          </div>
        </div>
      </section>
    );
  })()}

  <!-- 3. Mediums -->
  {profile?.mediums?.length > 0 && (
    <section class="py-20 md:py-28">
      <div class="container-art">
        <p class="font-sans text-xs uppercase tracking-widest text-daos-terracotta mb-4">Mediums</p>
        <h2 class="font-display italic text-2xl md:text-3xl text-daos-cream leading-tight mb-10">What I Make</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {profile.mediums.map((medium: any) => (
            <MediumCard title={medium.title} description={medium.description} icon={medium.icon} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 4. Find me / connect -->
  <section class="py-20 md:py-28 bg-daos-paper">
    <div class="container-art">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-16">

        <!-- Next event -->
        <div class="space-y-4">
          <img src="/icons/03-events.svg" alt="" aria-hidden="true" class="w-12 h-12" />
          {nextEvent ? (
            <div class="space-y-2">
              <h2 class="font-display text-xl text-daos-ink">{nextEvent.title}</h2>
              {nextEvent.location?.city && (
                <p class="font-sans text-sm text-daos-charcoal">
                  {[nextEvent.location.venueName, nextEvent.location.city, nextEvent.location.state].filter(Boolean).join(', ')}
                </p>
              )}
              <p class="font-sans text-sm text-daos-charcoal">
                {new Date(nextEvent.startDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}
              </p>
            </div>
          ) : (
            <p class="font-body text-daos-charcoal leading-relaxed">
              No upcoming events right now. Check back soon, or subscribe to hear first.
            </p>
          )}
          <a href="/events" class="btn-warm inline-flex">
            All Events
          </a>
        </div>

        <!-- Newsletter -->
        <div class="space-y-4">
          <img src="/icons/05-newsletter.svg" alt="" aria-hidden="true" class="w-12 h-12" />
          <h2 class="font-display text-xl text-daos-ink">The Newsletter</h2>
          <p class="font-body text-daos-charcoal leading-relaxed">
            New work, upcoming events, and occasional dispatches from the studio. No noise.
          </p>
          <a
            href={`${SUBSTACK_URL}/subscribe`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-warm inline-flex"
          >
            Subscribe
          </a>
        </div>

        <!-- Lakeshore Studios -->
        <div class="space-y-4">
          <img src="/icons/12-studio.svg" alt="" aria-hidden="true" class="w-12 h-12" />
          <h2 class="font-display text-xl text-daos-ink">Lakeshore Studios</h2>
          <p class="font-body text-daos-charcoal leading-relaxed">
            A small design and data consultancy I run with my husband, Justin. Same care, different canvas.
          </p>
          <a
            href="https://madebylakeshore.com"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-warm inline-flex"
          >
            Visit Us
          </a>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>
