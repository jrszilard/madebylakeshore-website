---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShopCard from '../../components/ShopCard.astro';
import JsonLd from '../../components/JsonLd.astro';
import { sanityClient, queries } from '../../lib/sanity';
import { breadcrumbSchema } from '../../lib/structured-data';

const allArtwork = await sanityClient.fetch(queries.allArtwork);

const originals = (allArtwork ?? []).filter((p: any) => (p.artworkType ?? 'original') === 'original');
const photography = (allArtwork ?? []).filter((p: any) => p.artworkType === 'photography');
---

<BaseLayout
  title="Gallery"
  description="Browse and purchase original handmade paintings, drawings, and prints by W. H. Bonilla. Watercolor, ink, and graphite art made by hand in New Hampshire. Ships directly from the studio."
  showSnipcart={true}
>
  <Fragment slot="head">
    <JsonLd schema={[
      breadcrumbSchema([
        { name: 'Home', url: '/' },
        { name: 'Gallery', url: '/gallery' },
      ]),
      {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: 'Gallery — Design & Other Stories',
        description: 'Original handmade paintings, drawings, and prints by W. H. Bonilla. Watercolor, ink, and graphite art from New Hampshire.',
        url: 'https://designandotherstories.com/gallery',
        creator: { '@type': 'Person', name: 'W. H. Bonilla' },
      },
    ]} />
  </Fragment>
  <!-- Page header -->
  <section class="section-spacing">
    <div class="container-art">
      <div class="max-w-2xl">
        <p class="font-sans text-xs uppercase tracking-widest text-daos-terracotta mb-4">Gallery</p>
        <h1 class="font-display italic text-display-lg md:text-display-xl text-daos-ink mb-6 leading-tight">
          Take something home
        </h1>
        <p class="font-body text-daos-charcoal text-lg leading-relaxed">
          Original paintings, drawings, and prints. Shipped with care.
        </p>
      </div>
    </div>
  </section>

  <!-- Originals -->
  {originals.length > 0 && (
    <section class="section-spacing bg-daos-paper">
      <div class="container-art">
        <div class="mb-10 pb-6 border-b border-daos-warm">
          <h2 class="font-display italic text-2xl md:text-3xl text-daos-ink">Originals</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {originals.map((piece: any) => (
            <ShopCard
              title={piece.title}
              slug={piece.slug}
              images={piece.images ?? []}
              medium={piece.medium}
              price={piece.price}
              originalAvailable={piece.originalAvailable}
              printsAvailable={piece.printsAvailable}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Prints -->
  {photography.length > 0 && (
    <section class="section-spacing">
      <div class="container-art">
        <div class="mb-10 pb-6 border-b border-daos-warm">
          <h2 class="font-display italic text-2xl md:text-3xl text-daos-ink">Photography</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {photography.map((piece: any) => (
            <ShopCard
              title={piece.title}
              slug={piece.slug}
              images={piece.images ?? []}
              medium={piece.medium}
              price={piece.price}
              originalAvailable={piece.originalAvailable}
              printsAvailable={piece.printsAvailable}
              landscape={true}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {originals.length === 0 && photography.length === 0 && (
    <section class="section-spacing bg-daos-paper">
      <div class="container-art text-center py-20">
        <p class="font-body text-daos-charcoal text-lg">New pieces coming soon.</p>
      </div>
    </section>
  )}
</BaseLayout>
