---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryGrid from '../../components/GalleryGrid.tsx';
import { sanityClient, urlFor, queries } from '../../lib/sanity';
import type { GalleryItem } from '../../components/GalleryGrid.tsx';

const allArtwork = await sanityClient.fetch(queries.allArtwork);

function formatTypeLabel(type: string): string {
  return type === 'photography' ? 'Photography' : 'Original';
}

const items: GalleryItem[] = allArtwork.map((piece: any) => ({
  id: piece._id,
  title: piece.title,
  slug: piece.slug.current,
  imageUrl: piece.images?.[0] ? urlFor(piece.images[0]).width(700).url() : null,
  artworkType: piece.artworkType ?? 'original',
  artworkTypeLabel: formatTypeLabel(piece.artworkType ?? 'original'),
  forSale: piece.forSale,
  originalAvailable: piece.originalAvailable,
  price: piece.price,
}));
---

<BaseLayout
  title="Gallery"
  description="Original paintings, drawings, and photography by Wilma Huertas."
>
  {items.length === 0 ? (
    <div class="text-center py-40">
      <p class="font-body text-daos-cream/70 text-lg">New work coming soon.</p>
    </div>
  ) : (
    <div class="px-1.5 py-1.5 pt-20 md:pt-28">
      <GalleryGrid client:load items={items} />
    </div>
  )}
</BaseLayout>
