---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import { sanityClient, queries } from '../../lib/sanity';

const allArtwork = await sanityClient.fetch(queries.allArtwork);
---

<BaseLayout
  title="Gallery"
  description="Original paintings, drawings, prints, and mixed media artworks by Wilma. Browse the full collection and find a piece for your home."
>
  <!-- Page header -->
  <section class="section-spacing">
    <div class="container-art">
      <div class="max-w-2xl">
        <p class="font-sans text-xs uppercase tracking-widest text-daos-terracotta mb-4">Gallery</p>
        <h1 class="font-display italic text-display-lg md:text-display-xl text-daos-ink mb-6 leading-tight">
          The work
        </h1>
        <p class="font-body text-daos-charcoal text-lg leading-relaxed">
          Paintings, drawings, prints, and mixed media — each piece a quiet study in colour, texture, and the small wonders of everyday life.
        </p>
      </div>
    </div>
  </section>

  <!-- Gallery grid -->
  <section class="section-spacing bg-daos-paper">
    <div class="container-art">
      <GalleryGrid artwork={allArtwork} showFilters={true} />
    </div>
  </section>
</BaseLayout>
