---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityClient, urlFor, queries } from '../../lib/sanity';

const { slug } = Astro.params;
const artwork = await sanityClient.fetch(queries.artworkBySlug, { slug });

if (!artwork) {
  return Astro.redirect('/gallery');
}

// Build image array (skip entries without a valid asset)
const images = (artwork.images ?? [])
  .filter((img: any) => img.asset)
  .map((img: any) => ({
    url: urlFor(img).width(900).url(),
    alt: img.alt ?? artwork.title,
  }));

// Format dimensions
function formatDimensions(dims: any): string {
  if (!dims) return '';
  const { width, height, depth, unit = 'in' } = dims;
  if (!width && !height) return '';
  const parts = [height, width, depth].filter(Boolean).join(' x ');
  return `${parts} ${unit}`;
}

const dimsDisplay = formatDimensions(artwork.dimensions);

// Render blockContent description to HTML
function blockContentToHtml(blocks: any[]): string {
  if (!Array.isArray(blocks)) return '';
  return blocks
    .map((block) => {
      if (block._type !== 'block') return '';
      const tag =
        block.style === 'h2' ? 'h2' :
        block.style === 'h3' ? 'h3' :
        block.style === 'h4' ? 'h4' :
        block.style === 'blockquote' ? 'blockquote' :
        'p';

      const text = (block.children ?? [])
        .map((span: any) => {
          let t = (span.text ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
          if (span.marks?.includes('strong')) t = `<strong>${t}</strong>`;
          if (span.marks?.includes('em')) t = `<em>${t}</em>`;
          return t;
        })
        .join('');

      return `<${tag}>${text}</${tag}>`;
    })
    .join('\n');
}

let descriptionHtml = '';
if (artwork.description && Array.isArray(artwork.description)) {
  descriptionHtml = blockContentToHtml(artwork.description);
}

const categoryLabel = artwork.category
  ? artwork.category.charAt(0).toUpperCase() + artwork.category.slice(1).replace('-', ' ')
  : null;

const seoTitle = artwork.seo?.title || artwork.title;
const seoDescription = artwork.seo?.description || artwork.story || `${artwork.title}${artwork.medium ? ` — ${artwork.medium}` : ''}.`;
---

<BaseLayout title={seoTitle} description={seoDescription}>
  <article>
    <section class="py-20 md:py-28">
      <div class="container-art">
        <!-- Back link -->
        <a href="/gallery" class="inline-flex items-center gap-1 font-sans text-sm text-daos-cream/70 hover:text-daos-cream transition-colors mb-10">
          &larr; Back to Gallery
        </a>

        <div class="grid grid-cols-1 md:grid-cols-[3fr_2fr] gap-12 lg:gap-16 items-start">

          <!-- Stacked images -->
          <div class="space-y-2">
            {images.map((img: any) => (
              <img
                src={img.url}
                alt={img.alt}
                class="w-full block"
                loading="lazy"
              />
            ))}
          </div>

          <!-- Right: Details sidebar -->
          <div class="space-y-6">

            <!-- Category badge -->
            {categoryLabel && (
              <span class="inline-block px-3 py-1 border border-white/20 text-daos-cream/70 text-xs font-sans uppercase tracking-wider rounded-sm">
                {categoryLabel}
              </span>
            )}

            <!-- Title -->
            <h1 class="font-display text-display md:text-display-lg text-daos-cream leading-tight">
              {artwork.title}
            </h1>

            <!-- Meta: medium / dimensions / year -->
            <div class="space-y-1 font-sans text-sm text-daos-cream/70">
              {artwork.medium && <p>{artwork.medium}</p>}
              {dimsDisplay && <p>{dimsDisplay}</p>}
              {artwork.year && <p>{artwork.year}</p>}
            </div>

            <!-- Artist story -->
            {artwork.story && (
              <p class="font-body text-daos-cream/70 leading-relaxed italic border-l-2 border-white/30 pl-4">
                {artwork.story}
              </p>
            )}

            <!-- Collection link -->
            {artwork.collection?.slug?.current && (
              <p class="font-sans text-sm text-daos-cream/50">
                Part of{' '}
                <a
                  href={`/gallery/collections/${artwork.collection.slug.current}`}
                  class="text-daos-marigold underline underline-offset-2 hover:text-daos-cream transition-colors"
                >
                  {artwork.collection.title}
                </a>
              </p>
            )}

            <!-- Buy from shop link -->
            {artwork.forSale && (
              <div class="pt-4 border-t border-white/20">
                <a href={`/shop/${artwork.slug.current}`} class="btn-warm inline-flex items-center gap-2">
                  Buy this work from our shop
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- Extended description -->
    {descriptionHtml && (
      <section class="py-20 md:py-28 bg-daos-paper">
        <div class="container-art">
          <div
            class="max-w-2xl mx-auto prose prose-stone font-body text-daos-charcoal leading-relaxed"
            set:html={descriptionHtml}
          />
        </div>
      </section>
    )}

  </article>
</BaseLayout>
