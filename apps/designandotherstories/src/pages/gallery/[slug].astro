---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageViewer from '../../components/ImageViewer.tsx';
import PurchaseAction from '../../components/PurchaseAction.astro';
import JsonLd from '../../components/JsonLd.astro';
import { sanityClient, urlFor, queries } from '../../lib/sanity';
import { artworkSchema, productSchema, breadcrumbSchema } from '../../lib/structured-data';
import { artworkMetaTitle, artworkMetaDescription } from '../../lib/seo-fallbacks';

export async function getStaticPaths() {
  const allArtwork = await sanityClient.fetch(queries.allArtwork);
  return allArtwork
    .filter((a: any) => a.slug?.current)
    .map((a: any) => ({
      params: { slug: a.slug.current },
    }));
}

const { slug } = Astro.params;
const artwork = await sanityClient.fetch(queries.artworkBySlug, { slug });

if (!artwork) {
  return Astro.redirect('/gallery');
}

// Build image arrays for ImageViewer (skip entries without a valid asset)
const images = (artwork.images ?? [])
  .filter((img: any) => img.asset)
  .map((img: any) => ({
    url: urlFor(img).width(800).fit('max').url(),
    alt: img.alt ?? artwork.title,
    thumbUrl: urlFor(img).width(160).height(160).fit('crop').url(),
  }));

// Thumbnail for purchase actions / OG image
const firstImageUrl = images.length > 0 ? images[0].url : undefined;

// Format dimensions
function formatDimensions(dims: any): string {
  if (!dims) return '';
  const { width, height, depth, unit = 'in' } = dims;
  if (!width && !height) return '';
  const parts = [height, width, depth].filter(Boolean).join(' x ');
  return `${parts} ${unit}`;
}

const dimsDisplay = formatDimensions(artwork.dimensions);

// Render blockContent description to HTML
function blockContentToHtml(blocks: any[]): string {
  if (!Array.isArray(blocks)) return '';
  return blocks
    .map((block) => {
      if (block._type !== 'block') return '';
      const tag =
        block.style === 'h2' ? 'h2' :
        block.style === 'h3' ? 'h3' :
        block.style === 'h4' ? 'h4' :
        block.style === 'blockquote' ? 'blockquote' :
        'p';

      const text = (block.children ?? [])
        .map((span: any) => {
          let t = (span.text ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
          if (span.marks?.includes('strong')) t = `<strong>${t}</strong>`;
          if (span.marks?.includes('em')) t = `<em>${t}</em>`;
          return t;
        })
        .join('');

      return `<${tag}>${text}</${tag}>`;
    })
    .join('\n');
}

let descriptionHtml = '';
if (artwork.description && Array.isArray(artwork.description)) {
  descriptionHtml = blockContentToHtml(artwork.description);
}

const categoryLabel = artwork.category
  ? artwork.category.charAt(0).toUpperCase() + artwork.category.slice(1).replace('-', ' ')
  : null;

const seoTitle = artworkMetaTitle(artwork);
const seoDescription = artworkMetaDescription(artwork);
---

<BaseLayout title={seoTitle} description={seoDescription} showSnipcart={artwork.forSale} ogImage={firstImageUrl} ogImageType="artwork" ogImageSubtitle={artwork.medium} ogType="article">
  <Fragment slot="head">
    <JsonLd schema={[
      artworkSchema({
        title: artwork.title,
        slug: artwork.slug.current,
        description: artwork.story || seoDescription,
        medium: artwork.medium,
        dimensions: artwork.dimensions,
        year: artwork.year,
        imageUrl: firstImageUrl,
        price: artwork.price,
        available: artwork.originalAvailable || artwork.printsAvailable,
        collection: artwork.collection?.title,
      }),
      ...(artwork.forSale ? [productSchema({
        title: artwork.title,
        slug: artwork.slug.current,
        description: artwork.story || seoDescription,
        imageUrl: firstImageUrl,
        price: artwork.price,
        available: artwork.originalAvailable || artwork.printsAvailable,
      })] : []),
      breadcrumbSchema([
        { name: 'Home', url: '/' },
        { name: 'Gallery', url: '/gallery' },
        { name: artwork.title, url: `/gallery/${artwork.slug.current}` },
      ]),
    ]} />
  </Fragment>
  <article>
    <section class="section-spacing">
      <div class="container-art">
        <!-- Back link -->
        <a href="/gallery" class="inline-flex items-center gap-1 font-sans text-sm text-daos-charcoal hover:text-daos-terracotta transition-colors mb-10">
          &larr; Back to Gallery
        </a>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16 items-start">

          <!-- Left: Image viewer -->
          <div>
            <ImageViewer client:visible images={images} />
          </div>

          <!-- Right: Details sidebar -->
          <div class="space-y-6">

            <!-- Category badge -->
            {categoryLabel && (
              <span class="inline-block px-3 py-1 border border-daos-warm text-daos-charcoal text-xs font-sans uppercase tracking-wider rounded-sm">
                {categoryLabel}
              </span>
            )}

            <!-- Title -->
            <h1 class="font-display text-display md:text-display-lg text-daos-ink leading-tight">
              {artwork.title}
            </h1>

            <!-- Meta: medium / dimensions / year -->
            <div class="space-y-1 font-sans text-sm text-daos-charcoal">
              {artwork.medium && <p>{artwork.medium}</p>}
              {dimsDisplay && <p>{dimsDisplay}</p>}
              {artwork.year && <p>{artwork.year}</p>}
            </div>

            <!-- Artist story -->
            {artwork.story && (
              <p class="font-body text-daos-charcoal leading-relaxed italic border-l-2 border-daos-clay pl-4">
                {artwork.story}
              </p>
            )}

            <!-- Collection link -->
            {artwork.collection?.slug?.current && (
              <p class="font-sans text-sm">
                Part of{' '}
                <a
                  href={`/gallery/collections/${artwork.collection.slug.current}`}
                  class="text-daos-sage underline underline-offset-2 hover:text-daos-terracotta transition-colors"
                >
                  {artwork.collection.title}
                </a>
              </p>
            )}

            <!-- Purchase action -->
            {artwork.forSale && (
              <div class="pt-4 border-t border-daos-warm">
                <PurchaseAction
                  title={artwork.title}
                  slug={artwork.slug.current}
                  price={artwork.price}
                  originalAvailable={artwork.originalAvailable}
                  printsAvailable={artwork.printsAvailable}
                  image={firstImageUrl}
                />
              </div>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- Extended description -->
    {descriptionHtml && (
      <section class="section-spacing bg-daos-paper">
        <div class="container-art">
          <div
            class="max-w-2xl mx-auto prose prose-stone font-body text-daos-charcoal leading-relaxed"
            set:html={descriptionHtml}
          />
        </div>
      </section>
    )}

    <!-- Print options -->
    {artwork.printsAvailable && artwork.printOptions && artwork.printOptions.length > 0 && (
      <section id="prints" class="section-spacing">
        <div class="container-art">
          <div class="max-w-xl">
            <h2 class="font-display text-2xl text-daos-ink mb-6">Print Options</h2>
            <div class="space-y-3">
              {artwork.printOptions.map((opt: any) => (
                <div class="flex items-center justify-between py-3 border-b border-daos-warm">
                  <div class="font-sans text-sm text-daos-charcoal">{opt.size}</div>
                  <div class="flex items-center gap-4">
                    <span class="font-sans font-medium text-daos-ink">${opt.price?.toLocaleString()}</span>
                    {opt.inStock ? (
                      <span class="text-xs text-daos-sage uppercase tracking-wide">In Stock</span>
                    ) : (
                      <span class="text-xs text-daos-charcoal uppercase tracking-wide">Out of Stock</span>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}
  </article>
</BaseLayout>
