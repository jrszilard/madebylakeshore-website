---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GalleryGrid from '../../../components/GalleryGrid.astro';
import { sanityClient, urlFor, queries } from '../../../lib/sanity';

export async function getStaticPaths() {
  const allCollections = await sanityClient.fetch(queries.allCollections);
  return allCollections
    .filter((c: any) => c.slug?.current)
    .map((c: any) => ({
      params: { slug: c.slug.current },
    }));
}

const { slug } = Astro.params;

const [collection, artwork] = await Promise.all([
  sanityClient.fetch(queries.collectionBySlug, { slug }),
  sanityClient.fetch(queries.artworkByCollectionSlug, { slug }),
]);

if (!collection) {
  return Astro.redirect('/gallery/collections');
}

const coverUrl = collection.coverImage
  ? urlFor(collection.coverImage).width(1200).height(400).fit('crop').crop('focalpoint').url()
  : null;
---

<BaseLayout
  title={collection.title}
  description={collection.description ?? `Artworks from the ${collection.title} collection by Wilma.`}
>
  <!-- Collection header -->
  <section class="section-spacing">
    <div class="container-art">
      <a href="/gallery/collections" class="inline-flex items-center gap-1 font-sans text-sm text-daos-charcoal hover:text-daos-terracotta transition-colors mb-10">
        &larr; All Collections
      </a>

      <div class="max-w-2xl">
        <p class="font-sans text-xs uppercase tracking-widest text-daos-terracotta mb-4">Collection</p>
        <h1 class="font-display italic text-display-lg md:text-display-xl text-daos-ink mb-6 leading-tight">
          {collection.title}
        </h1>
        {collection.description && (
          <p class="font-body text-daos-charcoal text-lg leading-relaxed">
            {collection.description}
          </p>
        )}
      </div>
    </div>
  </section>

  {/* Cover image strip */}
  {coverUrl && (
    <div class="w-full h-48 md:h-64 overflow-hidden bg-daos-warm">
      <img
        src={coverUrl}
        alt={collection.title}
        class="w-full h-full object-cover"
      />
    </div>
  )}

  <!-- Artwork grid -->
  <section class="section-spacing bg-daos-paper">
    <div class="container-art">
      {artwork && artwork.length > 0 ? (
        <GalleryGrid artwork={artwork} showFilters={false} />
      ) : (
        <p class="font-body text-daos-charcoal text-center py-16">No artworks in this collection yet.</p>
      )}
    </div>
  </section>
</BaseLayout>
