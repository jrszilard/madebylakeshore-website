---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GalleryCard from '../../../components/GalleryCard.astro';
import { sanityClient, urlFor, queries } from '../../../lib/sanity';

export async function getStaticPaths() {
  const allCollections = await sanityClient.fetch(queries.allCollections);
  return allCollections
    .filter((c: any) => c.slug?.current)
    .map((c: any) => ({
      params: { slug: c.slug.current },
    }));
}

const { slug } = Astro.params;

const [collection, artworkFallback] = await Promise.all([
  sanityClient.fetch(queries.collectionBySlug, { slug }),
  sanityClient.fetch(queries.artworkByCollectionSlug, { slug }),
]);

if (!collection) {
  return Astro.redirect('/gallery');
}

const coverUrl = collection.coverImage
  ? urlFor(collection.coverImage).width(1600).height(900).fit('crop').crop('focalpoint').url()
  : null;

const releaseYear = collection.releaseDate
  ? new Date(collection.releaseDate).getFullYear()
  : null;

const hasLookbook = collection.lookbookContent && collection.lookbookContent.length > 0;

const artworkCount = hasLookbook
  ? collection.lookbookContent.filter((item: any) => item._type === 'artworkEntry').length
  : (artworkFallback?.length ?? 0);

// Group lookbook items into chunks: each full-width editorial text breaks the flow,
// while artwork entries and inline editorial texts are grouped into grid rows.
type LookbookChunk =
  | { kind: 'fullwidth'; item: any }
  | { kind: 'grid'; items: any[] };

function chunkLookbook(content: any[]): LookbookChunk[] {
  const chunks: LookbookChunk[] = [];
  let gridBuffer: any[] = [];
  for (const item of content) {
    if (item._type === 'editorialText' && item.layout !== 'inline') {
      if (gridBuffer.length) { chunks.push({ kind: 'grid', items: gridBuffer }); gridBuffer = []; }
      chunks.push({ kind: 'fullwidth', item });
    } else {
      gridBuffer.push(item);
    }
  }
  if (gridBuffer.length) chunks.push({ kind: 'grid', items: gridBuffer });
  return chunks;
}

const lookbookChunks = hasLookbook ? chunkLookbook(collection.lookbookContent) : [];
---

<BaseLayout
  title={collection.title}
  description={collection.tagline ?? `A collection by W. H. Bonilla.`}
>
  <!-- Full-bleed cover -->
  {coverUrl ? (
    <section class="relative h-[85vh] flex items-end overflow-hidden">
      <img
        src={coverUrl}
        alt={collection.title}
        class="absolute inset-0 w-full h-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-daos-ink/80 via-daos-ink/20 to-transparent"></div>
      <div class="relative z-10 w-full container-art pb-16">
        <div class="flex items-end justify-between">
          <div class="space-y-3">
            {releaseYear && (
              <p class="font-sans text-xs uppercase tracking-widest text-white/60">{releaseYear}</p>
            )}
            <h1 class="font-display italic text-display-lg md:text-display-xl text-white leading-tight">
              {collection.title}
            </h1>
            {collection.tagline && (
              <p class="font-body text-lg text-white/80 leading-relaxed max-w-xl">
                {collection.tagline}
              </p>
            )}
          </div>
          <p class="font-sans text-sm text-white/50 hidden md:block">
            {artworkCount} {artworkCount === 1 ? 'piece' : 'pieces'}
          </p>
        </div>
      </div>
    </section>
  ) : (
    <section class="section-spacing">
      <div class="container-art max-w-2xl">
        {releaseYear && (
          <p class="font-sans text-xs uppercase tracking-widest text-daos-clay mb-4">{releaseYear}</p>
        )}
        <h1 class="font-display italic text-display-lg md:text-display-xl text-daos-ink leading-tight mb-4">
          {collection.title}
        </h1>
        {collection.tagline && (
          <p class="font-body text-lg text-daos-charcoal leading-relaxed">{collection.tagline}</p>
        )}
      </div>
    </section>
  )}

  <!-- Editorial description -->
  {collection.description && (
    <section class="py-16">
      <div class="container-art">
        <div class="max-w-2xl mx-auto">
          <p class="font-body text-lg text-daos-charcoal leading-relaxed">
            {typeof collection.description === 'string'
              ? collection.description
              : collection.description[0]?.children?.[0]?.text ?? ''}
          </p>
        </div>
      </div>
    </section>
  )}

  <!-- Lookbook content (interleaved artwork + editorial text) -->
  {hasLookbook ? (
    <section class="pb-24">
      <div class="container-art space-y-16">
        {lookbookChunks.map((chunk) => {
          if (chunk.kind === 'fullwidth') {
            const item = chunk.item;
            return (
              <div class="max-w-2xl mx-auto py-4 space-y-4">
                {item.heading && (
                  <h2 class="font-display italic text-display text-daos-ink leading-tight">
                    {item.heading}
                  </h2>
                )}
                <p class="font-body text-lg text-daos-charcoal leading-relaxed">{item.body}</p>
              </div>
            );
          }
          // Grid chunk: artwork cards + inline text cards
          return (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {chunk.items.map((item: any) => {
                if (item._type === 'artworkEntry' && item.artwork) {
                  const piece = item.artwork;
                  return (
                    <GalleryCard
                      title={piece.title}
                      slug={piece.slug}
                      images={piece.images ?? []}
                      medium={piece.medium}
                    />
                  );
                }
                if (item._type === 'editorialText') {
                  return (
                    <div class="h-full bg-daos-paper rounded-sm p-8 flex flex-col justify-center space-y-3">
                      {item.heading && (
                        <h2 class="font-display italic text-xl text-daos-ink leading-tight">
                          {item.heading}
                        </h2>
                      )}
                      <p class="font-body text-daos-charcoal leading-relaxed">{item.body}</p>
                    </div>
                  );
                }
              })}
            </div>
          );
        })}
      </div>
    </section>
  ) : (
    <!-- Fallback: artwork grid from collection reference -->
    <section class="pb-24">
      <div class="container-art">
        {artworkFallback && artworkFallback.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {(artworkFallback as any[]).map((piece: any) => (
              <GalleryCard
                title={piece.title}
                slug={piece.slug}
                images={piece.images ?? []}
                medium={piece.medium}
              />
            ))}
          </div>
        ) : (
          <p class="font-body text-daos-charcoal text-center py-16">No pieces in this collection yet.</p>
        )}
      </div>
    </section>
  )}

  <!-- Back link -->
  <div class="container-art pb-16">
    <a href="/gallery" class="font-sans text-sm text-daos-terracotta hover:underline transition-colors">
      &larr; All Collections
    </a>
  </div>
</BaseLayout>
