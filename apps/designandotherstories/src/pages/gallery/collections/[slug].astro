---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ShopCard from '../../../components/ShopCard.astro';
import { sanityClient, urlFor, queries } from '../../../lib/sanity';

export async function getStaticPaths() {
  const allCollections = await sanityClient.fetch(queries.allCollections);
  return allCollections
    .filter((c: any) => c.slug?.current)
    .map((c: any) => ({
      params: { slug: c.slug.current },
    }));
}

const { slug } = Astro.params;

const [collection, artwork] = await Promise.all([
  sanityClient.fetch(queries.collectionBySlug, { slug }),
  sanityClient.fetch(queries.artworkByCollectionSlug, { slug }),
]);

if (!collection) return Astro.redirect('/gallery');

const coverUrl = collection.coverImage
  ? urlFor(collection.coverImage).width(1600).height(900).fit('crop').crop('focalpoint').url()
  : null;

const releaseYear = collection.releaseDate
  ? new Date(collection.releaseDate).getFullYear()
  : null;

const hasEssay = collection.essayBlocks?.length > 0;
const hasArtwork = artwork?.length > 0;
---

<BaseLayout
  title={collection.title}
  description={collection.tagline ?? `A collection by W. H. Bonilla.`}
  showSnipcart={hasArtwork}
>
  <!-- Full-bleed cover -->
  {coverUrl ? (
    <section class="relative h-[85vh] flex items-end overflow-hidden">
      <img
        src={coverUrl}
        alt={collection.title}
        class="absolute inset-0 w-full h-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-daos-ink/80 via-daos-ink/20 to-transparent"></div>
      <div class="relative z-10 w-full container-art pb-16">
        <div class="flex items-end justify-between">
          <div class="space-y-3">
            {releaseYear && (
              <p class="font-sans text-xs uppercase tracking-widest text-white/60">{releaseYear}</p>
            )}
            <h1 class="font-display italic text-display-lg md:text-display-xl text-white leading-tight">
              {collection.title}
            </h1>
            {collection.tagline && (
              <p class="font-body text-lg text-white/80 leading-relaxed max-w-xl">{collection.tagline}</p>
            )}
          </div>
          {hasArtwork && (
            <p class="font-sans text-xs uppercase tracking-widest text-white/50 hidden md:block">
              {artwork.length} {artwork.length === 1 ? 'piece' : 'pieces'}
            </p>
          )}
        </div>
      </div>
    </section>
  ) : (
    <section class="section-spacing">
      <div class="container-art max-w-2xl">
        {releaseYear && (
          <p class="font-sans text-xs uppercase tracking-widest text-daos-clay mb-4">{releaseYear}</p>
        )}
        <h1 class="font-display italic text-display-lg md:text-display-xl text-daos-ink leading-tight mb-4">
          {collection.title}
        </h1>
        {collection.tagline && (
          <p class="font-body text-lg text-daos-charcoal leading-relaxed">{collection.tagline}</p>
        )}
      </div>
    </section>
  )}

  <!-- Visual essay blocks -->
  {hasEssay && (
    <div class="pt-16">
      {(collection.essayBlocks as any[]).map((block: any) => {

        if (block._type === 'imageBlock') {
          const imgUrl = block.image?.asset?.url
            ? block.style === 'full-bleed'
              ? urlFor(block.image).width(1920).fit('max').url()
              : urlFor(block.image).width(1400).fit('max').url()
            : null;

          if (block.style === 'full-bleed') {
            return (
              <div class="mb-6">
                {imgUrl && (
                  <img
                    src={imgUrl}
                    alt={block.image?.alt ?? ''}
                    class="w-full block"
                    style="max-height: 90vh; object-fit: cover;"
                  />
                )}
                {block.caption && (
                  <div class="container-art pt-3">
                    <p class="font-sans text-xs uppercase tracking-widest text-daos-clay">{block.caption}</p>
                  </div>
                )}
              </div>
            );
          }

          return (
            <div class="container-art mb-16">
              {imgUrl && (
                <img
                  src={imgUrl}
                  alt={block.image?.alt ?? ''}
                  class="w-full block rounded-sm"
                />
              )}
              {block.caption && (
                <p class="font-sans text-xs uppercase tracking-widest text-daos-clay mt-3">{block.caption}</p>
              )}
            </div>
          );
        }

        if (block._type === 'textBlock') {
          if (block.style === 'full-bleed') {
            return (
              <div class="bg-daos-ink text-daos-cream py-24 mb-6">
                <div class="container-art">
                  <div class="max-w-2xl mx-auto space-y-5">
                    {block.heading && (
                      <h2 class="font-display italic text-display text-daos-cream leading-tight">{block.heading}</h2>
                    )}
                    <p class="font-body text-lg text-daos-cream/80 leading-relaxed">{block.body}</p>
                  </div>
                </div>
              </div>
            );
          }

          return (
            <div class="container-art mb-16">
              <div class="max-w-2xl mx-auto space-y-5">
                {block.heading && (
                  <h2 class="font-display italic text-display text-daos-ink leading-tight">{block.heading}</h2>
                )}
                <p class="font-body text-lg text-daos-charcoal leading-relaxed">{block.body}</p>
              </div>
            </div>
          );
        }
      })}
    </div>
  )}

  <!-- Products swimlane -->
  {hasArtwork && (
    <section class="py-16 border-t border-daos-warm">
      <div class="container-art mb-8">
        <p class="font-sans text-xs uppercase tracking-widest text-daos-clay">The Collection</p>
      </div>
      <div class="flex overflow-x-auto gap-4 px-6 md:px-12 pb-4 scrollbar-hide snap-x snap-mandatory" style="scroll-padding-left: 1.5rem;">
        {(artwork as any[]).map((piece: any) => (
          <div class="snap-start shrink-0 w-[280px] md:w-[320px]">
            <ShopCard
              title={piece.title}
              slug={piece.slug}
              images={piece.images ?? []}
              medium={piece.medium}
              price={piece.price}
              originalAvailable={piece.originalAvailable}
              printsAvailable={piece.printsAvailable ?? false}
            />
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Back link -->
  <div class="container-art py-12">
    <a href="/gallery" class="font-sans text-xs uppercase tracking-widest text-daos-terracotta hover:text-daos-terracotta-dark transition-colors">
      &larr; All Collections
    </a>
  </div>

</BaseLayout>
