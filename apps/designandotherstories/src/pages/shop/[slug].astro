---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageViewer from '../../components/ImageViewer.tsx';
import PurchaseAction from '../../components/PurchaseAction.astro';
import { sanityClient, urlFor, queries } from '../../lib/sanity';

export async function getStaticPaths() {
  const allSlugs = await sanityClient.fetch(queries.allShopProductSlugs);
  return allSlugs
    .filter((p: any) => p.slug?.current)
    .map((p: any) => ({
      params: { slug: p.slug.current },
    }));
}

const { slug } = Astro.params;
const product = await sanityClient.fetch(queries.shopProductBySlug, { slug });

if (!product) {
  return Astro.redirect('/shop');
}

// Build image arrays for ImageViewer (skip entries without a valid asset)
const images = (product.images ?? [])
  .filter((img: any) => img.asset)
  .map((img: any) => ({
    url: urlFor(img).width(800).fit('max').url(),
    alt: img.alt ?? product.title,
    thumbUrl: urlFor(img).width(160).height(160).fit('crop').url(),
  }));

// Thumbnail for purchase action / OG image
const firstImageUrl = images.length > 0 ? images[0].url : undefined;

const categoryLabel = product.category
  ? product.category.charAt(0).toUpperCase() + product.category.slice(1).replace('-', ' ')
  : null;

// Render blockContent description to HTML
function blockContentToHtml(blocks: any[]): string {
  if (!Array.isArray(blocks)) return '';
  return blocks
    .map((block) => {
      if (block._type !== 'block') return '';
      const tag =
        block.style === 'h2' ? 'h2' :
        block.style === 'h3' ? 'h3' :
        block.style === 'h4' ? 'h4' :
        block.style === 'blockquote' ? 'blockquote' :
        'p';

      const text = (block.children ?? [])
        .map((span: any) => {
          let t = (span.text ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
          if (span.marks?.includes('strong')) t = `<strong>${t}</strong>`;
          if (span.marks?.includes('em')) t = `<em>${t}</em>`;
          return t;
        })
        .join('');

      return `<${tag}>${text}</${tag}>`;
    })
    .join('\n');
}

let descriptionHtml = '';
if (product.description && Array.isArray(product.description)) {
  descriptionHtml = blockContentToHtml(product.description);
}

const seoTitle = product.title;
const seoDescription = product.blurb || `${product.title}${categoryLabel ? ` — ${categoryLabel}` : ''}.`;
---

<BaseLayout title={seoTitle} description={seoDescription} showSnipcart={true}>
  <article>
    <section class="section-spacing">
      <div class="container-art">
        <!-- Back link -->
        <a href="/shop" class="inline-flex items-center gap-1 font-sans text-sm text-daos-charcoal hover:text-daos-terracotta transition-colors mb-10">
          &larr; Back to Shop
        </a>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16 items-start">

          <!-- Left: Image viewer -->
          <div>
            <ImageViewer client:visible images={images} />
          </div>

          <!-- Right: Details sidebar -->
          <div class="space-y-6">

            <!-- Category badge -->
            {categoryLabel && (
              <span class="inline-block px-3 py-1 border border-daos-warm text-daos-charcoal text-xs font-sans uppercase tracking-wider rounded-sm">
                {categoryLabel}
              </span>
            )}

            <!-- Title -->
            <h1 class="font-display text-display md:text-display-lg text-daos-ink leading-tight">
              {product.title}
            </h1>

            <!-- Blurb -->
            {product.blurb && (
              <p class="font-body text-daos-charcoal leading-relaxed italic border-l-2 border-daos-clay pl-4">
                {product.blurb}
              </p>
            )}

            <!-- Related artwork link -->
            {product.relatedArtwork?.slug?.current && (
              <p class="font-sans text-sm">
                Inspired by{' '}
                <a
                  href={`/gallery/${product.relatedArtwork.slug.current}`}
                  class="text-daos-sage underline underline-offset-2 hover:text-daos-terracotta transition-colors"
                >
                  {product.relatedArtwork.title}
                </a>
              </p>
            )}

            <!-- Purchase action -->
            <div class="pt-4 border-t border-daos-warm">
              <PurchaseAction
                title={product.title}
                slug={product.slug.current}
                price={product.price}
                originalAvailable={product.available}
                printsAvailable={false}
                image={firstImageUrl}
                basePath="/shop"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Extended description -->
    {descriptionHtml && (
      <section class="section-spacing bg-daos-paper">
        <div class="container-art">
          <div
            class="max-w-2xl mx-auto prose prose-stone font-body text-daos-charcoal leading-relaxed"
            set:html={descriptionHtml}
          />
        </div>
      </section>
    )}
  </article>
</BaseLayout>
