---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import ShopGrid from '../../components/ShopGrid.tsx';
import { sanityClient, urlFor, queries } from '../../lib/sanity';
import type { ShopItem } from '../../components/ShopGrid.tsx';
import { priceRange } from '../../lib/commerce/pricing';

const shopProducts = await sanityClient.fetch(queries.shopProducts);

function formatCategoryLabel(cat: string): string {
  return cat.charAt(0).toUpperCase() + cat.slice(1).replace(/-/g, ' ');
}

const allItems: ShopItem[] = (shopProducts ?? []).map((item: any) => {
  const range = priceRange(item.price, item.styles);
  return {
    id: item._id,
    title: item.title,
    slug: item.slug.current,
    imageUrl: item.images?.[0]
      ? urlFor(item.images[0]).width(600).height(338).fit('crop').crop('focalpoint').url()
      : null,
    medium: item.blurb,
    price: range?.min,
    priceFrom: range ? range.min !== range.max : false,
    category: item.category ?? 'other',
    categoryLabel: formatCategoryLabel(item.category ?? 'other'),
    available: Boolean(item.available),
  };
});
---

<BaseLayout
  title="Shop"
  description="Shop original artwork, prints, photo prints, postcards, greeting cards, notepads, bookmarks, and magnets by Wilma. Each piece ships directly from the studio."
>
  {allItems.length === 0 ? (
    <div class="text-center py-40">
      <p class="font-body text-daos-cream/70 text-lg">New pieces coming soon.</p>
    </div>
  ) : (
    <div class="container-art py-20 md:py-28">
      <ShopGrid client:load items={allItems} />
    </div>
  )}
</BaseLayout>
