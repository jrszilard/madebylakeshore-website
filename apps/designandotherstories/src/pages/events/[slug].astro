---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import BringingGrid from '../../components/BringingGrid.astro';
import { sanityClient, urlFor, queries } from '../../lib/sanity';

const { slug } = Astro.params;

const event = await sanityClient.fetch(queries.eventBySlug, { slug });

if (!event) {
  return Astro.redirect('/events');
}

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-US', {
    weekday: 'long',
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
}

const startFormatted = formatDate(event.startDate);
const endFormatted = event.endDate ? formatDate(event.endDate) : null;

const locationParts = [
  event.location?.venueName,
  event.location?.city,
  event.location?.state,
].filter(Boolean);
const locationDisplay = locationParts.join(', ');

const eventTypeLabel = event.eventType
  ? event.eventType.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())
  : null;

function blockContentToHtml(blocks: any[]): string {
  if (!Array.isArray(blocks)) return '';
  return blocks
    .map((block) => {
      if (block._type !== 'block') return '';
      const tag =
        block.style === 'h2' ? 'h2' :
        block.style === 'h3' ? 'h3' :
        block.style === 'h4' ? 'h4' :
        block.style === 'blockquote' ? 'blockquote' :
        'p';
      const text = (block.children ?? [])
        .map((span: any) => {
          let t = (span.text ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
          if (span.marks?.includes('strong')) t = `<strong>${t}</strong>`;
          if (span.marks?.includes('em')) t = `<em>${t}</em>`;
          return t;
        })
        .join('');
      return `<${tag}>${text}</${tag}>`;
    })
    .join('\n');
}

let descriptionHtml = '';
if (event.description && Array.isArray(event.description)) {
  descriptionHtml = blockContentToHtml(event.description);
}

const coverUrl = event.coverImage?.asset
  ? urlFor(event.coverImage).width(900).height(1200).fit('crop').crop('focalpoint').url()
  : null;

const seoTitle = event.seo?.title || event.title;
const seoDescription = event.seo?.description || `${event.title} — ${locationDisplay}`;
---

<style is:global>
  body { background-color: #DED9E4; }
</style>

<BaseLayout title={seoTitle} description={seoDescription} navTheme="dark">
  <article>
    <section class="py-20 md:py-28">
      <div class="container-art">
        <a
          href="/events"
          class="inline-flex items-center gap-1 font-sans text-sm text-daos-charcoal hover:text-daos-ink transition-colors mb-10"
        >
          &larr; All Events
        </a>

        <div class="grid grid-cols-1 md:grid-cols-[3fr_2fr] gap-12 lg:gap-16 items-start">

          <!-- Left: cover image -->
          <div>
            {coverUrl ? (
              <img
                src={coverUrl}
                alt={event.title}
                class="w-full block"
                loading="eager"
              />
            ) : (
              <div class="w-full aspect-[3/4] bg-gradient-to-br from-daos-warm to-daos-clay flex items-center justify-center">
                <span class="font-display italic text-daos-ink/30 text-2xl text-center px-8">{event.title}</span>
              </div>
            )}
          </div>

          <!-- Right: event details -->
          <div class="sticky top-20 pt-6 space-y-6">

            {eventTypeLabel && (
              <p class="font-sans text-xs uppercase tracking-widest text-daos-clay">{eventTypeLabel}</p>
            )}

            <h1 class="font-display italic text-display md:text-display-lg text-daos-ink leading-tight">
              {event.title}
            </h1>

            <div class="space-y-2 font-sans text-sm text-daos-charcoal border-t border-daos-warm pt-6">
              <div class="flex items-start gap-2">
                <span class="text-daos-terracotta mt-0.5" aria-hidden="true">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                  </svg>
                </span>
                <div>
                  <p>{startFormatted}</p>
                  {endFormatted && <p class="text-daos-clay">through {endFormatted}</p>}
                </div>
              </div>

              {locationDisplay && (
                <div class="flex items-start gap-2">
                  <span class="text-daos-terracotta mt-0.5" aria-hidden="true">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                    </svg>
                  </span>
                  <p>{locationDisplay}</p>
                </div>
              )}
            </div>

            {descriptionHtml && (
              <div class="font-body text-daos-charcoal leading-relaxed border-t border-daos-warm pt-6" set:html={descriptionHtml} />
            )}

            {event.externalUrl && (
              <div class="border-t border-daos-warm pt-6">
                <a
                  href={event.externalUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-outline inline-flex items-center gap-2"
                >
                  Event Website
                  <img src="/icons/11-link.svg" alt="" aria-hidden="true" class="w-8 h-8" />
                </a>
              </div>
            )}

            {(event.bringingArtwork?.length > 0 || event.bringingBooks?.length > 0) && (
              <div class="border-t border-daos-warm pt-6">
                <BringingGrid
                  artwork={event.bringingArtwork}
                  books={event.bringingBooks}
                />
              </div>
            )}

          </div>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
