---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BringingGrid from '../../components/BringingGrid.astro';
import { sanityClient, urlFor, queries } from '../../lib/sanity';

export async function getStaticPaths() {
  const events = await sanityClient.fetch(`*[_type == "event"]{ slug }`);
  return events
    .filter((e: any) => e.slug?.current)
    .map((e: any) => ({
      params: { slug: e.slug.current },
    }));
}

const { slug } = Astro.params;

const event = await sanityClient.fetch(queries.eventBySlug, { slug });

if (!event) {
  return Astro.redirect('/events');
}

// Format date helpers
function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-US', {
    weekday: 'long',
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
}

const startFormatted = formatDate(event.startDate);
const endFormatted = event.endDate ? formatDate(event.endDate) : null;

const locationParts = [
  event.location?.venueName,
  event.location?.city,
  event.location?.state,
].filter(Boolean);
const locationDisplay = locationParts.join(', ');

// BlockContent serializer
function blockContentToHtml(blocks: any[]): string {
  if (!Array.isArray(blocks)) return '';
  return blocks
    .map((block) => {
      if (block._type !== 'block') return '';
      const tag =
        block.style === 'h2' ? 'h2' :
        block.style === 'h3' ? 'h3' :
        block.style === 'h4' ? 'h4' :
        block.style === 'blockquote' ? 'blockquote' :
        'p';

      const text = (block.children ?? [])
        .map((span: any) => {
          let t = (span.text ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
          if (span.marks?.includes('strong')) t = `<strong>${t}</strong>`;
          if (span.marks?.includes('em')) t = `<em>${t}</em>`;
          return t;
        })
        .join('');

      return `<${tag}>${text}</${tag}>`;
    })
    .join('\n');
}

let descriptionHtml = '';
if (event.description && Array.isArray(event.description)) {
  descriptionHtml = blockContentToHtml(event.description);
}

const coverUrl = event.coverImage?.asset
  ? urlFor(event.coverImage).width(800).height(500).fit('crop').crop('focalpoint').url()
  : null;

const seoTitle = event.seo?.title || event.title;
const seoDescription = event.seo?.description || `${event.title} — ${locationDisplay}`;
---

<BaseLayout title={seoTitle} description={seoDescription}>
  <article>
    <!-- Back link + header -->
    <section class="section-spacing">
      <div class="container-art">
        <a
          href="/events"
          class="inline-flex items-center gap-1 font-sans text-sm text-daos-charcoal hover:text-daos-terracotta transition-colors mb-10"
        >
          &larr; All Events
        </a>

        <!-- Cover image -->
        {coverUrl && (
          <div class="aspect-[16/7] overflow-hidden rounded-sm bg-daos-warm mb-10">
            <img
              src={coverUrl}
              alt={event.title}
              class="w-full h-full object-cover"
            />
          </div>
        )}

        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-16 items-start">

          <!-- Left: Event details (2 cols) -->
          <div class="md:col-span-2 space-y-6">

            <!-- Event type badge -->
            {event.eventType && (
              <span class="inline-block px-3 py-1 border border-daos-warm text-daos-charcoal text-xs font-sans uppercase tracking-wider rounded-sm">
                {event.eventType}
              </span>
            )}

            <!-- Title -->
            <h1 class="font-display italic text-display md:text-display-lg text-daos-ink leading-tight">
              {event.title}
            </h1>

            <!-- Dates -->
            <div class="space-y-1 font-sans text-sm text-daos-charcoal">
              <div class="flex items-start gap-2">
                <span class="text-daos-terracotta mt-0.5" aria-hidden="true">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                  </svg>
                </span>
                <div>
                  <p>{startFormatted}</p>
                  {endFormatted && <p class="text-daos-charcoal/70">through {endFormatted}</p>}
                </div>
              </div>

              {locationDisplay && (
                <div class="flex items-start gap-2">
                  <span class="text-daos-terracotta mt-0.5" aria-hidden="true">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                    </svg>
                  </span>
                  <p>{locationDisplay}</p>
                </div>
              )}
            </div>

            <!-- Description (blockContent) -->
            {descriptionHtml && (
              <div
                class="prose prose-stone font-body text-daos-charcoal leading-relaxed max-w-none"
                set:html={descriptionHtml}
              />
            )}

            <!-- External URL -->
            {event.externalUrl && (
              <a
                href={event.externalUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-outline inline-flex items-center gap-2"
              >
                Event Website
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                </svg>
              </a>
            )}
          </div>

          <!-- Right: What I'm Bringing (1 col) -->
          <div class="md:col-span-1">
            <BringingGrid
              artwork={event.bringingArtwork}
              books={event.bringingBooks}
            />
          </div>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
