---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import BookCard from '../components/BookCard.astro';
import GalleryCard from '../components/GalleryCard.astro';
import EventCard from '../components/EventCard.astro';
import SubstackFeedCard from '../components/SubstackFeedCard.astro';
import SubstackEmbed from '../components/SubstackEmbed.astro';
import { sanityClient, queries } from '../lib/sanity';
import { fetchSubstackFeed } from '../lib/substack';

// Fetch all data at build time (static page)
const [featuredBooks, featuredArtwork, nextEvent, substackPosts] = await Promise.all([
  sanityClient.fetch(queries.featuredBooks),
  sanityClient.fetch(queries.featuredArtwork),
  sanityClient.fetch(queries.nextEvent),
  fetchSubstackFeed(),
]);

const latestPost = substackPosts.length > 0 ? substackPosts[0] : null;

// Limit to up to 2 books for the 3-card writing row
const writingBooks = (featuredBooks ?? []).slice(0, 2);
---

<BaseLayout
  title="Home"
  description="Original paintings, drawings, and written works by Design & Other Stories. Art. Words. Worlds."
>
  <!-- 1. Hero -->
  <HeroSection />

  <!-- 2. Featured Writing -->
  <section class="section-spacing bg-daos-paper">
    <div class="container-art">
      <SectionHeader title="Writing" viewAllHref="/writing" />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {writingBooks.map((book: any) => (
          <BookCard
            title={book.title}
            slug={book.slug}
            coverImage={book.coverImage}
            blurb={book.blurb}
            type={book.type}
            status={book.status}
          />
        ))}

        {latestPost && (
          <SubstackFeedCard
            title={latestPost.title}
            link={latestPost.link}
            excerpt={latestPost.excerpt}
            coverImage={latestPost.coverImage}
            type="From Substack"
          />
        )}
      </div>
    </div>
  </section>

  <!-- 3. Featured Gallery -->
  {featuredArtwork && featuredArtwork.length > 0 && (
    <section class="section-spacing">
      <div class="container-art">
        <SectionHeader title="Gallery" viewAllHref="/gallery" />

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {(featuredArtwork as any[]).map((piece: any) => (
            <GalleryCard
              title={piece.title}
              slug={piece.slug}
              images={piece.images}
              medium={piece.medium}
              category={piece.category}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 4. Next Event (only if upcoming event exists) -->
  {nextEvent && (
    <section class="section-spacing bg-daos-paper">
      <div class="container-art">
        <SectionHeader title="Next Event" viewAllHref="/events" />

        <EventCard
          title={nextEvent.title}
          slug={nextEvent.slug}
          startDate={nextEvent.startDate}
          endDate={nextEvent.endDate}
          location={nextEvent.location}
          eventType={nextEvent.eventType}
          isPast={false}
        />
      </div>
    </section>
  )}

  <!-- 5. Newsletter -->
  <section class="section-spacing">
    <div class="container-art">
      <div class="max-w-xl mx-auto text-center space-y-6">
        <p class="font-sans text-xs uppercase tracking-widest text-daos-terracotta">Newsletter</p>
        <h2 class="font-display text-display text-daos-ink">Stay Connected</h2>
        <p class="font-body text-daos-charcoal leading-relaxed">
          New work, upcoming events, and dispatches from the studio — straight to your inbox.
        </p>
        <SubstackEmbed />
      </div>
    </div>
  </section>
</BaseLayout>
