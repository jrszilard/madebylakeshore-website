---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShopCard from '../components/ShopCard.astro';
import { sanityClient, queries } from '../lib/sanity';

const artworkForSale = await sanityClient.fetch(queries.artworkForSale);

const filterPills = [
  { label: 'All', value: 'all' },
  { label: 'Originals', value: 'original' },
  { label: 'Prints', value: 'print' },
];
---

<BaseLayout
  title="Shop"
  description="Purchase original artworks, paintings, and prints by Wilma. Each piece is handmade and ships directly from the studio."
  showSnipcart={true}
>
  <!-- Page header -->
  <section class="section-spacing">
    <div class="container-art">
      <div class="max-w-2xl">
        <p class="font-sans text-xs uppercase tracking-widest text-daos-terracotta mb-4">Shop</p>
        <h1 class="font-display italic text-display-lg md:text-display-xl text-daos-ink mb-6 leading-tight">
          Take something home
        </h1>
        <p class="font-body text-daos-charcoal text-lg leading-relaxed">
          Original paintings, drawings, and prints — each piece handmade in the studio. Shipped with care.
        </p>
      </div>
    </div>
  </section>

  <!-- Shop grid -->
  <section class="section-spacing bg-daos-paper">
    <div class="container-art">

      <!-- Filter pills -->
      <div class="flex flex-wrap gap-2 mb-8" id="shop-filters">
        {filterPills.map((pill) => (
          <a
            href={pill.value === 'all' ? '/shop' : `/shop?filter=${pill.value}`}
            data-filter={pill.value}
            class:list={[
              'shop-filter-pill px-4 py-2 text-sm font-sans rounded-sm border transition-colors duration-200',
              'border-daos-clay text-daos-charcoal hover:border-daos-terracotta hover:text-daos-terracotta',
            ]}
          >
            {pill.label}
          </a>
        ))}
      </div>

      <!-- Items grid: all rendered with data-filter attributes for client-side filtering -->
      {artworkForSale && artworkForSale.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="shop-grid">
          {artworkForSale.map((piece: any) => {
            // Determine filter type for this item
            const filterType = piece.originalAvailable ? 'original' : piece.printsAvailable ? 'print' : 'original';
            return (
              <div class="shop-item" data-filter={filterType}>
                <ShopCard
                  title={piece.title}
                  slug={piece.slug}
                  images={piece.images ?? []}
                  medium={piece.medium}
                  price={piece.price}
                  originalAvailable={piece.originalAvailable}
                  printsAvailable={piece.printsAvailable}
                />
              </div>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-20">
          <p class="font-body text-daos-charcoal text-lg">
            New pieces coming soon.{' '}
            <a href="/gallery" class="text-daos-terracotta underline underline-offset-2 hover:text-daos-ink transition-colors">
              Browse the gallery
            </a>{' '}
            in the meantime.
          </p>
        </div>
      )}
    </div>
  </section>

  <script>
    (function () {
      const params = new URLSearchParams(window.location.search);
      const active = params.get('filter') || 'all';

      // Highlight active pill
      document.querySelectorAll<HTMLAnchorElement>('.shop-filter-pill').forEach((pill) => {
        const val = pill.dataset.filter ?? 'all';
        if (val === active) {
          pill.classList.remove('border-daos-clay', 'text-daos-charcoal', 'hover:border-daos-terracotta', 'hover:text-daos-terracotta');
          pill.classList.add('bg-daos-ink', 'text-daos-cream', 'border-daos-ink');
        }
      });

      // Filter items
      if (active !== 'all') {
        document.querySelectorAll<HTMLDivElement>('.shop-item').forEach((item) => {
          if (item.dataset.filter !== active) {
            item.classList.add('hidden');
          }
        });
      }
    })();
  </script>
</BaseLayout>
