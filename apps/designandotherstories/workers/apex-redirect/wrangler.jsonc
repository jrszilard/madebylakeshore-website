// The redirect Worker for the bare domain (index.js).
//   Deploy:  scripts/deploy-cloudflare.sh apex, at the cutover only: the custom domain takes the bare domain's DNS
//            over from the Vercel record it points at now.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "daos-apex-redirect",
  "main": "./index.js",
  "compatibility_date": "2026-01-14",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "designandotherstories.com", "custom_domain": true }
  ]
}
