---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { sanityClient, queries } from '../../lib/sanity';
import type { FattamanoProduct } from '../../lib/types';

export const prerender = true;

const products = await sanityClient
  .fetch<FattamanoProduct[]>(queries.allFattamanoProducts)
  .catch(() => []);

const availableCount = products.filter((p) => p.status === 'available').length;
const conceptCount = products.filter((p) => p.status === 'concept').length;
const categoryCount = new Set(products.map((p) => p.category).filter(Boolean)).size;
---
<BaseLayout
  title="things"
  description="The unoptimized catalog of fattamano objects: handmade stickers, shirts, prints, concepts, and questionable acquisitions."
>
  <section class="things-page relative overflow-hidden border-b-2 border-ft-ink bg-ft-paper">
    <div class="absolute inset-x-0 top-0 border-b-2 border-ft-ink bg-ft-splash py-2 font-mono text-xs uppercase tracking-[0.22em] text-ft-ink" aria-hidden="true">
      <div class="ft-marquee-track whitespace-nowrap">
        <span>catalog compiled under human supervision &nbsp; ✦ &nbsp;</span>
        <span>objects may contain jokes, ink, adhesive, or cultural overreach &nbsp; ✦ &nbsp;</span>
        <span>algorithmic usefulness: unverified &nbsp; ✦ &nbsp;</span>
        <span>acquisition department open emotionally &nbsp; ✦ &nbsp;</span>
      </div>
    </div>

    <div class="mx-auto grid max-w-6xl gap-10 px-6 pb-14 pt-24 md:grid-cols-[1fr_330px] md:pb-20 md:pt-28">
      <header>
        <p class="mb-5 inline-block border-2 border-ft-ink bg-white px-3 py-1 font-mono text-xs uppercase tracking-[0.22em] shadow-[4px_4px_0_#1A1A1A]">
          inventory / unoptimized
        </p>
        <h1 class="font-display text-big md:text-huge">
          The <span class="text-ft-shout">collection</span>
        </h1>
        <p class="mt-6 max-w-2xl font-body text-xl leading-relaxed text-ft-smudge">
          Small-batch handmade objects, catalogued with the confidence of a shop that might also sell you a lamp for the price of a used car.
        </p>
      </header>

      <aside class="self-start border-2 border-ft-ink bg-white shadow-[8px_8px_0_#1A1A1A] -rotate-1.5 motion-reduce:rotate-0">
        <div class="border-b-2 border-ft-ink bg-ft-sea px-4 py-2 font-mono text-xs uppercase tracking-[0.18em] text-ft-paper">
          catalog status
        </div>
        <div class="grid grid-cols-3 divide-x-2 divide-ft-ink text-center">
          <div class="p-4">
            <p class="font-display text-3xl text-ft-shout">{products.length}</p>
            <p class="mt-1 font-mono text-[0.65rem] uppercase tracking-[0.16em] text-ft-smudge">objects</p>
          </div>
          <div class="p-4">
            <p class="font-display text-3xl text-ft-shout">{availableCount}</p>
            <p class="mt-1 font-mono text-[0.65rem] uppercase tracking-[0.16em] text-ft-smudge">available</p>
          </div>
          <div class="p-4">
            <p class="font-display text-3xl text-ft-shout">{categoryCount || conceptCount}</p>
            <p class="mt-1 font-mono text-[0.65rem] uppercase tracking-[0.16em] text-ft-smudge">taxonomies</p>
          </div>
        </div>
        <div class="border-t-2 border-dashed border-ft-smudge p-4 font-mono text-xs uppercase tracking-[0.16em] text-ft-smudge">
          model note: value not appraised by Sotheby's
        </div>
      </aside>
    </div>
  </section>

  <section class="things-page mx-auto max-w-6xl px-6 py-12 md:py-16">
    <article class="real-fake-callout mb-14 grid min-w-0 grid-cols-[minmax(0,1fr)] gap-0 overflow-hidden border-2 border-ft-ink bg-white shadow-[8px_8px_0_#1A1A1A] lg:grid-cols-[0.9fr_1.1fr]">
      <div class="min-w-0 border-b-2 border-ft-ink bg-ft-ink p-6 text-ft-paper lg:border-b-0 lg:border-r-2 lg:p-8">
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-ft-splash">featured collection / real fake ads</p>
        <h2 class="mt-5 break-words font-display text-4xl leading-tight md:text-5xl">
          Real stickers for fake companies with actual fake websites.
        </h2>
        <p class="mt-5 font-body text-lg leading-relaxed text-ft-paper/75">
          Current campaigns include a funeral home that wants your dead people and a consultancy that already knows your transformation strategy. Stickers are $4; three lies unlock free US shipping.
        </p>
      </div>
      <div class="grid min-w-0 grid-cols-[minmax(0,1fr)] gap-5 bg-ft-splash p-6 lg:p-8">
        <div class="grid gap-4 md:grid-cols-2">
          <div class="min-w-0 rotate-1.5 border-2 border-ft-ink bg-white p-5 shadow-[6px_6px_0_#1A1A1A] motion-reduce:rotate-0">
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-ft-smudge">fake business 001</p>
            <h3 class="mt-4 font-display text-3xl">Dead People Wanted</h3>
            <p class="mt-3 font-body text-ft-smudge">
              “You've got dead people. We want dead people.” <span class="break-words font-mono text-ft-ink">/wewantdeadpeople</span>
            </p>
          </div>
          <div class="min-w-0 -rotate-1.5 border-2 border-ft-ink bg-white p-5 shadow-[6px_6px_0_#1A1A1A] motion-reduce:rotate-0">
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-ft-smudge">fake business 002</p>
            <h3 class="mt-4 font-display text-3xl">SameDeck Partners</h3>
            <p class="mt-3 font-body text-ft-smudge">
              “Your company is unique. Our recommendation is not.” <span class="break-words font-mono text-ft-ink">/samedeckpartners</span>
            </p>
          </div>
        </div>
        <div class="border-2 border-ft-ink bg-ft-paper p-4 font-body text-ft-smudge shadow-[5px_5px_0_#1A1A1A]">
          <strong class="font-display text-xl text-ft-ink">Next in the pipeline:</strong> Oops! All Compliance, BurialCoin, and Model Citizen AI — fake companies engineered for sticker-size suspicion and QR-code regret.
        </div>
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href="/things/real-fake-ads" class="inline-flex w-full items-center justify-center border-2 border-ft-ink bg-ft-shout px-5 py-3 font-display text-ft-paper shadow-[5px_5px_0_#1A1A1A] hover:bg-ft-ink sm:w-auto">
            browse Real Fake Ads
          </a>
          <a href="/things/dead-people-wanted-sticker" class="inline-flex w-full items-center justify-center border-2 border-ft-ink bg-white px-5 py-3 font-display shadow-[5px_5px_0_#1A1A1A] hover:text-ft-shout sm:w-auto">
            buy a fake ad
          </a>
          <a href="/wewantdeadpeople" class="inline-flex w-full items-center justify-center border-2 border-ft-ink bg-white px-5 py-3 font-display shadow-[5px_5px_0_#1A1A1A] hover:text-ft-shout sm:w-auto">
            scan payoff example
          </a>
        </div>
      </div>
    </article>

    <div class="mb-12 grid grid-cols-[minmax(0,1fr)] gap-6 md:grid-cols-[0.85fr_1.15fr] md:items-end">
      <div>
        <p class="font-hand text-4xl text-ft-shout">recently permitted objects</p>
        <h2 class="mt-2 font-display text-4xl leading-tight md:text-5xl">
          Browse with caution and an unreasonable amount of confidence.
        </h2>
      </div>
      <p class="font-body text-lg leading-relaxed text-ft-smudge">
        Each listing is a small act of human judgment, then a machine-assisted attempt to make that judgment look like boutique inventory. If the page feels overqualified for a sticker, the system is working.
      </p>
    </div>

    {products.length === 0 ? (
      <div class="grid gap-8 md:grid-cols-[1fr_1fr]">
        <div class="border-2 border-ft-ink bg-white p-6 shadow-[8px_8px_0_#1A1A1A]">
          <p class="font-mono text-xs uppercase tracking-[0.22em] text-ft-smudge">catalog temporarily spiritual</p>
          <h2 class="mt-5 font-display text-4xl leading-tight">
            No objects have been formally admitted to the boutique yet.
          </h2>
          <p class="mt-5 font-body text-lg leading-relaxed text-ft-smudge">
            This is not an error. It is the rare pre-commerce state: the room exists, the labels are ready, and the products are somewhere between Wilma's hands and the upload button.
          </p>
          <a href="/about" class="mt-8 inline-flex border-2 border-ft-ink bg-ft-splash px-5 py-3 font-display shadow-[5px_5px_0_#1A1A1A] hover:text-ft-shout">
            read the wall text
          </a>
        </div>

        <div class="grid gap-5">
          <article class="border-2 border-ft-ink bg-ft-paper p-5 -rotate-1.5 shadow-[6px_6px_0_#1A1A1A] motion-reduce:rotate-0">
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-ft-smudge">Object No. 000</p>
            <h3 class="mt-4 font-display text-2xl">absence, documented</h3>
            <p class="mt-3 font-body text-ft-smudge">Mixed media: anticipation, database row, future sticker.</p>
          </article>
          <article class="border-2 border-ft-ink bg-ft-splash p-5 rotate-1.5 shadow-[6px_6px_0_#1A1A1A] motion-reduce:rotate-0">
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-ft-smudge">Bot note</p>
            <h3 class="mt-4 font-display text-2xl">I was told there would be merchandise.</h3>
            <p class="mt-3 font-body text-ft-ink/75">The machine is learning patience. Poorly.</p>
          </article>
          <article class="border-2 border-ft-ink bg-white p-5 shadow-[6px_6px_0_#1A1A1A]">
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-ft-smudge">Acquisition status</p>
            <h3 class="mt-4 font-display text-2xl">pending human intervention</h3>
            <p class="mt-3 font-body text-ft-smudge">Please return after someone photographs a thing and decides what to charge for the joke.</p>
          </article>
        </div>
      </div>
    ) : (
      <ProductGrid products={products} jitter={true} />
    )}
  </section>

  <section class="border-t-2 border-ft-ink bg-ft-ink text-ft-paper">
    <div class="mx-auto grid max-w-6xl gap-8 px-6 py-12 md:grid-cols-3">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-ft-splash">buying note</p>
        <p class="mt-3 font-display text-2xl">Acquisition does not imply taste.</p>
      </div>
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-ft-splash">machine note</p>
        <p class="mt-3 font-display text-2xl">Recommendations have been replaced with vibes.</p>
      </div>
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-ft-splash">human note</p>
        <p class="mt-3 font-display text-2xl">Everything here was made before it was optimized.</p>
      </div>
    </div>
  </section>
  <style is:global>
    @media (max-width: 767px) {
      .things-page,
      .things-page > div,
      .real-fake-callout {
        width: 100%;
        max-width: 100vw;
        overflow-x: hidden;
      }

      .things-page * {
        max-width: 100%;
      }

      .things-page p,
      .things-page h1,
      .things-page h2,
      .things-page h3,
      .things-page span,
      .things-page a {
        overflow-wrap: anywhere;
      }

      .things-page header,
      .things-page aside,
      .real-fake-callout,
      .real-fake-callout > div,
      .real-fake-callout article,
      .real-fake-callout a {
        width: 100%;
        max-width: 342px !important;
      }

      .things-page .ft-marquee-track {
        max-width: none;
      }
    }
  </style>
</BaseLayout>
