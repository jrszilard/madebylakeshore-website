---
import BaseLayout from '../../../layouts/BaseLayout.astro';

export const prerender = true;

const campaigns = [
  {
    name: 'Dead People Wanted',
    route: '/wewantdeadpeople',
    destination: 'fattamano.com/wewantdeadpeople',
    label: 'funeral home / crematory',
    tagline: "You've got dead people. We want dead people.",
    description:
      'A suspiciously calm funeral-home ad for logistics language, AI condolences, and businesses named by a procurement bot with no sense of mortality.',
    bg: 'bg-ft-ink',
    accent: 'text-ft-splash',
    button: 'bg-ft-splash text-ft-ink',
    qr: [0,1,2,5,7,10,11,12,14,16,18,19,20,22,24],
    stickerRoute: '/things/dead-people-wanted-sticker',
    stickerCta: 'Buy evidence this funeral home exists',
  },
  {
    name: 'SameDeck Partners',
    route: '/samedeckpartners',
    destination: 'fattamano.com/samedeckpartners',
    label: 'transformation consultancy',
    tagline: 'Your company is unique. Our recommendation is not.',
    description:
      'A fake advisory firm for the consultancy cycle that sold everyone a Single Source of Truth, then came back with a Single Source of Warmth™.',
    bg: 'bg-[#07111f]',
    accent: 'text-[#5eead4]',
    button: 'bg-[#5eead4] text-[#07111f]',
    qr: [0,1,2,4,5,7,9,10,12,13,15,16,18,20,22,23,24],
    stickerRoute: '/things/samedeck-partners-sticker',
    stickerCta: 'Buy evidence this consultancy exists',
  },
  {
    name: 'Oops! All Compliance',
    route: '/oopsallcompliance',
    destination: 'fattamano.com/oopsallcompliance',
    label: 'risk theater / policy snacks',
    tagline: 'Making sure nothing happens, correctly.',
    description:
      'A cereal-box-colored compliance firm for teams that need guardrails, governance, and one more annual training everyone clicks through too fast.',
    bg: 'bg-[#ef2b2d]',
    accent: 'text-[#ffe96b]',
    button: 'bg-[#ffe96b] text-[#151515]',
    qr: [0,1,2,4,6,7,9,10,12,13,14,17,19,20,22,23,24],
    stickerRoute: '#product-plan',
    stickerCta: 'Sticker concept pending',
  },
  {
    name: 'BurialCoin',
    route: '/burialcoin',
    destination: 'fattamano.com/burialcoin',
    label: 'post-life fintech',
    tagline: 'The future of post-life liquidity.',
    description:
      'A crypto-adjacent estate product for people who looked at probate and thought: what if this also had a Discord?',
    bg: 'bg-[#06130d]',
    accent: 'text-[#d6a73a]',
    button: 'bg-[#d6a73a] text-[#06130d]',
    qr: [0,1,2,5,6,8,10,11,12,15,16,18,20,21,22,24],
    stickerRoute: '#product-plan',
    stickerCta: 'Sticker concept pending',
  },
  {
    name: 'Model Citizen AI',
    route: '/modelcitizenai',
    destination: 'fattamano.com/modelcitizenai',
    label: 'responsible AI / irresponsible deadlines',
    tagline: 'Responsible AI for irresponsible deadlines.',
    description:
      'An enterprise AI vendor promising governance, productivity, and legally reviewable magic from a chatbot that confidently skimmed the meeting notes.',
    bg: 'bg-[#0f172a]',
    accent: 'text-[#a5b4fc]',
    button: 'bg-[#a5b4fc] text-[#0f172a]',
    qr: [0,2,3,4,5,7,8,11,12,13,15,17,18,19,21,23,24],
    stickerRoute: '#product-plan',
    stickerCta: 'Sticker concept pending',
  },
  {
    name: 'Sight Unseen Aerials',
    route: '/sightunseenaerials',
    destination: 'fattamano.com/sightunseenaerials',
    label: 'autonomous drone photography',
    tagline: 'Drone photography by feel, firmware, and a legally required visual observer.',
    description:
      'A fake aerial-photo company run by a blind founder, a nervous spotter, and a drone that trusts automation more than anyone should.',
    bg: 'bg-[#075985]',
    accent: 'text-[#7dd3fc]',
    button: 'bg-[#7dd3fc] text-[#07111f]',
    qr: [0,1,3,4,6,8,9,10,12,14,16,17,20,21,22,24],
    stickerRoute: '#product-plan',
    stickerCta: 'Sticker concept pending',
  },
];
---
<BaseLayout
  title="Real Fake Ads"
  description="Real stickers for fake companies with real fake websites. A fattamano collection of printed jokes, QR-code storytelling, and suspicious local commerce."
>
  <section class="real-fake-page relative overflow-hidden border-b-2 border-ft-ink bg-ft-splash">
    <div class="absolute inset-x-0 top-0 border-b-2 border-ft-ink bg-ft-ink py-2 font-mono text-xs uppercase tracking-[0.22em] text-ft-paper" aria-hidden="true">
      <div class="ft-marquee-track whitespace-nowrap">
        <span>real stickers for fake companies &nbsp; ✦ &nbsp;</span>
        <span>actual websites, legally imaginary businesses &nbsp; ✦ &nbsp;</span>
        <span>please verify the joke before calling &nbsp; ✦ &nbsp;</span>
        <span>QR code storytelling department now open &nbsp; ✦ &nbsp;</span>
      </div>
    </div>

    <div class="mx-auto grid max-w-6xl min-w-0 grid-cols-[minmax(0,1fr)] gap-10 px-6 pb-16 pt-24 md:grid-cols-[minmax(0,1fr)_360px] md:pb-24 md:pt-32">
      <header class="min-w-0">
        <p class="mb-5 inline-block max-w-[calc(100vw-3rem)] break-words border-2 border-ft-ink bg-white px-3 py-1 font-mono text-[0.65rem] uppercase tracking-[0.16em] shadow-[4px_4px_0_#1A1A1A] md:text-xs md:tracking-[0.22em]">
          fattamano collection / public mischief
        </p>
        <h1 class="max-w-[calc(100vw-3rem)] break-words font-display text-big md:text-huge">
          Real <span class="text-ft-shout">Fake</span> Ads
        </h1>
        <p class="mt-6 max-w-[calc(100vw-3rem)] break-words font-body text-lg leading-relaxed text-ft-ink/80 md:max-w-2xl md:text-xl">
          Real physical ads for fake companies, printed as stickers and small objects, each leading to an actual website for a business that should absolutely not exist.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href="#campaigns"
            class="inline-flex w-full items-center justify-center border-2 border-ft-ink bg-ft-shout px-5 py-3 font-display text-ft-paper shadow-[5px_5px_0_#1A1A1A] transition-transform hover:-translate-y-0.5 hover:translate-x-0.5 hover:shadow-[3px_3px_0_#1A1A1A] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ft-shout sm:w-auto"
          >
            browse fake businesses
          </a>
          <a
            href="/things/dead-people-wanted-sticker"
            class="inline-flex w-full items-center justify-center border-2 border-ft-ink bg-white px-5 py-3 font-display shadow-[5px_5px_0_#1A1A1A] transition-transform hover:-translate-y-0.5 hover:translate-x-0.5 hover:shadow-[3px_3px_0_#1A1A1A] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ft-shout sm:w-auto"
          >
            buy the joke
          </a>
          <a
            href="/things"
            class="inline-flex w-full items-center justify-center border-2 border-ft-ink bg-ft-paper px-5 py-3 font-display shadow-[5px_5px_0_#1A1A1A] transition-transform hover:-translate-y-0.5 hover:translate-x-0.5 hover:shadow-[3px_3px_0_#1A1A1A] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ft-shout sm:w-auto"
          >
            back to things
          </a>
        </div>
      </header>

      <aside class="min-w-0 max-w-[calc(100vw-3rem)] self-start border-2 border-ft-ink bg-white p-5 shadow-[8px_8px_0_#1A1A1A] motion-reduce:rotate-0 md:max-w-none md:rotate-1.5">
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-ft-smudge">collection logic</p>
        <h2 class="mt-4 max-w-[calc(100vw-5.5rem)] break-words font-display text-xl leading-tight md:max-w-none md:text-3xl">The sticker is the ad. The website is the punchline.</h2>
        <p class="mt-4 font-body leading-relaxed text-ft-smudge">
          Scan the sticker, enter the tiny fictional universe, notice the disclosure, then decide whether your water bottle needs documentary proof of a fake company.
        </p>
        <div class="mt-5 border-y-2 border-dashed border-ft-smudge py-4">
          <p class="font-display text-2xl leading-tight text-ft-shout">Three lies unlock free US shipping.</p>
          <p class="mt-2 font-mono text-xs uppercase tracking-[0.16em] text-ft-smudge">$4 stickers / $3 US flat / free over $12</p>
        </div>
        <div class="mt-5 grid grid-cols-2 gap-3 text-center">
          <div>
            <p class="font-display text-4xl text-ft-shout">{campaigns.length}</p>
            <p class="font-mono text-[0.65rem] uppercase tracking-[0.16em] text-ft-smudge">fake firms</p>
          </div>
          <div>
            <p class="font-display text-4xl text-ft-shout">∞</p>
            <p class="font-mono text-[0.65rem] uppercase tracking-[0.16em] text-ft-smudge">liability</p>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="real-fake-page border-b-2 border-ft-ink bg-ft-ink text-ft-paper">
    <div class="mx-auto grid max-w-6xl gap-6 px-6 py-10 md:grid-cols-[0.75fr_1.25fr] md:items-center md:py-14">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-ft-splash">if you scanned a sticker</p>
        <h2 class="mt-3 font-display text-3xl leading-tight md:text-5xl">Congratulations. You are now in the funnel.</h2>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        <p class="border border-ft-paper/25 bg-white/5 p-4 font-body text-ft-paper/75"><strong class="block font-display text-xl text-ft-paper">1. The company is fake.</strong> Please do not request services, remains, crypto custody, or transformation advisory.</p>
        <p class="border border-ft-paper/25 bg-white/5 p-4 font-body text-ft-paper/75"><strong class="block font-display text-xl text-ft-paper">2. The sticker is real.</strong> It is available for actual money and mild social consequences.</p>
        <p class="border border-ft-paper/25 bg-white/5 p-4 font-body text-ft-paper/75"><strong class="block font-display text-xl text-ft-paper">3. Collect the evidence.</strong> Buy three lies, unlock free US shipping, become difficult to explain.</p>
      </div>
    </div>
  </section>

  <section id="campaigns" class="real-fake-page mx-auto max-w-6xl px-6 py-16 md:py-24">
    <div class="mb-10 grid grid-cols-[minmax(0,1fr)] gap-6 md:grid-cols-[0.85fr_1.15fr] md:items-end">
      <div>
        <p class="font-hand text-4xl text-ft-shout">campaign archive</p>
        <h2 class="mt-2 max-w-[calc(100vw-3rem)] break-words font-display text-2xl leading-tight md:text-5xl">
          Tiny ads for full-service fake businesses.
        </h2>
      </div>
      <p class="max-w-[calc(100vw-3rem)] break-words font-body leading-relaxed text-ft-smudge md:max-w-none md:text-lg">
        Each campaign starts as a printed sticker/QR gag and ends as a suspiciously complete website: funeral homes, consultancies, and other institutions that should have been stopped in committee.
      </p>
    </div>

    <div class="grid min-w-0 grid-cols-[minmax(0,1fr)] gap-8 lg:grid-cols-2">
      {campaigns.map((campaign) => (
        <article class="grid min-w-0 grid-cols-[minmax(0,1fr)] gap-0 overflow-hidden border-2 border-ft-ink bg-white shadow-[8px_8px_0_#1A1A1A]">
          <div class:list={['min-w-0 p-6 text-ft-paper md:p-7', campaign.bg]}>
            <p class:list={['font-mono text-[0.65rem] uppercase tracking-[0.16em] md:text-xs md:tracking-[0.22em]', campaign.accent]}>{campaign.name}™</p>
            <h3 class="mt-6 break-words font-display text-2xl leading-none md:text-4xl">
              {campaign.tagline}
            </h3>
            <p class="mt-5 max-w-md font-body text-sm leading-relaxed text-ft-paper/75">
              {campaign.description}
            </p>
            <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div class="border border-ft-paper/40 bg-white p-3 text-ft-ink shadow-[4px_4px_0_rgba(255,255,255,0.35)]" aria-label={`QR code area for ${campaign.destination}`}>
                <div class="grid h-24 w-24 grid-cols-5 gap-1">
                  {Array.from({ length: 25 }).map((_, i) => (
                    <span class:list={[
                      'block',
                      campaign.qr.includes(i) ? 'bg-ft-ink' : 'bg-ft-paper',
                    ]}></span>
                  ))}
                </div>
              </div>
              <div>
                <p class="font-mono text-[0.65rem] uppercase tracking-[0.18em] text-ft-paper/60">scan for {campaign.label}</p>
                <p class:list={['mt-1 max-w-[15rem] break-all font-display text-sm leading-tight md:text-base', campaign.accent]}>{campaign.destination}</p>
              </div>
            </div>
          </div>
          <div class="grid min-w-0 gap-5 bg-ft-splash p-6 md:p-7">
            <div class="min-w-0 border-2 border-ft-ink bg-white p-5 shadow-[6px_6px_0_#1A1A1A] motion-reduce:rotate-0 md:rotate-1.5">
              <p class="font-mono text-xs uppercase tracking-[0.2em] text-ft-smudge">fake company route</p>
              <h4 class="mt-4 break-words font-display text-3xl">{campaign.route}</h4>
              <p class="mt-3 font-body text-ft-smudge">
                A standalone fake-company page with its own voice, art direction, and a tiny disclosure footer.
              </p>
            </div>
            <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
              <a href={campaign.route} class:list={['inline-flex w-full items-center justify-center border-2 border-ft-ink px-5 py-3 font-display shadow-[5px_5px_0_#1A1A1A] hover:bg-white hover:text-ft-shout sm:w-auto', campaign.button]}>
                visit fake business →
              </a>
              <a href={campaign.stickerRoute} class="inline-flex w-full items-center justify-center border-2 border-ft-ink bg-white px-5 py-3 font-display shadow-[5px_5px_0_#1A1A1A] hover:text-ft-shout sm:w-auto">
                {campaign.stickerCta}
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <section class="mt-14">
      <div class="mb-6 grid gap-3 md:grid-cols-[0.8fr_1.2fr] md:items-end">
        <div>
          <p class="font-hand text-4xl text-ft-shout">freshly incorporated nonsense</p>
          <h2 class="mt-2 font-display text-3xl leading-tight md:text-5xl">Three more fake companies are now accepting imaginary leads.</h2>
        </div>
        <p class="font-body text-lg leading-relaxed text-ft-smudge">
          Oops! All Compliance, BurialCoin, Model Citizen AI, and Sight Unseen Aerials now have full fake-company sites. Sticker/product concepts are next; the websites are ready for future QR codes.
        </p>
      </div>
      <div class="grid gap-5 md:grid-cols-3">
        {campaigns.slice(2).map((idea, index) => (
          <article class:list={['border-2 border-ft-ink bg-white p-5 shadow-[6px_6px_0_#1A1A1A] motion-reduce:rotate-0', index === 1 ? '-rotate-1' : 'rotate-1']}>
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-ft-smudge">new fake business / {idea.label}</p>
            <h3 class="mt-4 font-display text-3xl leading-none">{idea.name}</h3>
            <p class="mt-3 font-display text-xl text-ft-shout">“{idea.tagline}”</p>
            <p class="mt-4 font-body leading-relaxed text-ft-smudge">{idea.description}</p>
            <a href={idea.route} class="mt-5 inline-flex border-2 border-ft-ink bg-ft-splash px-4 py-2 font-display shadow-[4px_4px_0_#1A1A1A] hover:bg-ft-shout hover:text-ft-paper">visit fake business →</a>
          </article>
        ))}
      </div>
    </section>

    <article id="product-plan" class="mt-12 border-2 border-ft-ink bg-ft-paper p-6 shadow-[8px_8px_0_#1A1A1A] md:p-8">
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-ft-smudge">product plan</p>
      <div class="mt-5 grid gap-6 md:grid-cols-5">
        <p class="font-body text-ft-smudge"><strong class="text-ft-ink">Object:</strong> sticker, fake local ad style</p>
        <p class="font-body text-ft-smudge"><strong class="text-ft-ink">Mechanic:</strong> QR + short URL to the fake site</p>
        <p class="font-body text-ft-smudge"><strong class="text-ft-ink">Payoff:</strong> fake site admits the bit and points back to the real thing</p>
        <p class="font-body text-ft-smudge"><strong class="text-ft-ink">Bundle:</strong> three lies, free US shipping</p>
        <p class="font-body text-ft-smudge"><strong class="text-ft-ink">Product queue:</strong> Oops, BurialCoin, Model Citizen AI, Sight Unseen sticker concepts</p>
      </div>
    </article>
  </section>
  <style is:global>
    @media (max-width: 767px) {
      .real-fake-page,
      .real-fake-page > div {
        width: 100%;
        max-width: 100vw;
        overflow-x: hidden;
      }

      .real-fake-page * {
        max-width: 100%;
      }

      .real-fake-page p,
      .real-fake-page h2,
      .real-fake-page h3,
      .real-fake-page h4 {
        overflow-wrap: anywhere;
      }

      .real-fake-page header,
      .real-fake-page aside,
      .real-fake-page > div,
      .real-fake-page article,
      .real-fake-page article > div,
      .real-fake-page a {
        width: 100%;
        max-width: 342px !important;
      }

      .real-fake-page .ft-marquee-track {
        max-width: none;
      }
    }
  </style>
</BaseLayout>
