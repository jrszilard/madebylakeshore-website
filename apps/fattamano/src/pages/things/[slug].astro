---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BuyButton from '../../components/BuyButton.astro';
import AddToCartButton from '../../components/cart/AddToCartButton.tsx';
import ProductGrid from '../../components/ProductGrid.astro';
import { sanityClient, queries, urlFor } from '../../lib/sanity';
import { formatPrice } from '../../lib/format';
import type { FattamanoProduct, FattamanoSettings, SanityImageLike } from '../../lib/types';
import { breadcrumbSchema, productSchema } from '../../lib/seo';
import { getCampaignByRoute } from '../../lib/campaigns';

export const prerender = true;

export async function getStaticPaths() {
  const products = await sanityClient
    .fetch<FattamanoProduct[]>(queries.allFattamanoProducts)
    .catch(() => []);
  return products.map((p) => ({
    params: { slug: p.slug.current },
    props: { product: p },
  }));
}

const { product } = Astro.props as { product: FattamanoProduct };

// Re-fetch with full details (description blocks, seo)
const full = await sanityClient.fetch<FattamanoProduct>(queries.fattamanoProductBySlug, {
  slug: product.slug.current,
}).catch(() => product);

const settings = await sanityClient
  .fetch<FattamanoSettings | null>(queries.fattamanoSettings)
  .catch(() => null);
const contactEmail = settings?.contactEmail || '';
const usZone = settings?.shippingZones?.find((zone) =>
  zone.countryCodes?.some((code) => code.trim().toUpperCase() === 'US'),
);
const usShippingRateCents = usZone?.rateCents;
const freeShippingThresholdCents = usZone?.freeShippingThresholdCents;

const images: SanityImageLike[] = full?.images ?? [];
const galleryImages = images
  .map((img, index) => ({
    full: urlFor(img)?.width(1400).url() ?? null,
    thumb: urlFor(img)?.width(400).height(400).fit('crop').url() ?? null,
    alt: img.alt || `${full?.title ?? 'product'} — photo ${index + 1}`,
  }))
  .filter((entry): entry is { full: string; thumb: string; alt: string } =>
    Boolean(entry.full && entry.thumb),
  );
const heroUrl = galleryImages[0]?.full ?? null;
const priceLabel = formatPrice(full?.priceCents, full?.priceDisplayOverride);
function statusOverlay(status: FattamanoProduct['status']): string {
  if (status === 'sold_out') return 'sold out / already acquired';
  if (status === 'coming_soon') return 'materializing soon';
  if (status === 'concept') return 'concept only / not purchasable';
  return 'currently unavailable';
}

const metaTitle = full?.seo?.metaTitle || full?.title;
const metaDescription =
  full?.seo?.metaDescription || full?.tagline || `${full?.title} — handmade by fattamano.`;

const ogImagePath = `/api/og?title=${encodeURIComponent(full?.title || '')}&subtitle=${encodeURIComponent(full?.tagline || full?.category || '')}`;
// Campaign membership comes from Sanity (fattamanoProduct.campaign) and resolves
// through the registry. No more hardcoded slug lists.
const campaign = full?.campaign ? getCampaignByRoute(`/${full.campaign}`) : undefined;
const liveAvailable = full.status === 'available' && Boolean(full.buyUrl || (full.stock ?? 0) > 0);
const lowStock = liveAvailable && typeof full.stock === 'number' && full.stock <= 5;
const related = await sanityClient
  .fetch<FattamanoProduct[]>(queries.fattamanoProductsByCategory, { category: full.category })
  .then((products) => products.filter((candidate) => candidate._id !== full._id).slice(0, 3))
  .catch(() => [] as FattamanoProduct[]);
const jsonLd = [
  productSchema(full),
  breadcrumbSchema([
    { name: 'fattamano', path: '/' },
    { name: 'things', path: '/things' },
    { name: full.title, path: `/things/${full.slug.current}` },
  ]),
];
---
<BaseLayout title={metaTitle} description={metaDescription} ogImagePath={ogImagePath} jsonLd={jsonLd}>
  <article class="max-w-6xl mx-auto px-6 py-12">
    <nav aria-label="Breadcrumb" class="mb-8 font-mono text-xs tracking-wide text-ft-smudge">
      <a href="/" class="hover:text-ft-shout focus-visible:outline focus-visible:outline-2 focus-visible:outline-ft-shout">~</a>
      <span aria-hidden="true"> / </span>
      <a href="/things" class="hover:text-ft-shout focus-visible:outline focus-visible:outline-2 focus-visible:outline-ft-shout">things</a>
      <span aria-hidden="true"> / </span>
      <span>{full.category}</span>
      <span aria-hidden="true"> / </span>
      <span class="text-ft-ink" aria-current="page">{full.slug.current}</span>
    </nav>

    <div class="grid md:grid-cols-2 gap-10">
      <div>
        {heroUrl && (
          <img
            id="product-hero-image"
            src={heroUrl}
            alt={galleryImages[0]?.alt || full.title}
            class="w-full border-2 border-ft-ink"
          />
        )}
        {galleryImages.length > 1 && (
          <div class="grid grid-cols-4 gap-3 mt-3" data-product-gallery>
            {galleryImages.map((entry, index) => (
              <button
                type="button"
                data-gallery-thumb
                data-full={entry.full}
                data-alt={entry.alt}
                aria-label={`Show photo ${index + 1}: ${entry.alt}`}
                aria-pressed={index === 0 ? 'true' : 'false'}
                class:list={[
                  'border-2 p-0 transition-colors hover:border-ft-shout focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ft-shout',
                  index === 0 ? 'border-ft-shout' : 'border-ft-ink',
                ]}
              >
                <img
                  src={entry.thumb}
                  alt=""
                  class="block w-full aspect-square object-cover"
                  loading="lazy"
                />
              </button>
            ))}
          </div>
        )}
        <script>
          const hero = document.getElementById('product-hero-image') as HTMLImageElement | null;
          const thumbs = Array.from(
            document.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]'),
          );
          for (const thumb of thumbs) {
            thumb.addEventListener('click', () => {
              if (!hero || !thumb.dataset.full) return;
              hero.src = thumb.dataset.full;
              hero.alt = thumb.dataset.alt || hero.alt;
              for (const other of thumbs) {
                const active = other === thumb;
                other.setAttribute('aria-pressed', active ? 'true' : 'false');
                other.classList.toggle('border-ft-shout', active);
                other.classList.toggle('border-ft-ink', !active);
              }
            });
          }
        </script>
      </div>

      <div class="flex flex-col">
        <p class="font-body uppercase tracking-wide text-sm text-ft-smudge">{full.category}</p>
        <h1 class="font-display text-big mt-2">{full.title}</h1>
        {full.tagline && (
          <p class="font-hand text-2xl text-ft-ink mt-3">{full.tagline}</p>
        )}
        {priceLabel && (
          <p class="font-display text-3xl text-ft-shout mt-6">{priceLabel}</p>
        )}
        <div class="mt-4 flex flex-wrap gap-2 font-mono text-xs uppercase tracking-[0.14em]">
          <span class:list={[
            'border-2 border-ft-ink px-3 py-1',
            liveAvailable ? 'bg-ft-splash text-ft-ink' : 'bg-ft-ink text-ft-paper',
          ]}>
            {liveAvailable ? 'in stock / ready to acquire' : statusOverlay(full.status)}
          </span>
          {lowStock && <span class="border-2 border-ft-ink bg-white px-3 py-1 text-ft-shout">only {full.stock} left</span>}
        </div>

        <div class="mt-8">
          {full.buyUrl ? (
            <BuyButton
              status={full.status}
              buyUrl={full.buyUrl}
              title={full.title}
              contactEmail={contactEmail}
            />
          ) : (
            <AddToCartButton
              client:visible
              initialAvailable={full.status === 'available' && (full.stock ?? 0) > 0}
              item={{
                productId: full._id,
                slug: full.slug.current,
                title: full.title,
                priceCents: full.priceCents ?? 0,
                image: images[0] ?? null,
                qty: 1,
              }}
            />
          )}
        </div>

        {liveAvailable && !full.buyUrl && (
          <div class="mt-5 grid gap-3 border-2 border-ft-ink bg-white p-5 font-body text-sm text-ft-smudge shadow-[5px_5px_0_#1A1A1A] sm:grid-cols-3">
            <p><strong class="block font-display text-base text-ft-ink">secure payment</strong>Stripe Embedded Checkout; card details never touch this site.</p>
            <p><strong class="block font-display text-base text-ft-ink">packed by a human</strong>Small-batch stock, packed and shipped by Wilma.</p>
            <p>
              <strong class="block font-display text-base text-ft-ink">shipping without drama</strong>
              {typeof usShippingRateCents === 'number' ? `$${(usShippingRateCents / 100).toFixed(2)} U.S. shipping` : 'Shipping calculated at checkout'}
              {typeof freeShippingThresholdCents === 'number' ? `; free at $${(freeShippingThresholdCents / 100).toFixed(2)}.` : '.'}
            </p>
          </div>
        )}

        {campaign && (
          <div class="mt-6 border-2 border-ft-ink bg-ft-splash p-5 shadow-[6px_6px_0_#1A1A1A]">
            <p class="font-mono text-xs uppercase tracking-[0.18em] text-ft-smudge">Real Fake Ads acquisition note</p>
            <p class="mt-3 font-display text-2xl leading-tight">
              {full.category === 'sticker' ? 'Sticker available. Company unavailable.' : 'Evidence available. Company unavailable.'}
            </p>
            <p class="mt-2 font-body text-ft-smudge">
              This object advertises {campaign.name}, a business that does not exist. Put it on a laptop and become difficult to explain. Buy three $4 stickers to unlock free US shipping.
            </p>
            <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
              <a href={campaign.route} class="inline-flex font-display text-ft-shout underline decoration-2 underline-offset-4 hover:text-ft-ink">Visit {campaign.shortName} HQ (fake) →</a>
              <a href="/things/real-fake-ads" class="inline-flex font-display text-ft-shout underline decoration-2 underline-offset-4 hover:text-ft-ink">Fake-business archive →</a>
            </div>
          </div>
        )}

        {full.description && (
          <div class="prose mt-10 font-body text-ft-ink max-w-none">
            {full.description.map((block) => (
              block._type === 'block' && (
                <p>{block.children?.map((c) => c.text).join('')}</p>
              )
            ))}
          </div>
        )}
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="border-t-2 border-ft-ink bg-ft-paper">
      <div class="mx-auto max-w-6xl px-6 py-14">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-ft-smudge">continue making questionable decisions</p>
        <div class="mb-8 mt-2 flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
          <h2 class="font-display text-4xl">Related objects</h2>
          {typeof freeShippingThresholdCents === 'number' && (
            <p class="font-body text-sm text-ft-smudge">Build a {`$${(freeShippingThresholdCents / 100).toFixed(2)}`} cart for free U.S. shipping.</p>
          )}
        </div>
        <ProductGrid products={related} />
      </div>
    </section>
  )}

  <script is:inline define:vars={{ productSlug: full.slug.current }}>
    void fetch('/api/events', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ event: 'product_view', productSlug }),
      keepalive: true,
      credentials: 'same-origin',
    }).catch(() => {});
  </script>
</BaseLayout>
