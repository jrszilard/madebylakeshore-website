---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import CheckoutEmbed from '../../components/checkout/CheckoutEmbed.tsx';

const publishableKey = import.meta.env.PUBLIC_STRIPE_PUBLISHABLE_KEY || '';
---
<BaseLayout title="checkout" description="Complete your fattamano order.">
  <section class="mx-auto max-w-5xl px-6 py-12">
    <a href="/things" class="inline-block mb-8 font-body text-sm text-ft-smudge hover:text-ft-shout">← keep shopping</a>
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_280px] lg:items-start">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-ft-smudge">secure acquisition department</p>
        <h1 class="mt-2 font-display text-5xl">Checkout</h1>
        <p class="mt-3 max-w-xl font-body text-ft-smudge">Payment and shipping details are handled inside Stripe's secure checkout. fattamano receives the order, not your card number.</p>
        <div class="mt-8 border-2 border-ft-ink bg-white p-3 shadow-[6px_6px_0_#1A1A1A]">
          {publishableKey
            ? <CheckoutEmbed client:only="react" publishableKey={publishableKey} />
            : <p class="p-5 font-body text-ft-shout">Checkout is temporarily unavailable.</p>}
        </div>
      </div>
      <aside class="border-2 border-ft-ink bg-ft-splash p-5 shadow-[6px_6px_0_#1A1A1A]">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-ft-smudge">before you commit</p>
        <ul class="mt-4 space-y-4 font-body text-sm leading-relaxed text-ft-ink">
          <li><strong class="block font-display text-lg">Live stock check</strong>Prices and availability are verified again before checkout starts.</li>
          <li><strong class="block font-display text-lg">Honest shipping</strong>The correct rate appears after you enter your destination; qualifying U.S. carts ship free.</li>
          <li><strong class="block font-display text-lg">Human fulfillment</strong>Wilma packs small-batch orders by hand and uses the email in Stripe if an order needs clarification.</li>
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>
