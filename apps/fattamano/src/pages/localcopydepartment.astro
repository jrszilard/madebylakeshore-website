---
import '../styles/global.css';

export const prerender = true;

const description =
  "Local Copy Department is a fictional anti-cloud physical media office from Real Fake Ads by fattamano. If you can hold it, they can't sunset it.";
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content="Local Copy Department — Physical Media Infrastructure" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Local Copy Department — Physical Media Infrastructure</title>
    <style is:global>
      .lcd { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
      .lcd-display { font-family: 'Space Grotesk', Inter, ui-sans-serif, system-ui, sans-serif; }
      .lcd-mono { font-family: 'Space Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
      .lcd * { box-sizing: border-box; }
      .lcd-grid { background-image: linear-gradient(rgba(24, 37, 58, 0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(24, 37, 58, 0.08) 1px, transparent 1px); background-size: 22px 22px; }
      .lcd-sunburst { background: radial-gradient(circle at 50% 50%, #fff7d6 0 10%, transparent 11%), repeating-conic-gradient(from -10deg, rgba(246, 132, 31, 0.2) 0deg 8deg, transparent 8deg 16deg); }
      .lcd-cloud { border-radius: 999px; position: relative; }
      .lcd-cloud::before, .lcd-cloud::after { content: ''; position: absolute; display: block; border-radius: 999px; background: inherit; border: inherit; border-bottom-color: transparent; }
      .lcd-cloud::before { width: 46%; height: 92%; left: 16%; bottom: 34%; }
      .lcd-cloud::after { width: 52%; height: 112%; right: 13%; bottom: 22%; }
      @media (max-width: 767px) {
        .lcd, .lcd main, .lcd section, .lcd header, .lcd footer, .lcd section > div, .lcd header > div { width: 100%; max-width: 100vw; overflow-x: hidden; }
        .lcd main section > div { display: block !important; margin-left: 1rem !important; margin-right: 1rem !important; padding-left: 1rem !important; padding-right: 1rem !important; }
        .lcd h1, .lcd h2, .lcd h3, .lcd p, .lcd a, .lcd span, .lcd li { overflow-wrap: anywhere; word-break: normal; }
        .lcd-card, .lcd-ad, .lcd main section > div, .lcd main section > div > div, .lcd main article, .lcd aside, .lcd blockquote { width: 100%; max-width: 342px !important; }
        .lcd h1 { font-size: 2.35rem !important; line-height: 0.96 !important; }
        .lcd h2 { font-size: 1.9rem !important; line-height: 1.04 !important; }
        .lcd .lcd-hero-copy { font-size: 1rem !important; }
        .lcd-ad-title { font-size: 2.6rem !important; line-height: 0.9 !important; }
      }
    </style>
  </head>
  <body class="lcd min-h-screen overflow-x-hidden bg-[#f5edda] text-[#18253a]">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-[#fff8e6] focus:px-4 focus:py-2 focus:font-black focus:outline focus:outline-2 focus:outline-[#18253a]">skip to local files</a>

    <header class="border-b-4 border-[#18253a] bg-[#fff8e6]">
      <div class="mx-auto flex max-w-7xl flex-col gap-4 px-5 py-5 md:flex-row md:items-center md:justify-between">
        <a href="#main-content" class="flex items-center gap-3" aria-label="Local Copy Department home">
          <span class="grid h-12 w-12 place-items-center border-4 border-[#18253a] bg-[#f6841f] text-2xl font-black text-[#18253a] shadow-[5px_5px_0_#18253a]">⌂</span>
          <span>
            <span class="lcd-display block text-xl font-black uppercase leading-none tracking-[-0.04em]">Local Copy Department</span>
            <span class="lcd-mono block text-xs font-black uppercase tracking-[0.18em] text-[#5f6b7a]">Physical Media Infrastructure</span>
          </span>
        </a>
        <nav aria-label="Local Copy Department navigation">
          <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-black uppercase text-[#18253a]">
            <li><a class="underline decoration-[#f6841f] decoration-2 underline-offset-4 hover:text-[#c2410c]" href="#services">Services</a></li>
            <li><a class="underline decoration-[#f6841f] decoration-2 underline-offset-4 hover:text-[#c2410c]" href="#ad">The Ad</a></li>
            <li><a class="underline decoration-[#f6841f] decoration-2 underline-offset-4 hover:text-[#c2410c]" href="#catalog">Catalog</a></li>
            <li><a class="underline decoration-[#f6841f] decoration-2 underline-offset-4 hover:text-[#c2410c]" href="#disclosure">Disclosure</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <section class="lcd-grid relative overflow-hidden border-b-4 border-[#18253a] bg-[#fff8e6]">
        <div class="lcd-sunburst absolute -right-24 -top-24 h-80 w-80 rounded-full opacity-80" aria-hidden="true"></div>
        <div class="relative mx-auto grid max-w-7xl gap-10 px-5 py-16 md:grid-cols-[minmax(0,1fr)_390px] md:py-24">
          <div>
            <p class="inline-flex border-4 border-[#18253a] bg-white px-4 py-2 lcd-mono text-xs font-black uppercase tracking-[0.2em] shadow-[5px_5px_0_#18253a]">No login required / ownership desk</p>
            <h1 class="lcd-display mt-8 max-w-5xl text-6xl font-black uppercase leading-[0.9] tracking-[-0.08em] md:text-8xl">
              If you can hold it, <span class="text-[#c2410c]">they can’t sunset it.</span>
            </h1>
            <p class="lcd-hero-copy mt-7 max-w-2xl text-xl font-semibold leading-relaxed text-[#475569]">
              Local Copy Department provides non-cloud storage infrastructure for people who remember buying things and then still having them later.
            </p>
            <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
              <a href="#ad" class="inline-flex justify-center border-4 border-[#18253a] bg-[#f6841f] px-6 py-3 text-sm font-black uppercase tracking-[0.12em] text-[#18253a] shadow-[6px_6px_0_#18253a] hover:bg-[#ffd84d]">View the public notice</a>
              <a href="/things/real-fake-ads" class="inline-flex justify-center border-4 border-[#18253a] bg-white px-6 py-3 text-sm font-black uppercase tracking-[0.12em] text-[#18253a] shadow-[6px_6px_0_#18253a] hover:bg-[#fff1bd]">Real Fake Ads archive</a>
            </div>
            <div class="mt-8 max-w-2xl border-4 border-[#18253a] bg-white p-5 shadow-[6px_6px_0_#18253a]">
              <p class="lcd-mono text-xs font-black uppercase tracking-[0.18em] text-[#c2410c]">Scanned a sticker?</p>
              <p class="mt-2 font-semibold leading-relaxed text-[#475569]">Congratulations. Your cloud has been downloaded into an object you can dust.</p>
            </div>
          </div>

          <aside class="lcd-card self-start border-4 border-[#18253a] bg-[#dbeafe] p-6 shadow-[10px_10px_0_#18253a]">
            <div class="lcd-cloud mx-auto h-24 w-52 border-4 border-[#18253a] bg-white shadow-[5px_5px_0_#18253a]" aria-hidden="true"></div>
            <h2 class="lcd-display mt-10 text-4xl font-black uppercase leading-none tracking-[-0.05em]">The Cloud, Locally Hosted</h2>
            <p class="mt-4 font-semibold leading-relaxed text-[#475569]">A 3D printed cloud that holds USB drives instead of your entire life behind a password reset flow.</p>
            <div class="mt-6 grid grid-cols-2 gap-3 text-center">
              <div class="border-2 border-[#18253a] bg-white p-3"><p class="lcd-display text-3xl font-black">8+</p><p class="lcd-mono text-[0.65rem] font-black uppercase tracking-[0.14em]">USB slots</p></div>
              <div class="border-2 border-[#18253a] bg-white p-3"><p class="lcd-display text-3xl font-black">0</p><p class="lcd-mono text-[0.65rem] font-black uppercase tracking-[0.14em]">monthly fees</p></div>
            </div>
          </aside>
        </div>
      </section>

      <section id="services" class="border-b-4 border-[#18253a] bg-[#18253a] text-[#fff8e6]">
        <div class="mx-auto grid max-w-7xl gap-8 px-5 py-14 md:grid-cols-[0.8fr_1.2fr] md:items-start md:py-20">
          <div>
            <p class="lcd-mono text-xs font-black uppercase tracking-[0.24em] text-[#ffd84d]">department services</p>
            <h2 class="lcd-display mt-3 text-5xl font-black uppercase leading-[0.95] tracking-[-0.07em] md:text-6xl">Platform-resistance, filed in triplicate.</h2>
          </div>
          <div class="grid gap-4 md:grid-cols-2">
            <article class="lcd-card border-2 border-[#fff8e6] bg-[#fff8e6] p-5 text-[#18253a] shadow-[5px_5px_0_#ffd84d]"><p class="lcd-mono text-xs font-black uppercase tracking-[0.18em] text-[#c2410c]">Service 001</p><h3 class="lcd-display mt-3 text-3xl font-black uppercase leading-none">Local possession</h3><p class="mt-3 font-semibold text-[#475569]">Store files on objects you can misplace in your own home, like nature intended.</p></article>
            <article class="lcd-card border-2 border-[#fff8e6] bg-[#fff8e6] p-5 text-[#18253a] shadow-[5px_5px_0_#ffd84d]"><p class="lcd-mono text-xs font-black uppercase tracking-[0.18em] text-[#c2410c]">Service 002</p><h3 class="lcd-display mt-3 text-3xl font-black uppercase leading-none">Shelf sovereignty</h3><p class="mt-3 font-semibold text-[#475569]">DVD, Blu-ray, CD, and game storage for citizens who oppose vanishing libraries.</p></article>
            <article class="lcd-card border-2 border-[#fff8e6] bg-[#fff8e6] p-5 text-[#18253a] shadow-[5px_5px_0_#ffd84d]"><p class="lcd-mono text-xs font-black uppercase tracking-[0.18em] text-[#c2410c]">Service 003</p><h3 class="lcd-display mt-3 text-3xl font-black uppercase leading-none">No-login access</h3><p class="mt-3 font-semibold text-[#475569]">Retrieve media without an app update, password prompt, or shareholder letter.</p></article>
            <article class="lcd-card border-2 border-[#fff8e6] bg-[#fff8e6] p-5 text-[#18253a] shadow-[5px_5px_0_#ffd84d]"><p class="lcd-mono text-xs font-black uppercase tracking-[0.18em] text-[#c2410c]">Service 004</p><h3 class="lcd-display mt-3 text-3xl font-black uppercase leading-none">Tiny archives</h3><p class="mt-3 font-semibold text-[#475569]">USB, SD, and microSD holders for files too stubborn to become a dashboard.</p></article>
          </div>
        </div>
      </section>

      <section id="ad" class="bg-[#f5edda]">
        <div class="mx-auto grid max-w-7xl gap-8 px-5 py-14 md:grid-cols-[0.9fr_1.1fr] md:items-center md:py-20">
          <div>
            <p class="lcd-mono text-xs font-black uppercase tracking-[0.24em] text-[#c2410c]">public notice / first ad</p>
            <h2 class="lcd-display mt-3 text-5xl font-black uppercase leading-[0.95] tracking-[-0.07em] md:text-6xl">Cloud services hate this one weird shelf.</h2>
            <p class="mt-5 max-w-xl text-lg font-semibold leading-relaxed text-[#475569]">A fake ad for a real future product: a cloud-shaped USB holder and a family of useful physical media tools designed through the Lakeshore AI 3D-printing workflow.</p>
          </div>

          <article class="lcd-ad rotate-1 border-4 border-[#18253a] bg-[#fff8e6] p-6 shadow-[12px_12px_0_#18253a] motion-reduce:rotate-0 md:p-8" aria-label="Local Copy Department advertisement">
            <p class="lcd-mono text-xs font-black uppercase tracking-[0.24em] text-[#c2410c]">Local Copy Department Bulletin No. 0001</p>
            <h3 class="lcd-ad-title lcd-display mt-5 text-6xl font-black uppercase leading-[0.85] tracking-[-0.08em]">Own your cloud.</h3>
            <div class="my-7 border-y-4 border-[#18253a] py-5">
              <div class="lcd-cloud mx-auto h-20 w-48 border-4 border-[#18253a] bg-[#dbeafe] shadow-[5px_5px_0_#18253a]" aria-hidden="true"></div>
              <p class="mt-8 text-center lcd-display text-3xl font-black uppercase leading-none">The Cloud, Locally Hosted™</p>
            </div>
            <p class="text-2xl font-black leading-tight text-[#18253a]">A USB-drive holder for people who believe “purchased” should not mean “temporarily tolerated by a licensing server.”</p>
            <ul class="mt-6 grid gap-2 lcd-mono text-xs font-black uppercase tracking-[0.14em] text-[#475569]">
              <li>✓ No monthly plan</li>
              <li>✓ No recommendation algorithm</li>
              <li>✓ No surprise catalog removal</li>
              <li>✓ Minor layer lines, major ownership energy</li>
            </ul>
            <p class="mt-6 border-2 border-[#18253a] bg-[#ffd84d] p-3 text-center lcd-display text-xl font-black uppercase">Possession is a feature.</p>
          </article>
        </div>
      </section>

      <section id="catalog" class="border-y-4 border-[#18253a] bg-[#fff8e6]">
        <div class="mx-auto max-w-7xl px-5 py-14 md:py-20">
          <p class="lcd-mono text-xs font-black uppercase tracking-[0.24em] text-[#c2410c]">coming physical infrastructure</p>
          <h2 class="lcd-display mt-3 max-w-4xl text-5xl font-black uppercase leading-[0.95] tracking-[-0.07em] md:text-6xl">Useful tools for holding things that companies prefer you stream.</h2>
          <div class="mt-10 grid gap-5 md:grid-cols-4">
            <article class="lcd-card border-4 border-[#18253a] bg-white p-5 shadow-[6px_6px_0_#18253a]"><p class="lcd-mono text-xs font-black uppercase tracking-[0.18em] text-[#c2410c]">Prototype A</p><h3 class="lcd-display mt-3 text-2xl font-black uppercase leading-none">USB cloud holder</h3><p class="mt-3 font-semibold text-[#475569]">Desktop cloud silhouette with local storage slots.</p></article>
            <article class="lcd-card border-4 border-[#18253a] bg-white p-5 shadow-[6px_6px_0_#18253a]"><p class="lcd-mono text-xs font-black uppercase tracking-[0.18em] text-[#c2410c]">Prototype B</p><h3 class="lcd-display mt-3 text-2xl font-black uppercase leading-none">DVD/Blu-ray rack</h3><p class="mt-3 font-semibold text-[#475569]">Modular shelves for discs that cannot be quietly delisted.</p></article>
            <article class="lcd-card border-4 border-[#18253a] bg-white p-5 shadow-[6px_6px_0_#18253a]"><p class="lcd-mono text-xs font-black uppercase tracking-[0.18em] text-[#c2410c]">Prototype C</p><h3 class="lcd-display mt-3 text-2xl font-black uppercase leading-none">CD rack</h3><p class="mt-3 font-semibold text-[#475569]">Offline listening infrastructure with absolutely no shuffle algorithm.</p></article>
            <article class="lcd-card border-4 border-[#18253a] bg-white p-5 shadow-[6px_6px_0_#18253a]"><p class="lcd-mono text-xs font-black uppercase tracking-[0.18em] text-[#c2410c]">Prototype D</p><h3 class="lcd-display mt-3 text-2xl font-black uppercase leading-none">SD archive tray</h3><p class="mt-3 font-semibold text-[#475569]">Tiny files witness protection for cards, adapters, and labels.</p></article>
          </div>
        </div>
      </section>

      <section class="bg-[#f5edda]">
        <div class="mx-auto grid max-w-7xl gap-8 px-5 py-14 md:grid-cols-[1fr_1fr] md:py-20">
          <blockquote class="lcd-card border-4 border-[#18253a] bg-white p-6 shadow-[8px_8px_0_#18253a]"><p class="lcd-display text-4xl font-black uppercase leading-none">“My game still launches because I found the box.”</p><footer class="mt-4 lcd-mono text-xs font-black uppercase tracking-[0.16em] text-[#c2410c]">— Satisfied shelf user</footer></blockquote>
          <blockquote class="lcd-card border-4 border-[#18253a] bg-white p-6 shadow-[8px_8px_0_#18253a]"><p class="lcd-display text-4xl font-black uppercase leading-none">“The cloud went down, but my weird little cloud stayed on the desk.”</p><footer class="mt-4 lcd-mono text-xs font-black uppercase tracking-[0.16em] text-[#c2410c]">— Local-first archivist</footer></blockquote>
        </div>
      </section>

      <section id="disclosure" class="bg-[#18253a] text-[#fff8e6]">
        <div class="mx-auto grid max-w-7xl gap-8 px-5 py-14 md:grid-cols-[0.9fr_1.1fr] md:items-start md:py-20">
          <div>
            <p class="lcd-mono text-xs font-black uppercase tracking-[0.24em] text-[#ffd84d]">formal disclosure</p>
            <h2 class="lcd-display mt-3 text-5xl font-black uppercase leading-[0.95] tracking-[-0.07em] md:text-6xl">This department is fake. The resentment is real.</h2>
          </div>
          <div class="lcd-card border-2 border-[#fff8e6] bg-white/10 p-6">
            <p class="font-semibold leading-relaxed text-[#f5edda]">Local Copy Department is not a real government office, storage vendor, anti-cloud regulator, DRM attorney, media preservation nonprofit, Sony division, or game preservation authority. It is a Real Fake Ad by fattamano.</p>
            <p class="mt-4 font-semibold leading-relaxed text-[#f5edda]">The planned objects are real useful 3D printed tools: USB holders, media racks, archive trays, and other small physical infrastructure for people who like owning what they bought.</p>
            <a href="/things/real-fake-ads" class="mt-7 inline-flex border-4 border-[#fff8e6] bg-[#ffd84d] px-5 py-3 text-sm font-black uppercase tracking-[0.12em] text-[#18253a] shadow-[5px_5px_0_#fff8e6] hover:bg-[#f6841f]">Return to the archive</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t-4 border-[#18253a] bg-[#fff8e6] text-[#18253a]"><div class="mx-auto flex max-w-7xl flex-col gap-3 px-5 py-5 lcd-mono text-xs font-black uppercase tracking-[0.14em] md:flex-row md:items-center md:justify-between"><p>This is a Real Fake Ad by <a href="/" class="text-[#c2410c] underline underline-offset-4">fattamano</a>.</p><p>Not a real office. Keep your receipts anyway.</p></div></footer>
  </body>
</html>
