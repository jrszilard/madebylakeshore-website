---
import '../styles/global.css';

export const prerender = true;

const description =
  'Sight Unseen Aerials is a fictional autonomous drone photography company from Real Fake Ads by fattamano. Drone photography by feel, firmware, and a legally required visual observer.';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content="Sight Unseen Aerials" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Sight Unseen Aerials</title>
    <style is:global>
      .sua { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
      .sua-display { font-family: 'Space Grotesk', Inter, ui-sans-serif, system-ui, sans-serif; }
      .sua * { box-sizing: border-box; }
      .sua-scan { background-image: repeating-linear-gradient(0deg, rgba(255,255,255,0.12) 0 1px, transparent 1px 9px); }
      .sua-reticle { background: radial-gradient(circle, transparent 0 34%, rgba(255,255,255,0.9) 35% 36%, transparent 37% 100%), linear-gradient(90deg, transparent 0 48%, rgba(255,255,255,0.9) 49% 51%, transparent 52% 100%), linear-gradient(0deg, transparent 0 48%, rgba(255,255,255,0.9) 49% 51%, transparent 52% 100%); }
      @media (max-width: 767px) {
        .sua, .sua main, .sua section, .sua header, .sua section > div, .sua header > div { width: 100%; max-width: 100vw; overflow-x: hidden; }
        .sua main section > div { display: block !important; margin-left: 1rem !important; margin-right: 1rem !important; padding-left: 1rem !important; padding-right: 1rem !important; }
        .sua h1, .sua h2, .sua h3, .sua p, .sua a { max-width: 320px !important; overflow-wrap: anywhere; word-break: break-word; }
        .sua main section > div, .sua main section > div > div, .sua-card, .sua main article, .sua main blockquote { width: 100%; max-width: 342px !important; }
        .sua main { font-size: 0.94rem; }
        .sua h1 { font-size: 2.25rem !important; line-height: 0.98 !important; }
        .sua h2 { font-size: 1.85rem !important; line-height: 1.04 !important; }
      }
    </style>
  </head>
  <body class="sua min-h-screen overflow-x-hidden bg-[#eef8ff] text-[#07111f]">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-white focus:px-4 focus:py-2 focus:outline focus:outline-2 focus:outline-[#0ea5e9]">skip to main content</a>

    <header class="border-b border-[#b9d8ea] bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-7xl flex-col gap-4 px-5 py-5 md:flex-row md:items-center md:justify-between">
        <a href="#main-content" class="flex items-center gap-3" aria-label="Sight Unseen Aerials home">
          <span class="grid h-12 w-12 place-items-center rounded-full bg-[#07111f] text-xl font-black text-[#7dd3fc] shadow-[0_18px_50px_rgba(14,165,233,0.24)]">◉</span>
          <span><span class="sua-display block text-xl font-black tracking-[-0.04em]">Sight Unseen Aerials</span><span class="block text-xs font-bold uppercase tracking-[0.22em] text-[#64748b]">autonomous drone photography</span></span>
        </a>
        <nav aria-label="Sight Unseen navigation">
          <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-bold text-[#475569]">
            <li><a class="hover:text-[#0ea5e9]" href="#method">Method</a></li>
            <li><a class="hover:text-[#0ea5e9]" href="#shots">Shots</a></li>
            <li><a class="hover:text-[#0ea5e9]" href="#proof">Proof</a></li>
            <li><a class="hover:text-[#0ea5e9]" href="#contact">Book flyover</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <section class="relative overflow-hidden border-b border-[#b9d8ea] bg-[#dff4ff]">
        <div class="absolute inset-0 opacity-80" aria-hidden="true"><div class="h-full w-full bg-[radial-gradient(circle_at_18%_14%,rgba(14,165,233,0.26),transparent_30%),radial-gradient(circle_at_83%_20%,rgba(125,211,252,0.38),transparent_28%),linear-gradient(180deg,#eaf8ff_0%,#bfecff_55%,#eaf8ff_100%)]"></div></div>
        <div class="relative mx-auto grid max-w-7xl gap-10 px-5 py-16 md:grid-cols-[minmax(0,1fr)_410px] md:py-24">
          <div>
            <p class="inline-flex rounded-full border border-[#0ea5e9]/30 bg-white/80 px-4 py-2 text-xs font-black uppercase tracking-[0.22em] text-[#0369a1] shadow-sm">founder-led / spotter-assisted / firmware-confident</p>
            <h1 class="sua-display mt-7 max-w-5xl text-6xl font-black leading-[0.94] tracking-[-0.08em] md:text-8xl">
              Drone photography by feel, firmware, and a <span class="text-[#0284c7]">legally required visual observer.</span>
            </h1>
            <p class="mt-7 max-w-2xl text-lg leading-relaxed text-[#334155] md:text-xl">Sight Unseen Aerials is run by a blind founder, one extremely vocal spotter, and a drone that believes every roof is a landing pad if you are brave enough.</p>
            <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
              <a href="#contact" class="inline-flex justify-center rounded-full bg-[#07111f] px-6 py-3 text-sm font-black uppercase tracking-[0.12em] text-white shadow-[0_18px_50px_rgba(15,23,42,0.2)] hover:bg-[#0284c7]">Book a theoretical flyover</a>
              <a href="/things/real-fake-ads" class="inline-flex justify-center rounded-full border border-[#94a3b8] bg-white px-6 py-3 text-sm font-black uppercase tracking-[0.12em] text-[#07111f] hover:border-[#0ea5e9] hover:text-[#0284c7]">View fake ad archive</a>
            </div>
            <div class="mt-7 max-w-2xl rounded-3xl border border-[#b9d8ea] bg-white/80 p-5 shadow-sm">
              <p class="text-xs font-black uppercase tracking-[0.2em] text-[#0284c7]">Scanned a sticker?</p>
              <p class="mt-2 leading-relaxed text-[#475569]">Congratulations. You found an aerial photography company where the satire is aimed at overconfident automation, not blindness. The company is fake; the future sticker may achieve lift.</p>
            </div>
          </div>
          <aside class="sua-card self-start overflow-hidden rounded-[2rem] border border-[#0f172a] bg-[#07111f] text-white shadow-2xl">
            <div class="sua-scan relative h-72 bg-[linear-gradient(135deg,#0f172a_0%,#0369a1_55%,#38bdf8_100%)] p-5">
              <div class="sua-reticle absolute inset-8 opacity-80" aria-hidden="true"></div>
              <div class="relative z-10 flex justify-between text-xs font-black uppercase tracking-[0.18em] text-[#bae6fd]"><span>LIVE FEED</span><span>subject: probably house</span></div>
              <div class="relative z-10 mt-40 rounded-xl border border-white/30 bg-black/35 p-3 text-xs uppercase tracking-[0.14em] text-white/85">Obstacle confidence: emotionally unavailable</div>
            </div>
            <div class="p-5">
              <p class="text-xs font-black uppercase tracking-[0.22em] text-[#7dd3fc]">Flight manifest</p>
              <div class="mt-4 grid gap-3 text-sm font-bold">
                <div class="flex justify-between border-b border-white/15 pb-2"><span>Pilot</span><span>blind founder</span></div>
                <div class="flex justify-between border-b border-white/15 pb-2"><span>Observer</span><span>sweating</span></div>
                <div class="flex justify-between border-b border-white/15 pb-2"><span>Drone</span><span>too confident</span></div>
                <div class="flex justify-between"><span>Deliverables</span><span>stunning-ish</span></div>
              </div>
            </div>
          </aside>
        </div>
      </section>

      <section id="method" class="bg-white">
        <div class="mx-auto max-w-7xl px-5 py-14 md:py-20">
          <p class="text-xs font-black uppercase tracking-[0.24em] text-[#0284c7]">method</p>
          <h2 class="sua-display mt-3 max-w-4xl text-5xl font-black leading-[0.98] tracking-[-0.07em] md:text-6xl">We trust the machine exactly as much as the waiver allows.</h2>
          <div class="mt-10 grid gap-5 md:grid-cols-4">
            <article class="rounded-3xl border border-[#dbe3ef] bg-[#f8fafc] p-6"><p class="text-xs font-black uppercase tracking-[0.2em] text-[#64748b]">01</p><h3 class="sua-display mt-4 text-2xl font-black tracking-[-0.04em]">Listen</h3><p class="mt-3 leading-relaxed text-[#475569]">The founder hears what the client wants. The drone hears satellites and becomes insufferable.</p></article>
            <article class="rounded-3xl border border-[#dbe3ef] bg-[#f8fafc] p-6"><p class="text-xs font-black uppercase tracking-[0.2em] text-[#64748b]">02</p><h3 class="sua-display mt-4 text-2xl font-black tracking-[-0.04em]">Launch</h3><p class="mt-3 leading-relaxed text-[#475569]">A sighted visual observer confirms the sky is where we left it.</p></article>
            <article class="rounded-3xl border border-[#dbe3ef] bg-[#f8fafc] p-6"><p class="text-xs font-black uppercase tracking-[0.2em] text-[#64748b]">03</p><h3 class="sua-display mt-4 text-2xl font-black tracking-[-0.04em]">Orbit</h3><p class="mt-3 leading-relaxed text-[#475569]">Autonomous framing captures your property from angles normally reserved for zoning disputes.</p></article>
            <article class="rounded-3xl border border-[#dbe3ef] bg-[#f8fafc] p-6"><p class="text-xs font-black uppercase tracking-[0.2em] text-[#64748b]">04</p><h3 class="sua-display mt-4 text-2xl font-black tracking-[-0.04em]">Deliver</h3><p class="mt-3 leading-relaxed text-[#475569]">You receive edited aerial photos, three disclaimers, and one image of a neighbor’s trampoline.</p></article>
          </div>
        </div>
      </section>

      <section id="shots" class="border-y border-[#b9d8ea] bg-[#e0f2fe]">
        <div class="mx-auto grid max-w-7xl gap-8 px-5 py-14 md:grid-cols-[0.8fr_1.2fr] md:items-center md:py-20">
          <div><p class="text-xs font-black uppercase tracking-[0.24em] text-[#0284c7]">shot packages</p><h2 class="sua-display mt-3 text-5xl font-black leading-[0.98] tracking-[-0.07em] md:text-6xl">If it can be photographed from above, it can be misunderstood from above.</h2></div>
          <div class="grid gap-4">
            <article class="rounded-3xl border border-[#7dd3fc] bg-white p-6 shadow-sm"><p class="text-xs font-black uppercase tracking-[0.2em] text-[#0284c7]">real estate</p><h3 class="sua-display mt-3 text-3xl font-black tracking-[-0.05em]">The “Is That My Roof?” Package</h3><p class="mt-3 text-[#475569]">Crisp aerial context for listings, inspections, and discovering the patio is shaped like a mistake.</p></article>
            <article class="rounded-3xl border border-[#7dd3fc] bg-white p-6 shadow-sm"><p class="text-xs font-black uppercase tracking-[0.2em] text-[#0284c7]">events</p><h3 class="sua-display mt-3 text-3xl font-black tracking-[-0.05em]">The Wedding Flyover We Refuse</h3><p class="mt-3 text-[#475569]">We will not hover over vows. We have boundaries and propellers.</p></article>
            <article class="rounded-3xl border border-[#7dd3fc] bg-white p-6 shadow-sm"><p class="text-xs font-black uppercase tracking-[0.2em] text-[#0284c7]">commercial</p><h3 class="sua-display mt-3 text-3xl font-black tracking-[-0.05em]">B-Roll for Companies With Parking Lots</h3><p class="mt-3 text-[#475569]">Because every brand story needs four seconds of asphalt entering frame with purpose.</p></article>
          </div>
        </div>
      </section>

      <section id="proof" class="bg-white">
        <div class="mx-auto max-w-7xl px-5 py-14 md:py-20">
          <div class="max-w-3xl"><p class="text-xs font-black uppercase tracking-[0.24em] text-[#0284c7]">testimonials / visually unverified</p><h2 class="sua-display mt-3 text-5xl font-black leading-[0.98] tracking-[-0.07em] md:text-6xl">Clients describe the work using words we cannot independently confirm.</h2></div>
          <div class="mt-10 grid gap-5 md:grid-cols-3">
            <blockquote class="rounded-3xl border border-[#dbe3ef] bg-[#f8fafc] p-6"><p class="sua-display text-2xl font-black tracking-[-0.04em]">“They captured the entire property, including a shed we had been emotionally avoiding.”</p><footer class="mt-4 text-xs font-black uppercase tracking-[0.18em] text-[#64748b]">— homeowner, alarmed</footer></blockquote>
            <blockquote class="rounded-3xl border border-[#dbe3ef] bg-[#f8fafc] p-6"><p class="sua-display text-2xl font-black tracking-[-0.04em]">“The composition was excellent. The drone’s confidence was unsettling.”</p><footer class="mt-4 text-xs font-black uppercase tracking-[0.18em] text-[#64748b]">— realtor with insurance</footer></blockquote>
            <blockquote class="rounded-3xl border border-[#dbe3ef] bg-[#f8fafc] p-6"><p class="sua-display text-2xl font-black tracking-[-0.04em]">“I scanned a sticker and became the visual observer somehow.”</p><footer class="mt-4 text-xs font-black uppercase tracking-[0.18em] text-[#64748b]">— accidental ground crew</footer></blockquote>
          </div>
        </div>
      </section>

      <section id="contact" class="bg-[#07111f] text-white">
        <div class="mx-auto grid max-w-7xl gap-8 px-5 py-14 md:grid-cols-[0.9fr_1.1fr] md:py-20">
          <div><p class="text-xs font-black uppercase tracking-[0.24em] text-[#7dd3fc]">Book a theoretical flyover</p><h2 class="sua-display mt-3 text-5xl font-black leading-[0.98] tracking-[-0.07em] md:text-6xl">Tell us what you want photographed. We will tell the drone with confidence.</h2></div>
          <div class="rounded-[2rem] border border-white/15 bg-white/10 p-6 backdrop-blur">
            <h3 class="sua-display text-2xl font-black tracking-[-0.04em]">Before you hire us</h3>
            <p class="mt-4 leading-relaxed text-slate-300">Sight Unseen Aerials is not a real drone operator, photography business, FAA-approved service, accessibility consultancy, or safe plan. It is a fake company created for Real Fake Ads. Please hire licensed, insured, compliant professionals for actual aerial work.</p>
            <div class="mt-6 rounded-3xl border border-white/15 bg-white/5 p-4"><p class="text-xs font-black uppercase tracking-[0.18em] text-[#7dd3fc]">Request more information</p><p class="mt-2 leading-relaxed text-slate-300">Information requested. The information is: sticker concept pending; please land the bit responsibly.</p></div>
            <a href="/things/real-fake-ads" class="mt-7 inline-flex rounded-full bg-[#7dd3fc] px-5 py-3 text-sm font-black uppercase tracking-[0.12em] text-[#07111f] hover:bg-white">View the collection</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-[#b9d8ea] bg-white text-[#475569]"><div class="mx-auto flex max-w-7xl flex-col gap-3 px-5 py-5 text-xs font-black uppercase tracking-[0.14em] md:flex-row md:items-center md:justify-between"><p>This is a Real Fake Ad by <a href="/" class="text-[#0284c7] underline underline-offset-4">fattamano</a>.</p><p>Not a real drone company. Satire target: automation hubris.</p></div></footer>
  </body>
</html>
