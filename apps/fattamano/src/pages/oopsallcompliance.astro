---
import FakeSiteLayout from '../layouts/FakeSiteLayout.astro';

export const prerender = true;

const description =
  'Oops! All Compliance is a fictional risk-theater company from Real Fake Ads by fattamano. Making sure nothing happens, correctly.';
---
<FakeSiteLayout
  title="Oops! All Compliance"
  description={description}
  campaignRoute="/oopsallcompliance"
  bodyClass="oac ft-contain ft-contain-stack ft-contain-gutters ft-contain-cap ft-contain-capblocks ft-contain-textcap min-h-screen overflow-x-hidden bg-[#fff7d1] text-[#151515]"
  skipLinkClass="focus:bg-white focus:outline-[#ef2b2d]"
  footerClass="border-t-4 border-[#151515] bg-white text-[#151515]"
  footerInnerClass="max-w-7xl font-black"
  footerLinkClass="text-[#ef2b2d]"
  disclaimer="Not a real compliance program. Please do not ingest."
>
  <Fragment slot="head">
    <style is:global>
      .oac { font-family: Arial, Helvetica, sans-serif; }
      .oac-display { font-family: Impact, Haettenschweiler, 'Arial Black', sans-serif; }
      .oac * { box-sizing: border-box; }
      .oac-burst { clip-path: polygon(50% 0%, 61% 28%, 91% 9%, 72% 39%, 100% 50%, 72% 61%, 91% 91%, 61% 72%, 50% 100%, 39% 72%, 9% 91%, 28% 61%, 0% 50%, 28% 39%, 9% 9%, 39% 28%); }
      @media (max-width: 767px) {
        .oac-card { width: 100%; max-width: 342px !important; }
        .oac main { font-size: 0.92rem; }
        .oac h1 { font-size: 1.9rem !important; line-height: 0.98 !important; }
        .oac h2 { font-size: 1.55rem !important; line-height: 1.08 !important; }
      }
    </style>
  </Fragment>

    <header class="border-b-4 border-[#151515] bg-[#ef2b2d] text-white">
      <div class="mx-auto flex max-w-7xl flex-col gap-4 px-5 py-4 md:flex-row md:items-center md:justify-between">
        <a href="#main-content" class="block" aria-label="Oops All Compliance home">
          <p class="oac-display text-3xl uppercase tracking-tight">Oops! All Compliance</p>
          <p class="text-xs font-black uppercase tracking-[0.2em] text-[#ffe96b]">risk theater in every bite</p>
        </a>
        <nav aria-label="Oops All Compliance navigation">
          <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-black uppercase tracking-[0.08em]">
            <li><a class="hover:text-[#ffe96b]" href="#ingredients">Ingredients</a></li>
            <li><a class="hover:text-[#ffe96b]" href="#training">Training</a></li>
            <li><a class="hover:text-[#ffe96b]" href="#incidents">Incidents</a></li>
            <li><a class="hover:text-[#ffe96b]" href="#contact">Audit us</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <section class="relative overflow-hidden border-b-4 border-[#151515] bg-[#ffe96b]">
        <div class="absolute -right-20 top-10 h-72 w-72 rounded-full bg-[#29a9ff] opacity-70" aria-hidden="true"></div>
        <div class="absolute -bottom-16 left-10 h-48 w-48 rounded-full bg-[#ef2b2d] opacity-70" aria-hidden="true"></div>
        <div class="relative mx-auto grid max-w-7xl gap-10 px-5 py-14 md:grid-cols-[minmax(0,1fr)_380px] md:py-20">
          <div>
            <p class="inline-block rotate-[-2deg] border-4 border-[#151515] bg-white px-4 py-2 text-xs font-black uppercase tracking-[0.2em] shadow-[6px_6px_0_#151515]">New! fortified with policy dust</p>
            <h1 class="oac-display mt-7 max-w-4xl text-[5rem] uppercase leading-[0.86] tracking-[-0.08em] text-[#ef2b2d] md:text-[7rem]">
              Oops!<br /><span class="text-[#151515]">All Compliance</span>
            </h1>
            <p class="mt-7 max-w-2xl text-2xl font-black leading-tight md:text-3xl">Making sure nothing happens, correctly.</p>
            <p class="mt-4 max-w-2xl text-lg font-bold leading-relaxed text-[#4b3b00]">A colorful risk-management breakfast for teams that need guardrails, governance, and one more annual training everyone clicks through too fast.</p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
              <a href="#contact" class="inline-flex justify-center border-4 border-[#151515] bg-[#ef2b2d] px-6 py-3 font-black uppercase tracking-[0.08em] text-white shadow-[5px_5px_0_#151515] hover:bg-[#151515]">Start preventing progress</a>
              <a href="/things/real-fake-ads" class="inline-flex justify-center border-4 border-[#151515] bg-white px-6 py-3 font-black uppercase tracking-[0.08em] text-[#151515] shadow-[5px_5px_0_#151515] hover:text-[#ef2b2d]">This is a fake ad</a>
            </div>
          </div>
          <aside class="oac-card relative self-start border-4 border-[#151515] bg-white p-6 shadow-[10px_10px_0_#151515]">
            <div class="oac-burst absolute -right-7 -top-7 grid h-28 w-28 place-items-center bg-[#29a9ff] p-4 text-center text-xs font-black uppercase leading-tight text-white">Now with 12 controls!</div>
            <p class="text-xs font-black uppercase tracking-[0.22em] text-[#ef2b2d]">Nutrition facts</p>
            <h2 class="oac-display mt-4 text-5xl uppercase leading-none">100% daily value of plausible deniability</h2>
            <ul class="mt-5 divide-y-2 divide-[#151515] border-y-2 border-[#151515] text-sm font-black uppercase">
              <li class="flex justify-between py-2"><span>Accountability</span><span>0g</span></li>
              <li class="flex justify-between py-2"><span>Mandatory module</span><span>47 min</span></li>
              <li class="flex justify-between py-2"><span>Actual behavior change</span><span>trace</span></li>
              <li class="flex justify-between py-2"><span>Audit readiness</span><span>crunchy</span></li>
            </ul>
          </aside>
        </div>
      </section>

      <section id="ingredients" class="bg-white">
        <div class="mx-auto max-w-7xl px-5 py-14 md:py-20">
          <p class="text-xs font-black uppercase tracking-[0.24em] text-[#ef2b2d]">proprietary recipe</p>
          <h2 class="oac-display mt-3 max-w-4xl text-5xl uppercase leading-none md:text-7xl">Part policy binder. Part cereal mascot. Part emergency meeting.</h2>
          <div class="mt-10 grid gap-5 md:grid-cols-4">
            {['Guardrail Clusters', 'Attestation Loops', 'Incident Confetti', 'Governance Sprinkles'].map((item) => (
              <article class="border-4 border-[#151515] bg-[#fff7d1] p-5 shadow-[6px_6px_0_#151515]">
                <h3 class="oac-display text-3xl uppercase leading-none text-[#ef2b2d]">{item}</h3>
                <p class="mt-3 font-bold leading-relaxed text-[#4b3b00]">Crispy controls designed to make risk feel addressed without making anyone change the roadmap.</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="training" class="border-y-4 border-[#151515] bg-[#29a9ff] text-white">
        <div class="mx-auto grid max-w-7xl gap-8 px-5 py-14 md:grid-cols-[0.8fr_1.2fr] md:items-center md:py-20">
          <div>
            <p class="text-xs font-black uppercase tracking-[0.24em] text-[#ffe96b]">annual training</p>
            <h2 class="oac-display mt-3 text-5xl uppercase leading-none md:text-7xl">Click next until morality occurs.</h2>
          </div>
          <div class="grid gap-4">
            <article class="border-4 border-white bg-[#151515] p-5 shadow-[6px_6px_0_rgba(0,0,0,0.35)]"><h3 class="oac-display text-4xl uppercase text-[#ffe96b]">Module 1: Do Not</h3><p class="mt-2 font-bold text-white/80">A broad overview of things an employee should not do, unless revenue already depends on them.</p></article>
            <article class="border-4 border-white bg-[#151515] p-5 shadow-[6px_6px_0_rgba(0,0,0,0.35)]"><h3 class="oac-display text-4xl uppercase text-[#ffe96b]">Module 2: Say You Did</h3><p class="mt-2 font-bold text-white/80">Completion certificates suitable for auditors, intranets, and managers who like green checkmarks.</p></article>
          </div>
        </div>
      </section>

      <section id="incidents" class="bg-[#fff7d1]">
        <div class="mx-auto max-w-7xl px-5 py-14 md:py-20">
          <p class="text-xs font-black uppercase tracking-[0.24em] text-[#ef2b2d]">testimonials / not admissible</p>
          <div class="mt-6 grid gap-5 md:grid-cols-3">
            <blockquote class="border-4 border-[#151515] bg-white p-5 shadow-[6px_6px_0_#151515]"><p class="oac-display text-3xl uppercase leading-none">“The incident still happened, but in a much more documented way.”</p><footer class="mt-4 text-xs font-black uppercase tracking-[0.16em] text-[#4b3b00]">— Director, acceptable exposure</footer></blockquote>
            <blockquote class="border-4 border-[#151515] bg-white p-5 shadow-[6px_6px_0_#151515]"><p class="oac-display text-3xl uppercase leading-none">“Our people love the mascot and fear the spreadsheet.”</p><footer class="mt-4 text-xs font-black uppercase tracking-[0.16em] text-[#4b3b00]">— Compliance-adjacent VP</footer></blockquote>
            <blockquote class="border-4 border-[#151515] bg-white p-5 shadow-[6px_6px_0_#151515]"><p class="oac-display text-3xl uppercase leading-none">“I scanned a sticker and completed training by accident.”</p><footer class="mt-4 text-xs font-black uppercase tracking-[0.16em] text-[#4b3b00]">— ideal buyer persona</footer></blockquote>
          </div>
        </div>
      </section>

      <section id="contact" class="bg-[#151515] text-white">
        <div class="mx-auto grid max-w-7xl gap-8 px-5 py-14 md:grid-cols-[0.9fr_1.1fr] md:py-20">
          <div>
            <p class="text-xs font-black uppercase tracking-[0.24em] text-[#ffe96b]">Request a readiness snack</p>
            <h2 class="oac-display mt-3 text-5xl uppercase leading-none md:text-7xl">Ready to make risk taste like paperwork?</h2>
          </div>
          <div class="border-4 border-white bg-[#ef2b2d] p-6 shadow-[8px_8px_0_#ffe96b]">
            <h3 class="oac-display text-4xl uppercase leading-none">Before you audit us</h3>
            <p class="mt-4 font-bold leading-relaxed text-white/85">Oops! All Compliance is not a real compliance provider, cereal, law firm, SaaS platform, or substitute for a competent adult. It is a fake company created for Real Fake Ads.</p>
            <div class="mt-6 border-2 border-white bg-white/10 p-4"><p class="text-xs font-black uppercase tracking-[0.18em] text-[#ffe96b]">Request more information</p><p class="mt-2 font-bold">Information requested. The information is: sticker concept pending; company unavailable.</p></div>
            <a href="/things/real-fake-ads" class="mt-7 inline-flex border-4 border-white bg-[#ffe96b] px-5 py-3 font-black uppercase tracking-[0.08em] text-[#151515] shadow-[5px_5px_0_#151515] hover:bg-white">View the collection</a>
          </div>
        </div>
      </section>
    </main>

</FakeSiteLayout>
