---
import '../styles/global.css';

export const prerender = true;

const description =
  'Model Citizen AI is a fictional responsible-AI vendor from Real Fake Ads by fattamano. Responsible AI for irresponsible deadlines.';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content="Model Citizen AI" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Model Citizen AI</title>
    <style is:global>
      .mca { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
      .mca-display { font-family: 'Space Grotesk', Inter, ui-sans-serif, system-ui, sans-serif; }
      .mca * { box-sizing: border-box; }
      .mca-grid-bg { background-image: linear-gradient(rgba(15,23,42,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(15,23,42,0.06) 1px, transparent 1px); background-size: 28px 28px; }
      @media (max-width: 767px) {
        .mca, .mca main, .mca section, .mca header, .mca section > div, .mca header > div { width: 100%; max-width: 100vw; overflow-x: hidden; }
        .mca main section > div { display: block !important; margin-left: 1rem !important; margin-right: 1rem !important; padding-left: 1rem !important; padding-right: 1rem !important; }
        .mca h1, .mca h2, .mca h3, .mca p, .mca a { max-width: 320px !important; overflow-wrap: anywhere; word-break: break-word; }
        .mca main section > div, .mca main section > div > div, .mca-card, .mca main article, .mca main blockquote { width: 100%; max-width: 342px !important; }
        .mca main { font-size: 0.92rem; }
        .mca h1 { font-size: 1.95rem !important; line-height: 1.02 !important; }
        .mca h1 span { display: block; }
        .mca h2 { font-size: 1.55rem !important; line-height: 1.08 !important; }
      }
    </style>
  </head>
  <body class="mca min-h-screen overflow-x-hidden bg-[#f8fafc] text-[#0f172a]">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-white focus:px-4 focus:py-2 focus:outline focus:outline-2 focus:outline-[#6366f1]">skip to main content</a>

    <header class="border-b border-[#dbe3ef] bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-7xl flex-col gap-4 px-5 py-5 md:flex-row md:items-center md:justify-between">
        <a href="#main-content" class="flex items-center gap-3" aria-label="Model Citizen AI home">
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-[#0f172a] text-lg font-black text-white shadow-[0_18px_50px_rgba(99,102,241,0.22)]">✓</span>
          <span><span class="mca-display block text-xl font-black tracking-[-0.04em]">Model Citizen AI</span><span class="block text-xs font-bold uppercase tracking-[0.22em] text-[#64748b]">governance-shaped acceleration</span></span>
        </a>
        <nav aria-label="Model Citizen AI navigation">
          <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-bold text-[#475569]">
            <li><a class="hover:text-[#6366f1]" href="#platform">Platform</a></li>
            <li><a class="hover:text-[#6366f1]" href="#governance">Governance</a></li>
            <li><a class="hover:text-[#6366f1]" href="#proof">Proof</a></li>
            <li><a class="hover:text-[#6366f1]" href="#contact">Request demo</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <section class="mca-grid-bg relative overflow-hidden border-b border-[#dbe3ef] bg-[#f8fafc]">
        <div class="absolute right-0 top-0 h-80 w-80 rounded-full bg-[#c7d2fe] blur-3xl" aria-hidden="true"></div>
        <div class="absolute bottom-0 left-0 h-72 w-72 rounded-full bg-[#bae6fd] blur-3xl" aria-hidden="true"></div>
        <div class="relative mx-auto grid max-w-7xl gap-10 px-5 py-16 md:grid-cols-[minmax(0,1fr)_410px] md:py-24">
          <div>
            <p class="inline-flex rounded-full border border-[#c7d2fe] bg-white px-4 py-2 text-xs font-black uppercase tracking-[0.22em] text-[#6366f1] shadow-sm">SOC 2-shaped confidence, demo-ready</p>
            <h1 class="mca-display mt-7 max-w-5xl text-6xl font-black leading-[0.92] tracking-[-0.08em] md:text-8xl">
              Responsible AI for <span class="text-[#6366f1]">irresponsible deadlines.</span>
            </h1>
            <p class="mt-7 max-w-2xl text-lg leading-relaxed text-[#475569] md:text-xl">Deploy legally reviewable magic from a chatbot that confidently skimmed the meeting notes. Governance included, evidence to follow.</p>
            <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
              <a href="#contact" class="inline-flex justify-center rounded-full bg-[#0f172a] px-6 py-3 text-sm font-black uppercase tracking-[0.12em] text-white shadow-[0_18px_50px_rgba(15,23,42,0.2)] hover:bg-[#6366f1]">Generate alignment</a>
              <a href="/things/real-fake-ads" class="inline-flex justify-center rounded-full border border-[#cbd5e1] bg-white px-6 py-3 text-sm font-black uppercase tracking-[0.12em] text-[#0f172a] hover:border-[#6366f1] hover:text-[#6366f1]">View fake ad archive</a>
            </div>
            <div class="mt-7 max-w-2xl rounded-3xl border border-[#cbd5e1] bg-white p-5 shadow-sm">
              <p class="text-xs font-black uppercase tracking-[0.2em] text-[#6366f1]">Scanned a sticker?</p>
              <p class="mt-2 leading-relaxed text-[#475569]">Congratulations. You have discovered an enterprise AI vendor that says “governance” before anyone can ask if the answer is true.</p>
            </div>
          </div>
          <aside class="mca-card self-start rounded-[2rem] border border-[#cbd5e1] bg-white p-6 shadow-2xl">
            <div class="flex items-center justify-between gap-4"><p class="text-xs font-black uppercase tracking-[0.22em] text-[#6366f1]">Trust console</p><span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold uppercase text-emerald-700">passing*</span></div>
            <h2 class="mca-display mt-5 text-3xl font-black tracking-[-0.05em]">Executive-safe answer generator</h2>
            <div class="mt-6 grid gap-4">
              <div><div class="mb-2 flex justify-between text-xs font-black uppercase tracking-[0.16em] text-[#64748b]"><span>Confidence</span><span>94%</span></div><div class="h-2 rounded-full bg-[#e0e7ff]"><div class="h-2 w-[94%] rounded-full bg-[#6366f1]"></div></div></div>
              <div><div class="mb-2 flex justify-between text-xs font-black uppercase tracking-[0.16em] text-[#64748b]"><span>Evidence</span><span>pending</span></div><div class="h-2 rounded-full bg-[#fee2e2]"><div class="h-2 w-[31%] rounded-full bg-[#ef4444]"></div></div></div>
              <div><div class="mb-2 flex justify-between text-xs font-black uppercase tracking-[0.16em] text-[#64748b]"><span>Policy fit</span><span>phrased</span></div><div class="h-2 rounded-full bg-[#dcfce7]"><div class="h-2 w-[88%] rounded-full bg-[#22c55e]"></div></div></div>
            </div>
            <p class="mt-5 text-xs leading-relaxed text-[#64748b]">*Passing means no one has asked a follow-up in writing.</p>
          </aside>
        </div>
      </section>

      <section id="platform" class="bg-white">
        <div class="mx-auto max-w-7xl px-5 py-14 md:py-20">
          <p class="text-xs font-black uppercase tracking-[0.24em] text-[#6366f1]">platform</p>
          <h2 class="mca-display mt-3 max-w-4xl text-5xl font-black leading-[0.98] tracking-[-0.07em] md:text-6xl">All the AI features your board heard about, wrapped in a dashboard that says “controls.”</h2>
          <div class="mt-10 grid gap-5 md:grid-cols-3">
            <article class="rounded-3xl border border-[#dbe3ef] bg-[#f8fafc] p-6"><p class="text-xs font-black uppercase tracking-[0.2em] text-[#64748b]">01</p><h3 class="mca-display mt-4 text-2xl font-black tracking-[-0.04em]">Answer Laundering</h3><p class="mt-3 leading-relaxed text-[#475569]">Turns a guess into a recommendation, then into an initiative, then into a steering committee.</p></article>
            <article class="rounded-3xl border border-[#dbe3ef] bg-[#f8fafc] p-6"><p class="text-xs font-black uppercase tracking-[0.2em] text-[#64748b]">02</p><h3 class="mca-display mt-4 text-2xl font-black tracking-[-0.04em]">Policy Theater Mode</h3><p class="mt-3 leading-relaxed text-[#475569]">Every risky output receives a tasteful banner and a link to a document nobody owns.</p></article>
            <article class="rounded-3xl border border-[#dbe3ef] bg-[#f8fafc] p-6"><p class="text-xs font-black uppercase tracking-[0.2em] text-[#64748b]">03</p><h3 class="mca-display mt-4 text-2xl font-black tracking-[-0.04em]">Human-in-the-Loop-ish</h3><p class="mt-3 leading-relaxed text-[#475569]">A person is notified eventually, usually after the stakeholder deck has shipped.</p></article>
          </div>
        </div>
      </section>

      <section id="governance" class="border-y border-[#dbe3ef] bg-[#eef2ff]">
        <div class="mx-auto grid max-w-7xl gap-8 px-5 py-14 md:grid-cols-[0.8fr_1.2fr] md:items-center md:py-20">
          <div><p class="text-xs font-black uppercase tracking-[0.24em] text-[#6366f1]">governance</p><h2 class="mca-display mt-3 text-5xl font-black leading-[0.98] tracking-[-0.07em] md:text-6xl">Move fast and document the concern.</h2></div>
          <div class="grid gap-4">
            <article class="rounded-3xl border border-[#c7d2fe] bg-white p-6 shadow-sm"><p class="text-xs font-black uppercase tracking-[0.2em] text-[#6366f1]">Control MCA-01</p><h3 class="mca-display mt-3 text-3xl font-black tracking-[-0.05em]">All outputs are labeled “draft” until they become strategy.</h3></article>
            <article class="rounded-3xl border border-[#c7d2fe] bg-white p-6 shadow-sm"><p class="text-xs font-black uppercase tracking-[0.2em] text-[#6366f1]">Control MCA-02</p><h3 class="mca-display mt-3 text-3xl font-black tracking-[-0.05em]">Bias is monitored through a quarterly vibes review.</h3></article>
            <article class="rounded-3xl border border-[#c7d2fe] bg-white p-6 shadow-sm"><p class="text-xs font-black uppercase tracking-[0.2em] text-[#6366f1]">Control MCA-03</p><h3 class="mca-display mt-3 text-3xl font-black tracking-[-0.05em]">The model card is beautiful and almost certainly outdated.</h3></article>
          </div>
        </div>
      </section>

      <section id="proof" class="bg-white">
        <div class="mx-auto max-w-7xl px-5 py-14 md:py-20">
          <div class="max-w-3xl"><p class="text-xs font-black uppercase tracking-[0.24em] text-[#6366f1]">customer proof</p><h2 class="mca-display mt-3 text-5xl font-black leading-[0.98] tracking-[-0.07em] md:text-6xl">Trusted by teams whose pilots became platforms by calendar invite.</h2></div>
          <div class="mt-10 grid gap-5 md:grid-cols-3">
            <blockquote class="rounded-3xl border border-[#dbe3ef] bg-[#f8fafc] p-6"><p class="mca-display text-2xl font-black tracking-[-0.04em]">“It made our AI roadmap feel compliant enough to show procurement.”</p><footer class="mt-4 text-xs font-black uppercase tracking-[0.18em] text-[#64748b]">— VP, acceleration risk</footer></blockquote>
            <blockquote class="rounded-3xl border border-[#dbe3ef] bg-[#f8fafc] p-6"><p class="mca-display text-2xl font-black tracking-[-0.04em]">“The answer was wrong, but the governance wrapper was immaculate.”</p><footer class="mt-4 text-xs font-black uppercase tracking-[0.18em] text-[#64748b]">— Director, explainability</footer></blockquote>
            <blockquote class="rounded-3xl border border-[#dbe3ef] bg-[#f8fafc] p-6"><p class="mca-display text-2xl font-black tracking-[-0.04em]">“I scanned a sticker and now I have an AI ethics committee.”</p><footer class="mt-4 text-xs font-black uppercase tracking-[0.18em] text-[#64748b]">— accidental lead</footer></blockquote>
          </div>
        </div>
      </section>

      <section id="contact" class="bg-[#0f172a] text-white">
        <div class="mx-auto grid max-w-7xl gap-8 px-5 py-14 md:grid-cols-[0.9fr_1.1fr] md:py-20">
          <div><p class="text-xs font-black uppercase tracking-[0.24em] text-[#a5b4fc]">Request responsible acceleration</p><h2 class="mca-display mt-3 text-5xl font-black leading-[0.98] tracking-[-0.07em] md:text-6xl">Tell us your deadline. We will find the governance later.</h2></div>
          <div class="rounded-[2rem] border border-white/15 bg-white/10 p-6 backdrop-blur">
            <h3 class="mca-display text-2xl font-black tracking-[-0.04em]">Before you deploy us</h3>
            <p class="mt-4 leading-relaxed text-slate-300">Model Citizen AI is not a real AI vendor, governance product, model, auditor, accelerator, legal shield, or enterprise transformation partner. It is a fake company created for Real Fake Ads.</p>
            <div class="mt-6 rounded-3xl border border-white/15 bg-white/5 p-4"><p class="text-xs font-black uppercase tracking-[0.18em] text-[#a5b4fc]">Request more information</p><p class="mt-2 leading-relaxed text-slate-300">Information requested. The information is: sticker concept pending; do not put this in production.</p></div>
            <a href="/things/real-fake-ads" class="mt-7 inline-flex rounded-full bg-white px-5 py-3 text-sm font-black uppercase tracking-[0.12em] text-[#0f172a] hover:bg-[#a5b4fc]">View the collection</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-[#dbe3ef] bg-white text-[#475569]"><div class="mx-auto flex max-w-7xl flex-col gap-3 px-5 py-5 text-xs font-black uppercase tracking-[0.14em] md:flex-row md:items-center md:justify-between"><p>This is a Real Fake Ad by <a href="/" class="text-[#6366f1] underline underline-offset-4">fattamano</a>.</p><p>Not a real AI company. The concern is documented.</p></div></footer>
  </body>
</html>
