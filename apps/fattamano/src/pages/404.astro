---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sanityClient, queries } from '../lib/sanity';
import type { RichTextBlock } from '../lib/types';
import { fakeBusinessOfTheDay } from '../lib/campaigns';

const settings = await sanityClient
  .fetch<{ notFoundCopy?: RichTextBlock[] }>(queries.fattamanoSettings)
  .catch(() => null);

const blocks = settings?.notFoundCopy ?? [];
const lostBusiness = fakeBusinessOfTheDay();
---
<BaseLayout title="lost" description="page not found">
  <section class="max-w-3xl mx-auto px-6 py-24 text-center md:py-32">
    <h1 class="font-display text-huge">
      <span class="text-ft-shout">404</span>
    </h1>
    <p class="font-hand text-3xl mt-4">you came here on purpose?</p>

    <div class="mt-10 font-body text-ft-smudge space-y-3">
      {blocks.length > 0
        ? blocks.map((block) =>
            block._type === 'block' ? (
              <p>{block.children?.map((c) => c.text).join('')}</p>
            ) : null
          )
        : (
          <>
            <p>This page doesn't exist. Probably never did.</p>
            <p>The machine checked twice and is now pretending it wasn't worried.</p>
          </>
        )
      }
    </div>

    <nav aria-label="Where to go instead" class="mt-10 flex flex-wrap justify-center gap-3">
      <a href="/things" class="border-2 border-ft-ink bg-white px-4 py-2 font-display shadow-[3px_3px_0_#1A1A1A] hover:bg-ft-splash hover:text-ft-shout focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ft-shout">the things</a>
      <a href="/things/real-fake-ads" class="border-2 border-ft-ink bg-white px-4 py-2 font-display shadow-[3px_3px_0_#1A1A1A] hover:bg-ft-splash hover:text-ft-shout focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ft-shout">real fake ads</a>
      <a href="/notes" class="border-2 border-ft-ink bg-white px-4 py-2 font-display shadow-[3px_3px_0_#1A1A1A] hover:bg-ft-splash hover:text-ft-shout focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ft-shout">notes</a>
      <a href="/" class="border-2 border-ft-ink bg-white px-4 py-2 font-display shadow-[3px_3px_0_#1A1A1A] hover:bg-ft-splash hover:text-ft-shout focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ft-shout">home</a>
    </nav>

    <div class="mt-10 border-2 border-dashed border-ft-ink bg-ft-splash p-5 shadow-[6px_6px_0_#1A1A1A]">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-ft-smudge">wrong turn, plausible explanation</p>
      <p class="mt-3 font-display text-2xl leading-tight">Were you looking for a fake company?</p>
      <p class="mt-2 font-body text-ft-smudge">
        It happens more than you'd think. Today's most likely suspect:
      </p>
      <a href={lostBusiness.route} class="mt-4 inline-flex border-2 border-ft-ink bg-white px-5 py-3 font-display shadow-[5px_5px_0_#1A1A1A] hover:text-ft-shout focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ft-shout">
        {lostBusiness.name} →
      </a>
      <p class="mt-3 font-mono text-[0.65rem] uppercase tracking-[0.16em] text-ft-smudge">
        fictional business {lostBusiness.number} of {8} / still somehow employable
      </p>
    </div>
  </section>
</BaseLayout>
