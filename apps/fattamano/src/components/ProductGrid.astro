---
import ProductCard from './ProductCard.astro';
import { sanityClient, queries } from '../lib/sanity';
import type { FattamanoProduct, FattamanoSettings } from '../lib/types';

interface Props {
  products: FattamanoProduct[];
  jitter?: boolean;
}

const { products, jitter = false } = Astro.props;
const settings = await sanityClient.fetch<FattamanoSettings | null>(queries.fattamanoSettings).catch(() => null);
const usZone = settings?.shippingZones?.find((zone) =>
  zone.countryCodes?.some((code) => code.trim().toUpperCase() === 'US'),
);
const freeShippingThresholdCents = usZone?.freeShippingThresholdCents ?? null;

// Permanent catalog numbers: the full catalog is ordered dateAdded desc, so the
// oldest object is always No. 001 and new arrivals get new high numbers. Numbers
// are stable across the homepage/featured/related grids (they rank against the
// full catalog, not the subset being rendered). Fallback: position in this grid.
const allProducts = await sanityClient
  .fetch<FattamanoProduct[]>(queries.allFattamanoProducts)
  .catch(() => [] as FattamanoProduct[]);
const catalogNumbers = new Map(allProducts.map((p, i) => [p._id, allProducts.length - i]));

function rotateFor(i: number): 'none' | 'left' | 'right' {
  if (!jitter) return 'none';
  const m = i % 4;
  return m === 0 ? 'left' : m === 2 ? 'right' : 'none';
}
---
<div class="grid grid-cols-1 gap-x-7 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
  {products.map((p, i) => (
    <ProductCard
      product={p}
      rotate={rotateFor(i)}
      catalogNumber={catalogNumbers.get(p._id) ?? i + 1}
      freeShippingThresholdCents={freeShippingThresholdCents}
    />
  ))}
</div>
