// The redirect Worker for www.fattamano.com (index.js).
//   Deploy:  scripts/deploy-cloudflare.sh www. The custom domain owns www's DNS record and certificate; www's old
//            Vercel record had to be deleted before the first deploy.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fattamano-www-redirect",
  "main": "./index.js",
  "compatibility_date": "2026-01-14",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "www.fattamano.com", "custom_domain": true }
  ]
}
